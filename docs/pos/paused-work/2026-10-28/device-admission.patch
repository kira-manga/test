+        LocalSdkRpcPurposes.CREDENTIAL_ROTATION -> "local.auth.refresh"
+        LocalSdkRpcPurposes.REVOCATION_CHALLENGE -> "local.auth.logout"
+        else -> error("Challenge has no employee dispatch")
+    })
+    if (binding.purpose == LocalSdkRpcPurposes.LOGIN_CHALLENGE) {
+        val bytes = signedOutput.copyBytes()
+        try { require(dispatch.semantic.identity == sha256(bytes).value) } finally { bytes.fill(0) }
+    } else require(dispatch.semantic.identity == if (binding.purpose == LocalSdkRpcPurposes.CREDENTIAL_ROTATION) "refresh" else "logout")
+}
