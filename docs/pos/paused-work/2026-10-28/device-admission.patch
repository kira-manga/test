+/** App-owned AndroidKeyStore keys only. No imported/exportable key or replacement on failure. */
+public fun inspectAndroidNativeClientJournalKey(
+    store: KeyStore, alias: String, protection: SelfOwnedKeyProtectionV1,
+): Pair<SecretKey, Int> {
+    check(store.containsAlias(alias))
+    val key = store.getKey(alias, null) as? SecretKey ?: error("client.journal.key")
+    val exported = key.encoded
+    if (exported != null) { exported.fill(0); error("client.journal.exportable-key") }
+    check(key.algorithm == KeyProperties.KEY_ALGORITHM_AES && key.format == null)
+    val info = SecretKeyFactory.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore")
+        .getKeySpec(key, KeyInfo::class.java) as KeyInfo
+    check(info.keystoreAlias == alias && info.keySize == 256 &&
+        info.purposes == (KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT) &&
+        info.origin == KeyProperties.ORIGIN_GENERATED && !info.isUserAuthenticationRequired &&
+        !info.isUserAuthenticationValidWhileOnBody && !info.isTrustedUserPresenceRequired &&
+        !info.isUserConfirmationRequired && info.keyValidityStart == null &&
+        info.keyValidityForOriginationEnd == null && info.keyValidityForConsumptionEnd == null &&
+        info.remainingUsageCount == -1 && info.signaturePaddings.isEmpty() && info.digests.isEmpty() &&
+        info.blockModes.toSet() == setOf(KeyProperties.BLOCK_MODE_GCM) &&
+        info.encryptionPaddings.toSet() == setOf(KeyProperties.ENCRYPTION_PADDING_NONE))
+    val level = info.securityLevel
+    check(level in setOf(KeyProperties.SECURITY_LEVEL_SOFTWARE,
+        KeyProperties.SECURITY_LEVEL_TRUSTED_ENVIRONMENT, KeyProperties.SECURITY_LEVEL_STRONGBOX))
+    when (protection) {
+        SelfOwnedKeyProtectionV1.OS_ISOLATED -> Unit
+        SelfOwnedKeyProtectionV1.SECURE_HARDWARE -> check(level != KeyProperties.SECURITY_LEVEL_SOFTWARE)
+        SelfOwnedKeyProtectionV1.STRONGBOX -> check(level == KeyProperties.SECURITY_LEVEL_STRONGBOX)
+    }
+    return key to level
+}
+
+/** A failed/unknown generation leaves its original alias for inspection, never delete-and-retry. */
+public fun createAndroidNativeClientJournalKey(store: KeyStore, alias: String, protection: SelfOwnedKeyProtectionV1) {
+    check(!store.containsAlias(alias))
+    val spec = KeyGenParameterSpec.Builder(alias, KeyProperties.PURPOSE_ENCRYPT or KeyProperties.PURPOSE_DECRYPT)
+        .setKeySize(256).setBlockModes(KeyProperties.BLOCK_MODE_GCM)
+        .setEncryptionPaddings(KeyProperties.ENCRYPTION_PADDING_NONE)
+        .setRandomizedEncryptionRequired(true).setUserAuthenticationRequired(false)
+        .setIsStrongBoxBacked(protection == SelfOwnedKeyProtectionV1.STRONGBOX).build()
+    KeyGenerator.getInstance(KeyProperties.KEY_ALGORITHM_AES, "AndroidKeyStore").run {
+        init(spec); generateKey()
+    }
+    inspectAndroidNativeClientJournalKey(store, alias, protection)
+}
