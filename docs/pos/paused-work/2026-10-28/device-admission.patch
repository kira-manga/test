+/** Non-authorizing parsed native-key names. Only an actual owner can join these to files,
+ * private-store/key continuity and a complete manifest. A parsed head is never open evidence. */
+public data class AndroidNativeClientJournalHeadEntry(public val sequence: Long, public val digest: String, public val alias: String)
+
+/** The one shared, nonmutating native-head parser. No missing-head recreation or old-head
+ * fallback. Callers keep their own real native watchdog/owner active around the complete read. */
+public fun readAndroidNativeClientJournalHeads(store: KeyStore, prefix: String,
+    protection: SelfOwnedKeyProtectionV1): List<AndroidNativeClientJournalHeadEntry> {
+    val found = ArrayList<AndroidNativeClientJournalHeadEntry>(2)
+    val names = store.aliases()
+    val journalPrefix = prefix.removeSuffix("/").substringBeforeLast("/") + "/"
+    var count = 0
+    while (names.hasMoreElements()) {
+        check(++count <= 65_536)
+        val name = names.nextElement()
+        if (name.startsWith(journalPrefix)) check(name.startsWith(prefix))
+        if (!name.startsWith(prefix)) continue
+        check(found.size < 2)
+        val suffix = name.removePrefix(prefix)
+        check(suffix.length == 81 && suffix[16] == '/' &&
+            suffix.take(16).all { it in '0'..'9' || it in 'a'..'f' })
+        val sequence = suffix.take(16).toLong(16)
+        val digest = suffix.drop(17)
+        check(sequence >= 0 && digest.length == 64 && digest.all { it in '0'..'9' || it in 'a'..'f' })
+        val canonical = prefix + sequence.toString(16).padStart(16, '0') + "/" + digest
+        check(canonical == name && found.none { it.sequence == sequence })
+        inspectAndroidNativeClientJournalKey(store, name, protection)
+        found.add(AndroidNativeClientJournalHeadEntry(sequence, digest, name))
+    }
+    val result = found.sortedBy { it.sequence }
+    if (result.size == 2) check(result[0].sequence < Long.MAX_VALUE && result[1].sequence == result[0].sequence + 1)
+    return result
