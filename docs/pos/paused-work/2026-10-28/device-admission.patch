+    val targetSdkAssociation: LocalSdkNoiseAssociation, val retainedAdmissions: List<LocalDeviceAdmission>,
+    val retainedAdmissionDigests: List<Pair<DomainId, PayloadDigest>>, val accounts: List<LocalDeviceAdmissionAccountCensus>) {
+    init {
+        require(pairing.phase == LocalDevicePairingPhase.APPROVED)
