+    public val requestId: DomainId get() = value.body.requestId
+    public val originalIntentId: DomainId get() = value.body.originalIntentId
+    public val purpose: LocalNativeSdkRpcPreparationPurpose get() = value.body.purpose
+    public val scope: BranchScope get() = value.body.scope
+    public val originatingDeviceId: DomainId get() = value.body.originatingDeviceId
+    public val originalAdmissionActionId: DomainId get() = value.body.originalAdmissionActionId
+    public val originalTransportDigest: PayloadDigest get() = value.body.originalTransportDigest
+    public val vaultAllocationId: DomainId get() = value.body.vaultAllocationId
+    public val journalId: DomainId get() = value.body.journalId
+    public val journalKeyId: DomainId get() = value.body.journalKeyId
+    public val journalRevision: Long get() = value.body.journalRevision
+    public val journalPlaintextDigest: PayloadDigest get() = value.body.journalPlaintextDigest
+    public val originalVaultOpenActionId: DomainId get() = value.body.originalVaultOpenActionId
+    public val originalNativeReadDigest: PayloadDigest get() = value.body.originalNativeReadDigest
+    public val login: LocalLoginIdentifier? get() = value.body.login
+    public val originalActorId: DomainId? get() = value.body.originalActorId
+    public val originalServiceIncarnationId: DomainId? get() = value.body.originalServiceIncarnationId
+    public val originalSessionId: DomainId? get() = value.body.originalSessionId
+    public val originalGeneration: SessionGeneration? get() = value.body.originalGeneration
+    public val originalMasterSdkAssociation: LocalSdkNoiseAssociation get() = value.body.originalMasterSdkAssociation
+    public val targetSdkAssociation: LocalSdkNoiseAssociation get() = value.body.targetSdkAssociation
+    public val requestDigest: PayloadDigest = sha256(bytes)
+    public fun copyWireBytes(): ByteArray = bytes.copyOf()
+    override fun toString(): String = "LocalNativeSdkRpcPreparationRequest([REDACTED])"
+    public companion object {
+        internal fun fromNative(value: NativeLocalSdkRpcPreparationRequestV1): LocalNativeSdkRpcPreparationRequest {
+            val encoded = NativeDeviceAdmissionWireV1.sdkPreparationRequest(value)
+            return try { LocalNativeSdkRpcPreparationRequest(encoded) } finally { encoded.fill(0) }
+        }
+        public fun decode(canonical: ByteArray): LocalNativeSdkRpcPreparationRequest {
