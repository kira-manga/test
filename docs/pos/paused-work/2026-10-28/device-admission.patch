+package com.ukkera.pos.security
+
+import com.ukkera.pos.types.DomainId
+
+/** Holder only. The Android producer accepts the final actual SDK-created identity/peer,
+ * not subclasses, an accepting callback, a caller session or P-256/Noise key aliases. */
+public abstract class LocalDeviceAdmissionNoiseIdentity internal constructor() {
+    public abstract val association: LocalSdkNoiseAssociation
+}
+public abstract class LocalDeviceAdmissionNoisePeer internal constructor() {
+    public abstract val association: LocalSdkNoiseAssociation
+}
+
+public object LocalDeviceAdmissionProfileV1 {
+    public const val PURPOSE: String = "EXPLICIT_NAMED_COMPANY_HEAD_ORIGINAL_DEVICE_ADMISSION_DUAL_IDENTITY_V1"
+    public const val MAXIMUM_ACTIONS: Int = 256
+    public const val MAXIMUM_DEFINITION_BYTES: Int = 12 * 1024 * 1024
+    public const val MAXIMUM_CHALLENGE_BYTES: Int = MAXIMUM_DEFINITION_BYTES + 16 * 1024
+    public const val MAXIMUM_PROOF_BYTES: Int = 2048
+    public const val MAXIMUM_COMPLETION_BYTES: Int = 2 * 1024 * 1024
+    public const val MAXIMUM_CERTIFICATE_BYTES: Int = MAXIMUM_CHALLENGE_BYTES + MAXIMUM_COMPLETION_BYTES + 32 * 1024
+    internal const val MAXIMUM_STATE_BYTES: Int = SelfOwnedInstallationProfileV1.MAXIMUM_REGISTRY_BYTES
+    internal const val MAXIMUM_PLAINTEXT_BYTES: Int = MAXIMUM_STATE_BYTES - 2048
+}
+
+/** Complete protected dependencies of one EXISTING account before a new-device insert.
+ * DATA hashes do not establish absence, history completeness, a peer or employee authority. */
+public data class LocalDeviceAdmissionAccountCensus(
+    public val actorId: DomainId,
+    public val accountDigest: PayloadDigest,
+    public val policyDigest: PayloadDigest,
+    public val configurationDigest: PayloadDigest,
+    public val accountThrottleDigest: PayloadDigest,
+    public val deviceThrottleDigests: List<Pair<DomainId, PayloadDigest>>,
+) {
+    init {
+        require(deviceThrottleDigests.size in 1..256 && deviceThrottleDigests.map { it.first }.distinct().size == deviceThrottleDigests.size &&
+            deviceThrottleDigests == deviceThrottleDigests.sortedBy { it.first.value })
+    }
+}
+
+/** Exact original approved P256 pairing, unchanged ADMIT_DEVICE bytes, both real SDK
+ * identities and the COMPLETE current Room account/admission census. No granted authority. */
+public class LocalDeviceAdmissionDefinition private constructor(canonical: ByteArray) {
+    private val bytes = canonical.copyOf()
+    internal val value = NativeDeviceAdmissionWireV1.decodeDefinition(bytes)
+    public val request: LocalProvisioningRequest get() = value.pairing.body.requested().request
+    public val admission: LocalDeviceAdmission get() = value.pairing.body.requested().admission
+    public val target: LocalDevicePairingTargetDescriptor get() = value.pairing.body.requested().target
+    public val originalPairingActionId: DomainId get() = value.pairing.body.originalActionId
+    public val originalPairingAuthorityDigest: PayloadDigest get() = LocalDevicePairingApproval(value.pairing).authorityDigest
+    public val originalMasterAdmission: LocalDeviceAdmission get() = value.originalMasterAdmission
+    public val originalMasterSdkAssociation: LocalSdkNoiseAssociation get() = value.originalMasterSdkAssociation
+    public val targetSdkAssociation: LocalSdkNoiseAssociation get() = value.targetSdkAssociation
+    public val retainedAdmissions: List<LocalDeviceAdmission> get() = value.retainedAdmissions.toList()
+    public val retainedAdmissionDigests: List<Pair<DomainId, PayloadDigest>> get() = value.retainedAdmissionDigests.toList()
+    public val accounts: List<LocalDeviceAdmissionAccountCensus> get() = value.accounts.toList()
+    public val definitionDigest: PayloadDigest = sha256(bytes)
+    public fun copyCanonicalServiceAdmission(): ByteArray = value.pairing.body.requested().copyCanonicalServiceAdmission()
+    public fun copyWireBytes(): ByteArray = bytes.copyOf()
+    override fun toString(): String = "LocalDeviceAdmissionDefinition([REDACTED])"
+    public companion object {
+        /** Pure DATA capture. The actual native original producer independently checks the
+         * exact retained pairing, native cut and FINAL SDK identity/peer objects. */
