+        require(originalMasterAdmission.scope == requested.request.scope && originalMasterAdmission.deviceId == origin.coordinates.deviceId &&
+            originalMasterAdmission.admitted && originalMasterAdmission.revision == Revision(0) &&
+            originalMasterSdkAssociation != targetSdkAssociation && originalMasterSdkAssociation.appId == targetSdkAssociation.appId &&
+            originalMasterSdkAssociation.peerId != targetSdkAssociation.peerId && originalMasterSdkAssociation.fingerprint != targetSdkAssociation.fingerprint)
+        require(retainedAdmissions.size in 1..255 && retainedAdmissions == retainedAdmissions.sortedBy { it.deviceId.value } &&
+            retainedAdmissions.map { it.deviceId }.distinct().size == retainedAdmissions.size &&
+            retainedAdmissions.all { it.scope == requested.request.scope && it.deviceId != requested.admission.deviceId } &&
+            retainedAdmissions.single { it.deviceId == originalMasterAdmission.deviceId } == originalMasterAdmission)
+        require(retainedAdmissionDigests.map { it.first } == retainedAdmissions.map { it.deviceId })
+        require(accounts.size in 1..4096 && accounts == accounts.sortedBy { it.actorId.value } &&
+            accounts.map { it.actorId }.distinct().size == accounts.size && origin.coordinates.firstActorId in accounts.map { it.actorId } &&
+            accounts.all { it.deviceThrottleDigests.map { it.first } == retainedAdmissions.map { it.deviceId } })
