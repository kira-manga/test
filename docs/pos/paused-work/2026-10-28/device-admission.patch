+/** The only target lane-selection/session-continuity policy is common. It reuses the exact
+ * existing journal phases: restarted RETAINED is revocation-only, and a dispatched unknown
+ * REFRESH_PENDING can revoke only the original, never retry or restore its unknown successor. */
+internal class NativeTargetRpcSourceState(private val retainedAttemptIds: Set<DomainId>) {
+    private data class State(val denied: Boolean = false, val generation: Long = 0,
+        val service: DomainId? = null, val challenge: LocalNativeSdkRpcChallenge? = null,
+        val publication: NativeTargetAuthenticationPublicationV1? = null,
+        val originalRequests: Map<PayloadDigest, Pair<String, String>> = emptyMap(),
+        val dispatchedIntents: Set<String> = emptySet())
+    private val state = MutableStateFlow(State())
+    val generation: Long get() = state.value.generation
+    val denied: Boolean get() = state.value.denied
+    val serviceIncarnationId: DomainId? get() = state.value.service
+    val retainedChallenge: LocalNativeSdkRpcChallenge? get() = state.value.challenge
+
+    fun withdraw() {
+        while (true) {
+            val previous = state.value
+            if (previous.denied) return
+            val next = if (previous.generation == Long.MAX_VALUE) previous.copy(denied = true)
+                else previous.copy(generation = previous.generation + 1)
+            if (state.compareAndSet(previous, next)) return
+        }
+    }
+    fun deny() {
+        while (true) { val previous = state.value; if (previous.denied || state.compareAndSet(previous,
+            previous.copy(denied = true, publication = null, challenge = null))) return }
+    }
+    fun selectPreparation(facts: NativeTargetCredentialJournalFactsV1, originalIntentId: DomainId?,
+        originalOpenActionId: DomainId, purpose: LocalNativeSdkRpcPreparationPurpose): NativeTargetRpcPreparationSelector {
+        val current = state.value; check(!current.denied)
+        check((originalIntentId == null) == (purpose == LocalNativeSdkRpcPreparationPurpose.SERVICE_OBSERVATION))
+        if (originalIntentId == null) return NativeTargetRpcPreparationSelector(originalOpenActionId,
+            LocalNativeSdkRpcPreparationPurpose.SERVICE_OBSERVATION, null, null, null, null, null)
+        if (purpose == LocalNativeSdkRpcPreparationPurpose.LOGIN_CHALLENGE) {
+            val attempt = facts.attempts.single { it.id == originalIntentId }
+            check(attempt.id !in retainedAttemptIds && current.service == attempt.serviceIncarnationId &&
+                intentKey(attempt.id, purpose, null) !in current.dispatchedIntents)
+            return NativeTargetRpcPreparationSelector(attempt.id, purpose, attempt.login, null, attempt.serviceIncarnationId, null, null)
+        }
+        val row = facts.sessions.single { it.localId == originalIntentId }
+        when (purpose) {
+            LocalNativeSdkRpcPreparationPurpose.CREDENTIAL_ROTATION -> check(current.publication?.matches(row) == true &&
+                row.phase == NativeTargetJournalSessionPhaseV1.REFRESH_PENDING && !row.originalRevoked &&
+                intentKey(row.localId, purpose, row.generation) !in current.dispatchedIntents && current.service == row.serviceIncarnationId)
+            // Only the genuine durable pending cleanup phase may dispatch revocation. A
+            // restarted RETAINED row is not authority: the common gateway must first force
+            // its explicit REVOCATION_PENDING successor. Unknown rotation successors are
+            // never retried; REFRESH_PENDING can revoke only its retained original.
+            LocalNativeSdkRpcPreparationPurpose.REVOCATION_CHALLENGE -> check(!row.originalRevoked &&
+                row.phase in setOf(NativeTargetJournalSessionPhaseV1.REVOCATION_PENDING, NativeTargetJournalSessionPhaseV1.REFRESH_PENDING))
+            else -> error("Unsupported target native preparation")
+        }
+        return NativeTargetRpcPreparationSelector(row.localId, purpose, null, row.actorId, row.serviceIncarnationId, row.sessionId, row.generation)
+    }
+    fun retainChallenge(challenge: LocalNativeSdkRpcChallenge) {
+        while (true) {
+            val previous = state.value; check(!previous.denied)
+            check(challenge.request.purpose == LocalNativeSdkRpcPreparationPurpose.SERVICE_OBSERVATION ||
+                challenge.request.originalServiceIncarnationId == challenge.serviceIncarnationId ||
+                challenge.request.purpose == LocalNativeSdkRpcPreparationPurpose.REVOCATION_CHALLENGE)
+            val next = previous.copy(service = challenge.serviceIncarnationId,
+                challenge = if (challenge.binding == null) previous.challenge else challenge)
+            if (state.compareAndSet(previous, next)) return
+        }
+    }
+    fun selectBinding(source: NativeTargetClientVaultCustody, facts: NativeTargetCredentialJournalFactsV1,
+        retainedOriginalDisclosure: Boolean = false): LocalSdkRpcBinding? {
+        val current = state.value; if (current.denied) return null
+        val retained = current.challenge
+        if (retainedOriginalDisclosure && retained != null && retained.challengeDigest in current.originalRequests &&
+            retained.request.journalRevision == facts.revision && retained.request.journalPlaintextDigest == facts.plaintextDigest) return retained.binding
+        if (retained != null && retained.challengeDigest !in current.originalRequests && retained.request.journalRevision == facts.revision &&
+            retained.request.journalPlaintextDigest == facts.plaintextDigest) return retained.binding
+        val publication = current.publication
+        if (publication != null && current.service == publication.serviceIncarnationId && publication.scope == source.scope && publication.deviceId == source.deviceId &&
+            facts.sessions.any { it.phase == NativeTargetJournalSessionPhaseV1.RETAINED && !it.originalRevoked && publication.matches(it) })
+            return localNativeSdkEmployeeBinding(source.scope, publication.actorId, publication.serviceIncarnationId, publication.sessionId, publication.generation)
+        val challenge = current.challenge ?: return null
+        val request = challenge.request
+        if (request.journalRevision != facts.revision || request.journalPlaintextDigest != facts.plaintextDigest) return null
+        if (!retainedOriginalDisclosure && challenge.challengeDigest in current.originalRequests) return null
+        return challenge.binding
+    }
+    fun confirmOriginal(binding: LocalSdkRpcBinding, context: LocalSdkRpcRequestContext): Boolean {
+        val current = state.value
+        if (current.denied || context.binding != binding || context.procedureVersion != 1) return false
+        return when (binding.purpose) {
+            LocalSdkRpcPurposes.LOGIN_CHALLENGE -> context.procedureName == "local.auth.sign-in"
+            LocalSdkRpcPurposes.CREDENTIAL_ROTATION -> context.procedureName == "local.auth.refresh"
+            LocalSdkRpcPurposes.REVOCATION_CHALLENGE -> context.procedureName == "local.auth.logout"
+            LocalSdkRpcPurposes.EMPLOYEE_APPLICATION -> context.procedureName in setOf("local.auth.current", "local.master.execute", "local.master.lookup", "local.master.read")
+            else -> false
+        }
+    }
+    fun admitOriginalAuthRequest(challenge: LocalNativeSdkRpcChallenge, context: LocalSdkRpcRequestContext): Boolean {
+        while (true) {
+            val previous = state.value
+            if (previous.denied || previous.challenge?.challengeDigest != challenge.challengeDigest) return false
+            val retained = previous.originalRequests[challenge.challengeDigest]
+            if (retained != null) return retained == (context.requestId to context.requestDigest)
+            if (previous.originalRequests.size >= NativeTargetClientVaultProfileV1.MAXIMUM_PREPARATION_ACTIONS) return false
+            if (state.compareAndSet(previous, previous.copy(originalRequests = previous.originalRequests +
+                (challenge.challengeDigest to (context.requestId to context.requestDigest)), dispatchedIntents = previous.dispatchedIntents +
+                intentKey(challenge.request.originalIntentId, challenge.request.purpose, challenge.request.originalGeneration)))) return true
+        }
+    }
+    fun retainPublication(challenge: LocalNativeSdkRpcChallenge, publication: NativeTargetAuthenticationPublicationV1) {
+        while (true) {
+            val previous = state.value
+            check(!previous.denied && previous.challenge?.challengeDigest == challenge.challengeDigest &&
+                challenge.challengeDigest in previous.originalRequests && publication.originalBinding == challenge.binding)
+            if (state.compareAndSet(previous, previous.copy(publication = publication))) return
+        }
+    }
+    fun matchesOriginal(challenge: LocalNativeSdkRpcChallenge, requestId: String, requestDigest: PayloadDigest): Boolean =
+        state.value.let { !it.denied && it.originalRequests[challenge.challengeDigest] == (requestId to requestDigest.value) }
+    fun originalRequestRegistered(challenge: LocalNativeSdkRpcChallenge): Boolean =
+        state.value.let { !it.denied && challenge.challengeDigest in it.originalRequests }
+    fun clearPublicationForOriginal(challenge: LocalNativeSdkRpcChallenge) {
+        while (true) {
+            val previous = state.value; check(!previous.denied && previous.challenge?.challengeDigest == challenge.challengeDigest &&
+                challenge.challengeDigest in previous.originalRequests)
+            if (state.compareAndSet(previous, previous.copy(publication = null))) return
+        }
+    }
+    private fun intentKey(id: DomainId, purpose: LocalNativeSdkRpcPreparationPurpose, generation: SessionGeneration?): String =
+        "${id.value}|${purpose.name}|${generation?.value ?: 0}"
+}
+
+internal fun LocalNativeSdkRpcPreparationRequest.matchesSelector(selector: NativeTargetRpcPreparationSelector): Boolean =
+    originalIntentId == selector.originalIntentId && purpose == selector.purpose && login == selector.login &&
+        originalActorId == selector.originalActorId && originalServiceIncarnationId == selector.originalServiceIncarnationId &&
+        originalSessionId == selector.originalSessionId && originalGeneration == selector.originalGeneration
+
+/** Shared exact binding DATA grammar. Only the original protected master selects actor;
+ * these factories/checks do not authenticate credentials or manufacture a cut. */
+internal fun nativeSdkPreludeBinding(request: LocalNativeSdkRpcPreparationRequest, issuedId: DomainId, actorId: DomainId): LocalSdkRpcBinding {
+    require(request.purpose != LocalNativeSdkRpcPreparationPurpose.SERVICE_OBSERVATION)
+    val login = request.purpose == LocalNativeSdkRpcPreparationPurpose.LOGIN_CHALLENGE
+    if (!login) require(request.originalActorId == actorId)
+    return LocalSdkRpcBinding(request.scope.rpcScopeId(), actorId.value,
+        if (login) "challenge:${issuedId.value}" else "local:${requireNotNull(request.originalServiceIncarnationId).value}:${requireNotNull(request.originalSessionId).value}:${requireNotNull(request.originalGeneration).value}",
+        when (request.purpose) {
+            LocalNativeSdkRpcPreparationPurpose.LOGIN_CHALLENGE -> LocalSdkRpcPurposes.LOGIN_CHALLENGE
+            LocalNativeSdkRpcPreparationPurpose.CREDENTIAL_ROTATION -> LocalSdkRpcPurposes.CREDENTIAL_ROTATION
+            LocalNativeSdkRpcPreparationPurpose.REVOCATION_CHALLENGE -> LocalSdkRpcPurposes.REVOCATION_CHALLENGE
+            LocalNativeSdkRpcPreparationPurpose.SERVICE_OBSERVATION -> error("No service-observation RPC binding")
+        }, LocalNativeSdkRpcPreludeProfileV1.PROJECTION_ID)
+}
+
+internal fun requireNativeTargetIssuedChallengeData(source: NativeTargetClientVaultCustody, original: LocalNativeSdkRpcPreparationRequest,
+    challenge: LocalNativeSdkRpcChallenge) {
+    require(challenge.request.requestDigest == original.requestDigest && challenge.request.requestId == original.requestId &&
+        original.scope == source.scope && original.originatingDeviceId == source.deviceId && original.vaultAllocationId == source.allocation.allocationId &&
+        original.journalId == source.journalId && original.journalKeyId == source.allocation.keyId &&
+        original.originalVaultOpenActionId == source.allocation.originalOpenActionId &&
+        original.originalAdmissionActionId == source.originalAdmissionActionId &&
+        original.originalMasterSdkAssociation == source.originalMasterSdkAssociation && original.targetSdkAssociation == source.targetSdkAssociation &&
+        challenge.rootDocumentDigest == source.allocation.association.record.body.target.rootDocumentDigest)
+    when (original.purpose) {
+        LocalNativeSdkRpcPreparationPurpose.SERVICE_OBSERVATION -> require(challenge.binding == null)
+        LocalNativeSdkRpcPreparationPurpose.LOGIN_CHALLENGE, LocalNativeSdkRpcPreparationPurpose.CREDENTIAL_ROTATION ->
+            require(original.originalServiceIncarnationId == challenge.serviceIncarnationId)
+        LocalNativeSdkRpcPreparationPurpose.REVOCATION_CHALLENGE -> Unit // Original expired/service-context session only.
+    }
+    challenge.binding?.let { binding ->
+        val actor = DomainId(binding.actorId)
+        require(Regex("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}").matches(actor.value))
+        require(binding == nativeSdkPreludeBinding(original, challenge.issuedId, actor))
+    }
+}
+
+/** Target never compares the master's unrelated boot/elapsed clock to its own. It applies
+ * one original LOCAL monotonic denial window retained before original signing; repeat signed
+ * DATA/readback cannot renew it. Android supplies only the actual local observations. */
+internal class NativeTargetRpcPreparationWitnessV1(val request: LocalNativeSdkRpcPreparationRequest, val observedLocalElapsedMillis: Long) {
+    val localDeadline: Long = observedLocalElapsedMillis.let {
+        require(it >= 0 && it <= Long.MAX_VALUE - LocalNativeSdkRpcPreludeProfileV1.WINDOW_MILLIS)
+        it + LocalNativeSdkRpcPreludeProfileV1.WINDOW_MILLIS
+    }
+    fun current(now: Long): Boolean = now in observedLocalElapsedMillis until localDeadline
+}
+
+internal fun requireNativeTargetVaultNextAction(action: NativeTargetClientVaultAction, previousReads: List<NativeTargetClientVaultOpenReadV1?>) {
+    require(previousReads.size < NativeTargetClientVaultProfileV1.MAXIMUM_OPEN_ACTIONS)
+    if (previousReads.isEmpty()) require(action == NativeTargetClientVaultAction.ENROLL_ORIGINAL)
+    else {
+        require(action != NativeTargetClientVaultAction.ENROLL_ORIGINAL)
+        if (previousReads.last() == null) require(action == NativeTargetClientVaultAction.RECOVER_PENDING_WRITES)
+    }
+}
+
+/** The sole shared original-journal successor rule. A new ciphertext/head or revision is
