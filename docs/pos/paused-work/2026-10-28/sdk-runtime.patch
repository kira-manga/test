+        val branch = DomainId(text(36)); val operation = OperationId(text(36)); val actor = DomainId(text(36)); val version = counter()
+        require(version in 1..Int.MAX_VALUE.toLong()); return OperationIdentity(branch, operation, actor, version.toInt(), text(64))
+    }
+    fun recorded(): MutationReply.Recorded {
+        val operation = OperationId(text(36)); val actor = DomainId(text(36)); val committed = boolean(); val code = text(96)
+        requireProtocolName(code)
+        val result = stored(); val epoch = Revision(counter()); val sequence = JournalSequence(counter()); val time = UtcInstant.parseCanonical(text(64))
+        val replayed = boolean(); require(u8() == 0)
+        return MutationReply.Recorded(operation, actor, committed, code, result, epoch, sequence, time, replayed, physicalStart = null)
+    }
+    fun deferredReason(): DeferredReason = DeferredReason.valueOf(text(96))
+    fun mutationReply(): MutationReply = when (u8()) {
+        1 -> recorded()
+        2 -> MutationReply.Deferred(OperationId(text(36)), deferredReason())
+        3 -> MutationReply.IdentityConflict(OperationId(text(36)))
+        else -> throw IllegalArgumentException("Unknown mutation reply")
+    }
+    fun finished(): Boolean = at == input.size
+    fun destroyCopies() { copies.forEach { it.fill(0) }; copies.clear() }
+}
+
+private fun MutationReply.operationId(): OperationId = when (this) {
+    is MutationReply.Recorded -> operationId
+    is MutationReply.Deferred -> operationId
+    is MutationReply.IdentityConflict -> operationId
