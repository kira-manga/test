+internal class LocalMasterSdkRpcPhysicalDriver private constructor(
+    private val source: LocalMasterTargetRpcSource,
+    private val acquisition: LocalMasterSdkRpcPhysicalAcquisition,
+) {
+    private class Original(val peer: LocalSdkNoisePeer, var cleanup: CompletableDeferred<Unit>? = null)
+    private val lock = Mutex()
+    private val originals = mutableListOf<Original>()
+    private var held = false
