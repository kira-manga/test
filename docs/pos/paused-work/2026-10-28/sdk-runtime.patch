+    var value: T? = null
+    return try { reader.read().also { value = it; require(reader.finished()) } }
+    catch (failure: Throwable) {
+        when (val parsed = value) {
+            is LocalMasterRpcRequestV1 -> parsed.destroy()
+            is LocalAuthenticationResult.Authenticated -> parsed.tokens.destroy()
