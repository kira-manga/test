+    }
+
+    public suspend fun retainOriginalKnownUnsignedRetirement(): AndroidDevicePairingTargetResult<AndroidDevicePairingTargetReference> = deliver {
+        val certificate = channel.receive(LocalSdkNativePreludeKind.KNOWN_UNSIGNED_RETIREMENT) as LocalSdkNativePreludeMessage.KnownUnsignedRetirement
+        val result = target.beginAfterKnownUnsigned(certificate.value)
+        channel.close()
+        result
+    }
+
+    private suspend fun <T> deliver(action: suspend () -> AndroidDevicePairingTargetResult<T>): AndroidDevicePairingTargetResult<T> {
+        try {
+            if (!channel.isCurrent()) throw LocalSdkNativePreludeUnavailable()
+            val result = action()
+            if (result is AndroidDevicePairingTargetResult.Unavailable) channel.close()
