+/** Final source-compatible native view of one exact common-owned actual SDK session. */
+public class AndroidSdkNoisePeer private constructor(
+    private val owner: AndroidSdkLanOwner,
+    internal val commonProof: LocalSdkNoisePeer,
+) : LocalDeviceAdmissionNoisePeer() {
+    override public val association: LocalSdkNoiseAssociation get() = commonProof.association
+    public val connectionId: DomainId get() = commonProof.connectionId
+    public val generation: Long get() = commonProof.generation
+
+    public fun isCurrent(): Boolean = commonProof.isOriginalNativeView(this)
+    public fun matches(expected: LocalSdkNoiseAssociation): Boolean = isCurrent() && commonProof.matches(expected)
+    public fun belongsTo(identity: AndroidSdkNoiseIdentity): Boolean = isCurrent() && identity.belongsTo(owner) &&
+        commonProof.belongsTo(identity.commonProof)
+    public fun actualLocalIdentity(): AndroidSdkNoiseIdentity =
+        if (isCurrent() && owner.identity.commonProof === commonProof.actualLocalIdentity()) owner.identity
+        else throw LocalSdkTransportUnavailable()
+    /** Capability-preserving common view, not an exposed kit, SDK object or raw sender. */
+    public fun actualCommonPeer(): LocalSdkNoisePeer = if (isCurrent()) commonProof else throw LocalSdkTransportUnavailable()
+    public fun isEnrollmentOnly(): Boolean = isCurrent() && commonProof.isEnrollmentOnly()
+    public suspend fun captureRpcLifetime(binding: LocalSdkRpcBinding): LocalSdkRpcLifetimeCapture? =
+        if (isCurrent()) commonProof.captureRpcLifetime(binding) else null
+
+    public suspend fun openEnrollmentPrelude(identity: AndroidSdkNoiseIdentity): LocalSdkNativePrelude {
+        if (!belongsTo(identity)) throw LocalSdkNativePreludeUnavailable()
+        return commonProof.openEnrollmentPrelude(identity.commonProof)
+    }
+    public suspend fun openAdmittedPrelude(identity: AndroidSdkNoiseIdentity): LocalSdkNativePrelude {
+        if (!belongsTo(identity)) throw LocalSdkNativePreludeUnavailable()
+        return commonProof.openAdmittedPrelude(identity.commonProof)
+    }
+    public suspend fun openHost(cut: LocalSdkRpcAuthorityCut, protocol: LocalSdkRpcHostProtocol): LocalSdkScopedHost =
+        commonProof.openHost(cut, protocol)
+    public suspend fun openClient(cut: LocalSdkRpcAuthorityCut): LocalSdkScopedClient = commonProof.openClient(cut)
+    public suspend fun close(): Unit = commonProof.close()
+    internal fun belongsToOwner(value: AndroidSdkLanOwner): Boolean = owner === value
+    override fun toString(): String = "AndroidSdkNoisePeer(actual authenticated native SDK view, identifiers omitted)"
+
+    internal companion object {
+        fun capture(owner: AndroidSdkLanOwner, proof: LocalSdkNoisePeer): LocalDeviceAdmissionNoisePeer =
+            proof.retainOriginalNativeView(AndroidSdkNoisePeer(owner, proof))
+    }
+}
