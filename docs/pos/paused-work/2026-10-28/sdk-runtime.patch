+    suspend fun openPrelude(): LocalSdkNativePrelude = lock.withLock {
+        try {
+            val peer = acquireNextFresh()
+            peer.openAdmittedPrelude(peer.actualLocalIdentity()).also { channel ->
+                check(source.isCurrent() && channel.isCurrent() && channel.targetSide &&
+                    channel.localAssociation == source.targetSdkAssociation && channel.peerAssociation == source.originalMasterSdkAssociation)
+            }
+        } catch (failure: Throwable) { retireAfterFailure(failure); throw failure }
+    }
+
+    suspend fun openScoped(purpose: LocalNativeSdkRpcPreparationPurpose?, originalIntentId: DomainId): LocalMasterScopedRpcClient = lock.withLock {
+        try {
+            val peer = acquireNextFresh()
+            val cut = source.captureNextOutgoing(peer.actualNativeAdmissionPeer(), purpose, originalIntentId)
+            val rpc = peer.openClient(cut)
