+package com.ukkera.pos.app.gateway
+
+import com.ukkera.pos.security.AndroidSdkLanOwner
+import com.ukkera.pos.security.LocalSdkNoisePeer
+
+/**
+ * Closed genuine target composition only. It preserves the actual original full credential
+ * vault and protected SDK key owner; no callback, caller binding, substituted kit/session or
+ * in-memory journal is accepted. Common owns every physical transition and retained cleanup.
+ * The root independently retains/closes the SDK owner and vault; this factory never reopens
+ * the original master database, upgrades an enrollment lifetime or restores a cold UI login.
+ */
+public object AndroidLocalMasterScopedRpcConnections {
+    public fun fromActual(vault: AndroidTargetLocalClientVault, sdk: AndroidSdkLanOwner,
+        installed: LocalWorkflowInstallation, labels: LocalBranchDisplayLabels): LocalMasterScopedRpcConnectionOwner {
+        val source = vault.rpcSource
+        check(vault.isCurrent() && source.isCurrent() && sdk.isCurrent() &&
+            sdk.identity.matches(source.targetSdkAssociation) && labels.scope == source.scope)
+        val actual = ActualAndroidAcquisition(sdk, source)
+        val driver = LocalMasterSdkRpcPhysicalDriver.fromActual(source, actual)
+        return LocalMasterScopedRpcConnectionOwner.fromActual(source, driver, installed, labels)
+    }
+
+    private class ActualAndroidAcquisition(
+        private val sdk: AndroidSdkLanOwner,
+        private val source: LocalMasterTargetRpcSource,
+    ) : LocalMasterSdkRpcPhysicalAcquisition() {
+        override suspend fun connectFresh(): LocalSdkNoisePeer =
+            sdk.connectFresh(source.originalMasterSdkAssociation).actualCommonPeer()
+    }
+}
