+
+private class RpcPacketReader(private val input: ByteArray) {
+    private var at = 0
+    private val copies = mutableListOf<ByteArray>()
+    fun u8(): Int { require(at < input.size); return input[at++].toInt() and 255 }
+    fun u16(): Int = (u8() shl 8) or u8()
+    fun counter(): Long { var value = 0L; repeat(8) { value = (value shl 8) or u8().toLong() }; require(value >= 0); return value }
