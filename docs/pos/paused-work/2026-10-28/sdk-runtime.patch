+            } catch (failure: Throwable) {
+                withContext(NonCancellable) { try { channel.close() } catch (cleanup: Throwable) {
+                    if (cleanup !== failure) failure.addSuppressed(cleanup)
+                } }
+                throw failure
+            }
+        }
+    }
