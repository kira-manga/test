+/**
+ * Thin actual-native target delivery, not a signer callback, admission shortcut or automatic
+ * enrollment workflow. Each signing/retirement call is separately explicit. Recovery methods
+ * retrieve the exact already retained signature; an unknown operation is never re-signed here.
+ * All complete-census comparisons/framing stay in the common typed prelude/native DATA codec.
+ * The root retains the target and LAN owners and must close the OLD LAN owner normally before
+ * RequireExisting opens an admitted owner. Successful local DATA sends are not remote approval.
+ */
+public class AndroidSdkEnrollmentTargetDelivery private constructor(
+    private val target: AndroidDevicePairingTarget,
+    private val peer: AndroidSdkNoisePeer,
+    private val identity: AndroidSdkNoiseIdentity,
+    private val channel: LocalSdkNativePrelude,
+) {
+    public suspend fun sendOriginalDescriptor(): AndroidDevicePairingTargetResult<LocalDevicePairingTargetDescriptor> = deliver {
+        val result = target.descriptor()
+        if (result is AndroidDevicePairingTargetResult.Value) channel.sendTargetDescriptor(result.value)
+        result
+    }
+
+    public suspend fun proveOriginalPairing(): AndroidDevicePairingTargetResult<LocalDevicePairingPossession> = deliver {
+        val request = channel.receive(LocalSdkNativePreludeKind.PAIRING_CHALLENGE) as LocalSdkNativePreludeMessage.PairingChallenge
+        val result = target.respond(request.value)
+        if (result is AndroidDevicePairingTargetResult.Value) channel.send(LocalSdkNativePreludeMessage.PairingPossession(result.value))
+        result
+    }
+
+    public suspend fun recoverOriginalPairing(originalActionId: DomainId): AndroidDevicePairingTargetResult<LocalDevicePairingPossession> = deliver {
+        val result = target.recoverPossession(originalActionId)
+        if (result is AndroidDevicePairingTargetResult.Value) channel.send(LocalSdkNativePreludeMessage.PairingPossession(result.value))
+        result
+    }
+
+    public suspend fun proveOriginalAdmission(): AndroidDevicePairingTargetResult<LocalDeviceAdmissionPossession> = deliver {
+        val request = channel.receive(LocalSdkNativePreludeKind.ADMISSION_CHALLENGE) as LocalSdkNativePreludeMessage.AdmissionChallenge
+        val result = target.proveAdmission(request.value, identity, peer)
+        if (result is AndroidDevicePairingTargetResult.Value) channel.send(LocalSdkNativePreludeMessage.AdmissionPossession(result.value))
+        result
+    }
+
+    public suspend fun recoverOriginalAdmission(originalActionId: DomainId): AndroidDevicePairingTargetResult<LocalDeviceAdmissionPossession> = deliver {
+        val result = target.recoverAdmissionPossession(originalActionId)
+        if (result is AndroidDevicePairingTargetResult.Value) channel.send(LocalSdkNativePreludeMessage.AdmissionPossession(result.value))
+        result
+    }
+
+    public suspend fun retainOriginalConsumedAdmission(): AndroidDevicePairingTargetResult<NativeLocalDeviceAdmissionAssociation> = deliver {
+        val certificate = channel.receive(LocalSdkNativePreludeKind.CONSUMED_CERTIFICATE) as LocalSdkNativePreludeMessage.ConsumedCertificate
+        val result = target.retainConsumedAdmission(certificate.value, identity, peer)
+        // Native retention may already be durable if close fails. Do not return a usable fresh
+        // transition on uncertain cleanup; explicit native readback remains the recovery path.
+        channel.close()
