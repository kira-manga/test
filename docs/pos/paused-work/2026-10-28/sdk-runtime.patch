+package com.ukkera.pos.security
+
+/** Thin final native view of the common proof; no parallel key/identity owner or public factory. */
+public class AndroidSdkNoiseIdentity private constructor(
+    private val owner: AndroidSdkLanOwner,
+    internal val commonProof: LocalSdkNoiseIdentity,
+) : LocalDeviceAdmissionNoiseIdentity() {
+    override public val association: LocalSdkNoiseAssociation get() = commonProof.association
+    public fun isCurrent(): Boolean = owner.ownsIdentity(this)
+    public fun matches(expected: LocalSdkNoiseAssociation): Boolean = isCurrent() && commonProof.matches(expected)
+    internal fun belongsTo(value: AndroidSdkLanOwner): Boolean = owner === value && isCurrent()
+    internal fun belongsToOwner(value: AndroidSdkLanOwner): Boolean = owner === value
+    override fun toString(): String = "AndroidSdkNoiseIdentity(actual native SDK view, identifiers omitted)"
+
+    internal companion object {
+        fun capture(owner: AndroidSdkLanOwner, proof: LocalSdkNoiseIdentity): AndroidSdkNoiseIdentity {
+            val proposed = AndroidSdkNoiseIdentity(owner, proof)
+            val retained = proof.retainOriginalNativeView(proposed) as? AndroidSdkNoiseIdentity
+                ?: throw LocalSdkTransportUnavailable()
+            if (retained.commonProof !== proof || !retained.belongsToOwner(owner)) throw LocalSdkTransportUnavailable()
+            return retained
+        }
+    }
+}
