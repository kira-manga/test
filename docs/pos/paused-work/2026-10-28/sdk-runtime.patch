+    private suspend fun <T> exchange(request: LocalMasterRpcRequestV1, unavailable: () -> T,
+        publish: suspend (LocalSdkScopedResponse) -> T): T {
+        var body: LocalSdkRpcBody? = null
+        var response: LocalSdkScopedResponse? = null
