+            withContext(NonCancellable) { try { channel.close() } catch (cleanup: Throwable) {
+                if (cleanup !== cancelled) cancelled.addSuppressed(cleanup)
+            } }
+            throw cancelled
+        } catch (_: Exception) {
+            withContext(NonCancellable) { try { channel.close() } catch (_: Exception) { } }
+            return AndroidDevicePairingTargetResult.Unavailable(SelfOwnedInstallationFailureV1.UNAVAILABLE)
+        }
+    }
+
+    public suspend fun close(): Unit = channel.close()
+    override fun toString(): String = "AndroidSdkEnrollmentTargetDelivery(actual native target, DATA omitted)"
+
+    public companion object {
+        public suspend fun fromActual(target: AndroidDevicePairingTarget, peer: AndroidSdkNoisePeer,
+            identity: AndroidSdkNoiseIdentity): AndroidSdkEnrollmentTargetDelivery {
+            val channel = peer.openEnrollmentPrelude(identity)
+            try {
+                require(channel.targetSide && peer.belongsTo(identity))
