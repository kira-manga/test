+    public suspend fun capture(binding: LocalSdkRpcBinding): LocalSdkRpcLifetimeCapture? = lock.withLock {
+        val before = state.value
+        if (before.closed) null else LocalSdkRpcLifetimeCapture(this, binding, before.epochs[lane(binding)] ?: 0)
+    }
+    internal fun current(capture: LocalSdkRpcLifetimeCapture): Boolean {
+        val now = state.value
+        return capture.owner === this && !now.closed && capture.epoch == (now.epochs[lane(capture.binding)] ?: 0)
+    }
+    internal suspend fun register(member: LocalSdkRpcLifetimeMember, cut: LocalSdkRpcAuthorityCut): Boolean = lock.withLock {
+        if (state.value.closed || cut.lifetimeCapture.owner !== this || !current(cut.lifetimeCapture) ||
+            cut.lifetimeCapture.binding != cut.binding || !cut.isCurrent() || member.binding != cut.binding || members.size >= 128)
+            false else members.add(member)
+    }
+    internal suspend fun unregister(member: LocalSdkRpcLifetimeMember) { lock.withLock { members.remove(member) } }
+    public suspend fun sealAllBeforeAuthorityChange(): Unit = withContext(NonCancellable) {
+        val old = lock.withLock { state.value = State(true, state.value.epochs); members.toList().also { members.clear() } }
+        sealMembers(old)
+    }
+    public suspend fun sealEmployeeLifetimesBeforeSessionChange(scope: BranchScope, actorId: DomainId): Unit = withContext(NonCancellable) {
+        val old = lock.withLock {
+            val key = "${scope.rpcScopeId()}|${actorId.value}|${LocalSdkRpcPurposes.EMPLOYEE_APPLICATION}"
+            val before = state.value
+            val epoch = before.epochs[key] ?: 0
+            // This lane withdraws every OLD employee capture, even one not registered yet. Login
+            // and rotation remain distinct original-Q purposes, never upgraded employee grants.
+            val exhausted = epoch == Long.MAX_VALUE || before.epochs.size >= 1_024 && key !in before.epochs
+            state.value = if (exhausted)
+                State(true, before.epochs) else State(before.closed, before.epochs + (key to epoch + 1))
+            members.filter { exhausted || it.binding.scopeId == scope.rpcScopeId() && it.binding.actorId == actorId.value &&
+                it.binding.purpose == LocalSdkRpcPurposes.EMPLOYEE_APPLICATION }
+                .also { members.removeAll(it.toSet()) }
+        }
+        sealMembers(old)
+    }
+    private fun lane(binding: LocalSdkRpcBinding): String = "${binding.scopeId}|${binding.actorId}|${binding.purpose}"
+    private suspend fun sealMembers(old: List<LocalSdkRpcLifetimeMember>) {
+        var failure: Throwable? = null
+        old.forEach { member -> try { member.seal() } catch (caught: Throwable) {
+            if (failure == null) failure = caught else if (failure !== caught) failure?.addSuppressed(caught)
+        } }
+        failure?.let { throw it }
+    }
+}
