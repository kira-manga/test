+public class LocalSdkScopedClient internal constructor(
+    private val peer: LocalSdkScopedPeer,
+    private val cut: LocalSdkRpcAuthorityCut,
+    private val sdk: ScopedRpcClientSession,
+    private val custody: LocalSdkRpcSecretCustody,
+) : LocalSdkRpcLifetimeMember {
+    private val responses = LocalSdkScopedResponseGate(cut, peer.nativePeer)
+    private val state = MutableStateFlow(LocalSdkRpcLifecycle.ACTIVE)
+    public val lifecycle: StateFlow<LocalSdkRpcLifecycle> = state.asStateFlow()
+    public val connectionId: DomainId get() = peer.connectionId
+    public val peerAssociation: LocalSdkNoiseAssociation get() = peer.association
+    /** DATA from the exact closed native cut, not a caller projection/digest assertion. */
+    public val originalNativeChallengeDigest: PayloadDigest? get() =
+        if (isCurrent()) cut.nativeSeal.originalChallengeDigest(cut) else null
+    /** LOCAL target descriptor is separate from the authenticated REMOTE master descriptor. */
+    public val originatingAdmission: LocalDeviceAdmission? get() = peer.nativeAssociation()?.let { association ->
+        if (association.targetSide) association.originalAdmittedDevice else null
+    }
+    override public val binding: LocalSdkRpcBinding get() = cut.binding
+    public fun isCurrent(): Boolean = !sdk.isSealed && peer.isCurrent() && cut.nativeSeal.matches(cut, peer.nativePeer) &&
+        cut.lifetimeCapture.isCurrent() && cut.isCurrent()
+
+    public fun captureRemoteAuthenticatedPeer(): LocalAuthenticatedPeer? {
+        if (!isCurrent()) return null
+        val association = peer.nativeAssociation() ?: return null
+        val admission = association.admission
+        return LocalAuthenticatedPeer(connectionId, admission.scope, admission.deviceId, admission.publicKeyIdentifier,
+            admission.publicFingerprint) { isCurrent() && association.isCurrent() && association.matches(peer.nativePeer) }
+    }
+
+    /** ONE Invoke only. Caller retains the same durable operation ID for NEW authorized lookup. */
+    public suspend fun invoke(original: LocalSdkRpcOriginalRequest, body: LocalSdkRpcBody,
+        timeoutMillis: Long = 5_000): LocalSdkScopedResponse {
+        require(timeoutMillis in 1..30_000)
+        require(original.procedureVersion == 1 && original.procedureName in PROCEDURES)
+        if (!isCurrent()) { body.destroy(); throw IllegalStateException("Local RPC unavailable") }
+        val allowance = minOf(timeoutMillis, cut.windowMillis(), 30_000)
+        if (allowance <= 0) { body.destroy(); throw IllegalStateException("Local RPC disclosure expired") }
+        // This process monotonic mark only ADDS denial. Native qualified expiry and SDK original
+        // publication commitment remain mandatory; it is not a platform qualification certificate.
+        val deadline = TimeSource.Monotonic.markNow() + allowance.milliseconds
+        val callCustody = LocalSdkRpcSecretCustody()
+        custody.retain(callCustody)
+        callCustody.retain(body)
+        var decoded: LocalSdkRpcBody? = null
+        var delivery: dev.p2pkit.rpc.ScopedRpcDelivery<LocalSdkRpcBody, LocalSdkRpcBody>? = null
+        var originalBytes: ByteArray? = null
+        var originalTransferred = false
+        try {
+            val requestBytes = body.useBytes { it.copyOf() }
+            originalBytes = requestBytes
+            val requestDigest = sdkEncodedBodyDigest(requestBytes)
+            val received = sdk.call(procedure(original.procedureName, callCustody), body,
+                ScopedRpcRequestGrant(binding.sdk(), cut.disclosureKey), timeoutMillis)
+            delivery = received
+            val reply = received.take(binding.sdk())
+            val success = when (reply) {
+                is RpcReply.Success -> reply.value
+                is RpcReply.ApplicationError -> { reply.error.destroy(); throw IllegalStateException("Local RPC unavailable") }
+            }
+            decoded = success
+            if (!isCurrent() || deadline.hasPassedNow()) throw IllegalStateException("Original local RPC context retired")
+            val owned = success.detach()
+            try {
+                return responses.lock.withLock {
+                    val size = owned.size.toLong() + requestBytes.size
+                    if (!responses.open || !isCurrent() || deadline.hasPassedNow() || responses.responses.size >= 128 ||
+                        size > 8L * 1_048_576 - responses.retainedBytes) throw IllegalStateException("Original local RPC context retired")
+                    LocalSdkScopedResponse(peer.association, binding, original, requestDigest, received.requestId.value,
+                        responses, deadline, requestBytes, owned).also {
+                        responses.responses.add(it)
+                        responses.retainedBytes += size
+                        originalTransferred = true
+                    }
+                }
+            } catch (failure: Throwable) { owned.fill(0); throw failure }
+        } finally {
+            try { withContext(NonCancellable) { delivery?.discard() } }
+            finally {
+                if (!originalTransferred) originalBytes?.fill(0)
+                decoded?.let(callCustody::release); callCustody.destroy(); custody.release(callCustody)
+            }
+        }
+    }
+
+    public suspend fun sealBeforeContextChange(): Unit = seal()
+    override public suspend fun seal(): Unit = withContext(NonCancellable) {
+        state.value = LocalSdkRpcLifecycle.SEALED
+        responses.seal()
+        try { sdk.seal() } finally { custody.destroy(); peer.retired(this@LocalSdkScopedClient) }
+    }
+    public suspend fun close(): Unit = peer.close()
+}
+
+private val PROCEDURES = listOf("local.auth.sign-in", "local.auth.refresh", "local.auth.current", "local.auth.logout",
+    "local.master.execute", "local.master.lookup", "local.master.read")
+
+private class LocalSdkRpcBodySerializer(private val custody: LocalSdkRpcSecretCustody) : KSerializer<LocalSdkRpcBody> {
+    private val bytes = ByteArraySerializer()
+    override val descriptor: SerialDescriptor = bytes.descriptor
+    override fun serialize(encoder: Encoder, value: LocalSdkRpcBody) {
+        try { value.useBytes { encoder.encodeSerializableValue(bytes, it) } } finally { custody.release(value) }
+    }
+    override fun deserialize(decoder: Decoder): LocalSdkRpcBody {
+        val value = LocalSdkRpcBody.decoded(decoder.decodeSerializableValue(bytes))
+        custody.retain(value)
+        return value
+    }
+}
+private fun procedure(name: String, custody: LocalSdkRpcSecretCustody): ScopedRpcProcedure<LocalSdkRpcBody, LocalSdkRpcBody, LocalSdkRpcBody> {
+    require(name in PROCEDURES)
+    val serializer = LocalSdkRpcBodySerializer(custody)
+    return ScopedRpcProcedure(name, 1, serializer, serializer, serializer)
+}
+private fun LocalSdkRpcBinding.sdk(): ScopedRpcBinding = ScopedRpcBinding(scopeId, actorId, applicationSessionId, purpose, projectionId)
+private fun ScopedRpcBinding.pos(): LocalSdkRpcBinding = LocalSdkRpcBinding(scopeId, actorId, applicationSessionId, purpose, projectionId)
+private fun ScopedRpcRequestContext.pos(peer: LocalSdkNoiseAssociation): LocalSdkRpcRequestContext =
+    LocalSdkRpcRequestContext(peer, binding.pos(), requestId.value, procedureName, procedureVersion, requestDigest, remainingMillis)
+private fun ScopedRpcDisclosureContext.pos(peer: LocalSdkNoiseAssociation): LocalSdkRpcDisclosureContext =
+    LocalSdkRpcDisclosureContext(request.pos(peer), grant.disclosureKey, when (phase) {
+        ScopedRpcDisclosurePhase.Request -> LocalSdkRpcDisclosurePhase.REQUEST
+        ScopedRpcDisclosurePhase.Response -> LocalSdkRpcDisclosurePhase.RESPONSE
+        ScopedRpcDisclosurePhase.Publication -> LocalSdkRpcDisclosurePhase.PUBLICATION
+    })
+public fun BranchScope.rpcScopeId(): String = "${organizationId.value}/${companyId.value}/${branchId.value}"
+
+private fun sdkEncodedBodyDigest(bytes: ByteArray): PayloadDigest {
+    require(bytes.size <= 65_536)
+    // ByteArraySerializer is a compact JSON array of SIGNED decimal bytes. Construct it in
+    // owned storage, not an immutable secret-bearing application String. The consumed SDK
+    // encoder uses precisely this serializer/compact form; alternate wire spellings deny.
+    val encoded = ByteArray(2 + bytes.size * 5)
+    var at = 0
+    encoded[at++] = '['.code.toByte()
+    bytes.forEachIndexed { index, byte ->
+        if (index != 0) encoded[at++] = ','.code.toByte()
+        var value = byte.toInt()
+        if (value < 0) { encoded[at++] = '-'.code.toByte(); value = -value }
+        if (value >= 100) encoded[at++] = ('0'.code + value / 100).toByte()
+        if (value >= 10) encoded[at++] = ('0'.code + (value / 10) % 10).toByte()
+        encoded[at++] = ('0'.code + value % 10).toByte()
+    }
+    encoded[at++] = ']'.code.toByte()
+    val used = encoded.copyOf(at)
+    return try { sha256(used) } finally { used.fill(0); encoded.fill(0) }
+}
