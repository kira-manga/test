+/**
+ * Thin final Android view/factory. It creates only the actual protected Android SDK identity and
+ * organization LAN. Common owns the single original-open guard, immutable admission/profile,
+ * reference registry, freshness, cleanup and close-before-replacement rules. No public caller kit,
+ * session, identity store, provider, accepting callback or raw sender is accepted.
+ */
+public class AndroidSdkLanOwner private constructor(private val proof: LocalSdkLanOwner) : LocalAuthenticatedPeerSource {
+    public val identity: AndroidSdkNoiseIdentity = AndroidSdkNoiseIdentity.capture(this, proof.identity)
+    /** Collect-compatible checked native views of genuine common incoming capabilities. */
+    public val incomingPeers: Flow<AndroidSdkNoisePeer> = proof.incomingPeers.map(::nativePeer)
+    public val rpcLifetimes: LocalSdkRpcLifetimeFence get() = proof.rpcLifetimes
+
+    public fun isCurrent(): Boolean = proof.isCurrent()
+    public suspend fun start(): Unit = proof.start()
+    public suspend fun connectFresh(expected: LocalSdkNoiseAssociation): AndroidSdkNoisePeer = nativePeer(proof.connectFresh(expected))
+    public fun admissionFor(peer: AndroidSdkNoisePeer): NativeLocalDeviceAdmissionAssociation? =
+        if (peer.belongsToOwner(this)) proof.admissionFor(peer.commonProof) else null
+    override public suspend fun capture(connectionId: DomainId): LocalAuthenticatedPeer? = proof.capture(connectionId)
+    public suspend fun close(): Unit = proof.close()
+
+    internal fun ownsIdentity(value: AndroidSdkNoiseIdentity): Boolean = value.belongsToOwner(this) &&
+        value.commonProof === proof.identity && value.commonProof.isOriginalNativeView(value)
+    internal fun nativePeer(value: LocalSdkNoisePeer): AndroidSdkNoisePeer {
+        if (!value.belongsTo(proof)) throw LocalSdkTransportUnavailable()
+        val original = value.originalNativeView()
+        val retained = original ?: AndroidSdkNoisePeer.capture(this, value)
+        val actual = retained as? AndroidSdkNoisePeer ?: throw LocalSdkTransportUnavailable()
+        if (actual.commonProof !== value || !actual.belongsToOwner(this)) throw LocalSdkTransportUnavailable()
+        return actual
+    }
+    override fun toString(): String = "AndroidSdkLanOwner(actual Android SDK view, identifiers omitted)"
+
+    public companion object {
+        public const val APP_ID: String = LocalSdkLanOwner.APP_ID
+
+        /** Only first enrollment creates a persistent key; quarantine pins never confer admission. */
+        public suspend fun createEnrollment(context: Context, deviceName: String, lan: OrganizationLan, role: LanRole,
+            candidates: List<LocalSdkNoiseAssociation> = emptyList()): AndroidSdkLanOwner =
+            createActual(context, deviceName, lan, role, emptyList(), candidates, LocalIdentityOpenMode.LoadOrCreate)
+
+        /** Existing consumed dual-key history MUST reopen the same existing protected SDK key. */
+        public suspend fun openAdmitted(context: Context, deviceName: String, lan: OrganizationLan, role: LanRole,
+            admissions: List<NativeLocalDeviceAdmissionAssociation>, candidates: List<LocalSdkNoiseAssociation> = emptyList()): AndroidSdkLanOwner =
+            createActual(context, deviceName, lan, role, admissions, candidates, LocalIdentityOpenMode.RequireExisting)
+
+        private suspend fun createActual(context: Context, deviceName: String, lan: OrganizationLan, role: LanRole,
+            admissions: List<NativeLocalDeviceAdmissionAssociation>, candidates: List<LocalSdkNoiseAssociation>,
+            mode: LocalIdentityOpenMode): AndroidSdkLanOwner = withContext(Dispatchers.IO) {
+            val original = LocalSdkLanOwner.reserveOriginalOpen(
+                when (role) {
+                    LanRole.Host -> LocalSdkLanDirection.ORIGINAL_HOST
+                    LanRole.DialOnly -> LocalSdkLanDirection.TARGET
+                }, admissions, candidates, mode)
+            try {
+                original.beginOriginalNativeCreation()
+                P2pKitAndroid.initialize(context.applicationContext)
+                val actual = P2pKit.create {
+                    original.configureActualKit(this)
+                    this.deviceName = deviceName
+                    transports { lan(context.applicationContext, lan, role) }
+                }
+                // No suspension between actual create return and retention of its original handle.
+                val common = original.retainActualKit(actual)
+                val opened = AndroidSdkLanOwner(common)
+                currentCoroutineContext().ensureActive()
+                opened
+            } catch (failure: Throwable) {
+                original.failAndCloseOriginal(failure)
+                throw failure
+            }
+        }
+    }
+}
