+    }
+    fun stored(): StoredBytes = StoredBytes(bytes())
+    fun mutation(): MutationRequest = MutationRequest(OperationId(text(36)), CommandKey(text(96), u16()), stored(), if (boolean()) DomainId(text(36)) else null)
+    fun read(): ReadRequest = ReadRequest(ReadKey(text(96), u16()), stored())
+    fun moment(): MonotonicMoment = MonotonicMoment(DomainId(text(36)), counter())
+    fun sessionView(): LocalSessionView {
+        val actor = DomainId(text(36))
+        val scope = BranchScope(DomainId(text(36)), DomainId(text(36)), DomainId(text(36)))
+        val device = DomainId(text(36)); val session = DomainId(text(36)); val generation = SessionGeneration(counter())
+        require(generation.value in 1 until Long.MAX_VALUE)
+        val login = LocalLoginIdentifier(text(256)); val revision = Revision(counter())
+        val policyBytes = bytes()
+        val policy = LocalEffectivePolicyCodec.decodePolicy(ProtectedLocalBinding(ProtectedLocalRecordKey.EffectivePolicy(scope, actor), revision), policyBytes)
+        val access = moment(); val work = moment()
+        require(policy.scope == scope && policy.actorId == actor && policy.revision == revision &&
+            access.bootId == work.bootId && access.elapsedMillis <= work.elapsedMillis)
+        return LocalSessionView(actor, scope, device, session, generation, login, policy, access, work)
+    }
+    fun authenticationReply(): LocalAuthenticationResult = when (u8()) {
+        1 -> {
+            val view = sessionView()
+            val access = OpaqueCredential(bytes(8_192))
+            var refresh: OpaqueCredential? = null
+            try {
+                val ownedRefresh = OpaqueCredential(bytes(8_192))
+                refresh = ownedRefresh
+                LocalAuthenticationResult.Authenticated(LocalSessionTokens(view, access, ownedRefresh))
+            } catch (failure: Throwable) { access.destroy(); refresh?.destroy(); throw failure }
+        }
+        2 -> LocalAuthenticationResult.Denied(LocalAuthenticationDenial.valueOf(text(96)))
+        3 -> LocalAuthenticationResult.Unavailable
+        4 -> LocalAuthenticationResult.StorageUncertain
