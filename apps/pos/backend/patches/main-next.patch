diff --git a/script/server/go_registry.ts b/script/server/go_registry.ts
new file mode 100644
index 0000000..2fb5466
--- /dev/null
+++ b/script/server/go_registry.ts
@@ -0,0 +1,21 @@
+// Pure registry rendering, shared by the legacy driver and the isolated probe.
+// No filesystem writes, app config imports, git commands or generator fanout.
+export const CreateGoRegistryString = (inventory: Record<string, string[]>): string => {
+  const entries: [string, string][] = [];
+  for (const dir of Object.keys(inventory).sort()) {
+    if (!/^[a-z][a-z0-9_]*$/.test(dir)) throw new Error(`Invalid Go package: ${dir}`);
+    for (const file of [...inventory[dir]].sort()) {
+      if (!file.endsWith('.go') || /_helpers?\.go$/i.test(file) || file.endsWith('_test.go')) continue;
+      const name = file.slice(0, -3);
+      if (!/^[a-z][a-z0-9_]*$/.test(name)) throw new Error(`Invalid model file: ${file}`);
+      entries.push([dir, name]);
+    }
+  }
+  const dirs = [...new Set(entries.map(([dir]) => dir))];
+  const imports = ['  "reflect"', ...dirs.map(dir => `  "go-viki/internal/document/${dir}"`)];
+  const rows = entries.map(([dir, name]) => {
+    const model = `${name}_model`.replace(/(^|_)([a-z])/g, (_, _separator, letter) => letter.toUpperCase());
+    return `  "${dir}__${name}": reflect.TypeFor[${dir}.${model}](),`;
+  });
+  return `package document\nimport (\n${imports.join('\n')}\n)\n\nvar Document = map[string]reflect.Type{\n${rows.join('\n')}\n}\n`;
+};
