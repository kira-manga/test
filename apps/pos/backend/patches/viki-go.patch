+package per_document
+
+import (
+	"context"
+	"testing"
+
+	"go-viki/internal/helpers/modelguard"
+)
+
+func TestBranchPosNeverUsesGenericTrustBypasses(t *testing.T) {
+	t.Cleanup(ResetEnforceModelAccess)
+	for _, enforce := range []bool{false, true} {
+		SetEnforceModelAccess(enforce)
+		contexts := []context.Context{
+			nil,
+			context.Background(),
+			context.WithValue(context.Background(), "server_key", "not-a-credential-test-marker"),
+			context.WithValue(context.Background(), "skip_filters", true),
+			context.WithValue(context.Background(), "user", map[string]any{"is_super_admin": true}),
+			context.WithValue(context.Background(), "app", map[string]any{"id": "test-app", "models": map[string]any{"branch_pos": "write"}}),
+		}
+		for _, ctx := range contexts {
+			for _, level := range []AccessLevel{AccessRead, AccessWrite} {
+				for _, name := range []string{"branch_pos__operation_evidence", "branch_pos__future_unknown"} {
+					err := CheckModelAccess(ctx, name, level)
+					if !modelguard.IsProtected(err) || !IsAccessDenied(err) {
+						t.Fatalf("BranchPos escaped enforcement=%v level=%v: %v", enforce, level, err)
+					}
+				}
+			}
+		}
+	}
+}
