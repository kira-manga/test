+	for _, which := range []string{"missing", "disabled", "duplicate-domain", "reverse-alias", "organization-split", "company-split", "cross-source-organization-split", "cross-source-company-split", "wrong-native-parent", "different-native-scope", "different-source", "empty-resolved-scope"} {
