diff --git a/internal/branchpos/contracts.go b/internal/branchpos/contracts.go
new file mode 100644
index 0000000..62a0e0c
--- /dev/null
+++ b/internal/branchpos/contracts.go
@@ -0,0 +1,454 @@
+// Package branchpos contains the bounded v1 central evidence-ingestion core.
+// It does not execute a sale, payment, stock command, or an authority transfer.
+// Production authentication and a proven atomic store are REQUIRED adapters;
+// no generic model API, in-memory fallback, or default route enables it.
+package branchpos
+
+import (
+	"bytes"
+	"crypto/ed25519"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"reflect"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+	"unicode/utf8"
+)
+
+const (
+	SchemaVersion   = "1"
+	MaxBatchBytes   = 256 * 1024
+	MaxBatchItems   = 64
+	MaxEffects      = 256
+	SignatureDomain = "ukkera-branch-pos:evidence:v1\n"
+)
+
+var (
+	ErrValidation   = errors.New("invalid_branch_pos_evidence")
+	ErrUnauthorized = errors.New("branch_service_not_authorized")
+	ErrUnavailable  = errors.New("branch_pos_ingestion_adapter_unavailable")
+	ErrSignature    = errors.New("invalid_branch_pos_signature")
+)
+
+// Scope contains ONLY BranchPos domain UUIDs, never legacy/native Org IDs.
+// A protected, explicitly provisioned registry must map it one-to-one to
+// NativeScope in the transaction's admission snapshot. No ingestion code may
+// hash/coerce a native string into a UUID or auto-create a missing mapping.
+type Scope struct {
+	OrganizationID string `json:"organizationId"`
+	CompanyID      string `json:"companyId"`
+	BranchID       string `json:"branchId"`
+}
+
+// NativeScope is an internal authenticated/resolved scope. These existing
+// collection identifiers remain opaque strings, even when they look like
+// ObjectIDs. This type is deliberately distinct from the wire domain Scope.
+type NativeScope struct {
+	SourceNamespace string
+	OrganizationID  string
+	CompanyID       string
+	BranchID        string
+}
+
+type Money struct {
+	Currency string `json:"currency"`
+	Minor    string `json:"minor"`
+}
+
+// Matches core/types Quantity: scaled is an exact signed int64 string; scale
+// is a bounded integer precision snapshot, NOT an amount. The authoritative
+// unit/SKU/scale relationship is checked by ResolveOrigin, not inferred here.
+type Quantity struct {
+	UnitID string `json:"unitId"`
+	Scaled string `json:"scaled"`
+	Scale  int    `json:"scale"`
+}
+
+type Effect struct {
+	EffectID   string    `json:"effectId"`
+	Kind       string    `json:"kind"`
+	ResourceID string    `json:"resourceId"`
+	Revision   string    `json:"revision"`
+	Money      *Money    `json:"money,omitempty"`
+	Quantity   *Quantity `json:"quantity,omitempty"`
+}
+
+type Result struct {
+	DocumentID string `json:"documentId"`
+	Revision   string `json:"revision"`
+}
+
+// Payload field order is part of branch-pos-json-v1 canonical bytes. This is
+// a fixed-schema ASCII contract, NOT a claim to implement generic RFC 8785.
+// New fields/kinds require a versioned reader rather than an open raw map.
+type Payload struct {
+	SchemaVersion        string   `json:"schemaVersion"`
+	DomainID             string   `json:"domainId"`
+	Scope                Scope    `json:"scope"`
+	OperationID          string   `json:"operationId"`
+	AuthorityEpoch       string   `json:"authorityEpoch"`
+	JournalSequence      string   `json:"journalSequence"`
+	OriginMasterDeviceID string   `json:"originMasterDeviceId"`
+	SigningKeyID         string   `json:"signingKeyId"`
+	AuthorityProofID     string   `json:"authorityProofId"`
+	OriginalActorID      string   `json:"originalActorId"`
+	CatalogRevision      string   `json:"catalogRevision"`
+	PolicyRevision       string   `json:"policyRevision"`
+	MasterCommittedAt    string   `json:"masterCommittedAt"`
+	Effects              []Effect `json:"effects"`
+	Result               Result   `json:"result"`
+}
+
+type Envelope struct {
+	Payload     Payload `json:"payload"`
+	ContentHash string  `json:"contentHash"`
+	Signature   string  `json:"signature"`
+}
+
+type Batch struct {
+	SchemaVersion string     `json:"schemaVersion"`
+	Envelopes     []Envelope `json:"envelopes"`
+}
+
+// Principal is supplied ONLY by a verified device/service authenticator.
+// Request JSON/headers, central-human roles and local employee sessions are
+// not principals. The atomic store rechecks current branch service admission.
+type Principal struct {
+	Kind        string
+	NativeScope NativeScope
+	DeviceID    string
+}
+
+type Disposition string
+
+const (
+	Accepted    Disposition = "accepted"
+	Quarantined Disposition = "quarantined"
+	Conflict    Disposition = "conflict"
+)
+
+type Receipt struct {
+	OperationID     string      `json:"operationId"`
+	ContentHash     string      `json:"contentHash"`
+	AuthorityEpoch  string      `json:"authorityEpoch"`
+	JournalSequence string      `json:"journalSequence"`
+	Disposition     Disposition `json:"disposition"`
+}
+
+type SequenceRange struct {
+	First string `json:"first"`
+	Last  string `json:"last"`
+}
+
+type Checkpoint struct {
+	AuthorityEpoch                    string          `json:"authorityEpoch"`
+	HighestContiguousAcceptedSequence string          `json:"highestContiguousAcceptedSequence"`
+	HighestAcceptedSequence           string          `json:"highestAcceptedSequence"`
+	MissingRanges                     []SequenceRange `json:"missingRanges"`
+}
+
+type Acknowledgement struct {
+	SchemaVersion string       `json:"schemaVersion"`
+	Scope         Scope        `json:"scope"`
+	Coverage      string       `json:"coverage"`
+	Items         []Receipt    `json:"items"`
+	Checkpoints   []Checkpoint `json:"checkpoints"`
+}
+
+// Same scalar grammar as core/types DomainId/OperationId. Whether an ID was
+// actually assigned/enrolled is an admission decision, not UUID bit guessing.
+var uuid = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var sharedID = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$`)
+var unsigned = regexp.MustCompile(`^(0|[1-9][0-9]{0,18})$`)
+var signed = regexp.MustCompile(`^(0|-?[1-9][0-9]{0,18})$`)
+
+func invalid(field string) error { return fmt.Errorf("%w: %s", ErrValidation, field) }
+
+func decimal(value string, positive bool) (int64, error) {
+	if !unsigned.MatchString(value) {
+		return 0, ErrValidation
+	}
+	n, err := strconv.ParseInt(value, 10, 64)
+	if err != nil || (positive && n == 0) {
+		return 0, ErrValidation
+	}
+	return n, nil
+}
+
+func signedDecimal(value string) (int64, error) {
+	if !signed.MatchString(value) {
+		return 0, ErrValidation
+	}
+	n, err := strconv.ParseInt(value, 10, 64)
+	if err != nil {
+		return 0, ErrValidation
+	}
+	return n, nil
+}
+
+func (s Scope) valid() bool {
+	return uuid.MatchString(s.OrganizationID) && uuid.MatchString(s.CompanyID) && uuid.MatchString(s.BranchID)
+}
+
+func (s NativeScope) valid() bool {
+	return sharedID.MatchString(s.SourceNamespace) && sharedID.MatchString(s.OrganizationID) && sharedID.MatchString(s.CompanyID) && sharedID.MatchString(s.BranchID)
+}
+
+func (p Payload) Validate() error {
+	if p.SchemaVersion != SchemaVersion || !p.Scope.valid() {
+		return invalid("schemaVersion/scope")
+	}
+	ids := []string{p.DomainID, p.OperationID, p.OriginMasterDeviceID, p.SigningKeyID, p.AuthorityProofID, p.OriginalActorID, p.Result.DocumentID}
+	for _, id := range ids {
+		if !uuid.MatchString(id) {
+			return invalid("domain identifier")
+		}
+	}
+	for _, rev := range []string{p.AuthorityEpoch, p.JournalSequence, p.CatalogRevision, p.PolicyRevision} {
+		if _, err := decimal(rev, true); err != nil {
+			return invalid("positive version/sequence")
+		}
+	}
+	if _, err := decimal(p.Result.Revision, false); err != nil {
+		return invalid("result revision")
+	}
+	if err := ValidateEvidenceV1Time(p.MasterCommittedAt); err != nil {
+		return err
+	}
+	if len(p.Effects) == 0 || len(p.Effects) > MaxEffects {
+		return invalid("effect count")
+	}
+	seen := make(map[string]bool, len(p.Effects))
+	for _, effect := range p.Effects {
+		if !uuid.MatchString(effect.EffectID) || !uuid.MatchString(effect.ResourceID) || seen[effect.EffectID] {
+			return invalid("effect identifiers")
+		}
+		seen[effect.EffectID] = true
+		if _, err := decimal(effect.Revision, false); err != nil {
+			return invalid("effect revision")
+		}
+		switch effect.Kind {
+		case "cashPosted":
+			if effect.Money == nil || effect.Quantity != nil || effect.Money.Currency != "EGP" {
+				return invalid("cash effect")
+			}
+			if n, err := signedDecimal(effect.Money.Minor); err != nil || n == 0 {
+				return invalid("minor units")
+			}
+		case "stockPosted":
+			if effect.Quantity == nil || effect.Money != nil || !uuid.MatchString(effect.Quantity.UnitID) {
+				return invalid("stock effect")
+			}
+			if n, err := signedDecimal(effect.Quantity.Scaled); err != nil || n == 0 {
+				return invalid("quantity scaled units")
+			}
+			if effect.Quantity.Scale < 0 || effect.Quantity.Scale > 6 {
+				return invalid("quantity scale")
+			}
+		default:
+			return invalid("unsupported effect kind")
+		}
+	}
+	return nil
+}
+
+// ValidateEvidenceV1Time is an EXPLICIT evidence-v1 transport bound, not the
+// full core/types UtcInstant range: years 0000..9999, UTC Z, and Kotlin Instant
+// fraction groups 0/3/6/9. Producers must admit this bound BEFORE committing a
+// locally successful operation requiring this ingestion version. Never trim,
+// normalize or reformat an already-signed timestamp to make it fit.
+func ValidateEvidenceV1Time(value string) error {
+	at, err := time.Parse(time.RFC3339Nano, value)
+	if err != nil {
+		return invalid("evidence-v1 UTC time")
+	}
+	at = at.UTC()
+	if at.Year() < 0 || at.Year() > 9999 {
+		return invalid("evidence-v1 year bound")
+	}
+	fraction := ""
+	nanos := at.Nanosecond()
+	switch {
+	case nanos == 0:
+	case nanos%1000000 == 0:
+		fraction = fmt.Sprintf(".%03d", nanos/1000000)
+	case nanos%1000 == 0:
+		fraction = fmt.Sprintf(".%06d", nanos/1000)
+	default:
+		fraction = fmt.Sprintf(".%09d", nanos)
+	}
+	if at.Format("2006-01-02T15:04:05")+fraction+"Z" != value {
+		return invalid("evidence-v1 canonical UTC time")
+	}
+	return nil
+}
+
+func CanonicalPayload(payload Payload) ([]byte, error) {
+	if err := payload.Validate(); err != nil {
+		return nil, err
+	}
+	return json.Marshal(payload)
+}
+
+func ContentHash(canonical []byte) string {
+	sum := sha256.Sum256(canonical)
+	return "sha256:" + hex.EncodeToString(sum[:])
+}
+
+func signatureMessage(canonical []byte) []byte { return append([]byte(SignatureDomain), canonical...) }
+
+func VerifySignature(key ed25519.PublicKey, canonical []byte, signature string) error {
+	sig, err := base64.StdEncoding.Strict().DecodeString(signature)
+	if err != nil || len(sig) != ed25519.SignatureSize || base64.StdEncoding.EncodeToString(sig) != signature || len(key) != ed25519.PublicKeySize {
+		return ErrSignature
+	}
+	if !ed25519.Verify(key, signatureMessage(canonical), sig) {
+		return ErrSignature
+	}
+	return nil
+}
+
+// DecodeBatch rejects duplicate/case-variant keys, unknown fields, excessive
+// nesting/body size, invalid UTF-8, number-valued scalars and trailing JSON.
+func DecodeBatch(reader io.Reader) (Batch, error) {
+	var batch Batch
+	raw, err := io.ReadAll(io.LimitReader(reader, MaxBatchBytes+1))
+	if err != nil {
+		return batch, err
+	}
+	if len(raw) > MaxBatchBytes || !utf8.Valid(raw) {
+		return batch, invalid("body encoding/size")
+	}
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	if err := checkJSONValue(decoder, 0); err != nil {
+		return batch, err
+	}
+	if _, err := decoder.Token(); err != io.EOF {
+		return batch, invalid("trailing JSON")
+	}
+	var shape any
+	decoder = json.NewDecoder(bytes.NewReader(raw))
+	decoder.UseNumber()
+	if err := decoder.Decode(&shape); err != nil {
+		return batch, invalid("JSON")
+	}
+	if err := exactShape(shape, reflect.TypeFor[Batch]()); err != nil {
+		return batch, err
+	}
+	decoder = json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&batch); err != nil {
+		return batch, invalid("typed JSON")
+	}
+	return batch, nil
+}
+
+func checkJSONValue(decoder *json.Decoder, depth int) error {
+	if depth > 24 {
+		return invalid("JSON depth")
+	}
+	token, err := decoder.Token()
+	if err != nil {
+		return invalid("JSON")
+	}
+	if delim, ok := token.(json.Delim); ok {
+		switch delim {
+		case '{':
+			seen := map[string]bool{}
+			for decoder.More() {
+				t, err := decoder.Token()
+				if err != nil {
+					return invalid("JSON key")
+				}
+				key, ok := t.(string)
+				if !ok || seen[key] {
+					return invalid("duplicate JSON key")
+				}
+				seen[key] = true
+				if err := checkJSONValue(decoder, depth+1); err != nil {
+					return err
+				}
+			}
+		case '[':
+			for decoder.More() {
+				if err := checkJSONValue(decoder, depth+1); err != nil {
+					return err
+				}
+			}
+		default:
+			return invalid("JSON delimiter")
+		}
+		if _, err := decoder.Token(); err != nil {
+			return invalid("JSON close")
+		}
+	}
+	return nil
+}
+
+func exactShape(value any, typ reflect.Type) error {
+	if typ.Kind() == reflect.Pointer {
+		if value == nil {
+			return nil
+		}
+		return exactShape(value, typ.Elem())
+	}
+	switch typ.Kind() {
+	case reflect.Struct:
+		obj, ok := value.(map[string]any)
+		if !ok {
+			return invalid("object shape")
+		}
+		fields := map[string]reflect.Type{}
+		for i := 0; i < typ.NumField(); i++ {
+			field := typ.Field(i)
+			tag := strings.Split(field.Tag.Get("json"), ",")
+			fields[tag[0]] = field.Type
+			if len(tag) == 1 {
+				if _, exists := obj[tag[0]]; !exists {
+					return invalid("missing required field")
+				}
+			}
+		}
+		for key, child := range obj {
+			ft, ok := fields[key]
+			if !ok {
+				return invalid("unknown/noncanonical field name")
+			}
+			if err := exactShape(child, ft); err != nil {
+				return err
+			}
+		}
+	case reflect.Slice:
+		list, ok := value.([]any)
+		if !ok {
+			return invalid("array shape")
+		}
+		for _, child := range list {
+			if err := exactShape(child, typ.Elem()); err != nil {
+				return err
+			}
+		}
+	case reflect.String:
+		if _, ok := value.(string); !ok {
+			return invalid("string scalar")
+		}
+	case reflect.Int:
+		// Quantity.scale is the only numeric field. Reject quoted numbers,
+		// exponent/decimal notation and negative zero rather than coercing.
+		number, ok := value.(json.Number)
+		if !ok || len(number.String()) != 1 || number.String()[0] < '0' || number.String()[0] > '6' {
+			return invalid("quantity scale integer")
+		}
+	default:
+		return invalid("unsupported JSON shape")
+	}
+	return nil
+}
diff --git a/internal/branchpos/http.go b/internal/branchpos/http.go
new file mode 100644
index 0000000..0eafb10
--- /dev/null
+++ b/internal/branchpos/http.go
@@ -0,0 +1,74 @@
+package branchpos
+
+import (
+	"encoding/json"
+	"errors"
+	"mime"
+	"net/http"
+)
+
+// IngestionPath is a candidate typed path, NOT automatically mounted in the
+// legacy Fiber service. The optional handler is exercised only in-process.
+const IngestionPath = "/api/v1/branch-pos/ingestion/v1"
+
+type Authenticator interface {
+	Authenticate(*http.Request) (Principal, error)
+}
+
+type HTTPHandler struct {
+	Authenticator Authenticator
+	Service       Service
+}
+
+func (h HTTPHandler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	w.Header().Set("Content-Type", "application/json")
+	w.Header().Set("Cache-Control", "no-store")
+	if r.URL.Path != IngestionPath {
+		writeHTTPError(w, http.StatusNotFound, "not_found")
+		return
+	}
+	if r.Method != http.MethodPost {
+		w.Header().Set("Allow", http.MethodPost)
+		writeHTTPError(w, http.StatusMethodNotAllowed, "method_not_allowed")
+		return
+	}
+	if h.Authenticator == nil || h.Service.Store == nil {
+		writeHTTPError(w, http.StatusServiceUnavailable, "not_configured")
+		return
+	}
+	principal, err := h.Authenticator.Authenticate(r)
+	if err != nil {
+		writeHTTPError(w, http.StatusUnauthorized, "unauthorized")
+		return
+	}
+	media, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil || media != "application/json" {
+		writeHTTPError(w, http.StatusUnsupportedMediaType, "json_required")
+		return
+	}
+	batch, err := DecodeBatch(r.Body)
+	if err != nil {
+		writeHTTPError(w, http.StatusBadRequest, "invalid_evidence")
+		return
+	}
+	ack, err := h.Service.Ingest(r.Context(), principal, batch)
+	if err != nil {
+		status, code := http.StatusServiceUnavailable, "commit_not_acknowledged"
+		if errors.Is(err, ErrUnauthorized) || errors.Is(err, ErrSignature) {
+			status, code = http.StatusForbidden, "forbidden"
+		}
+		if errors.Is(err, ErrValidation) {
+			status, code = http.StatusBadRequest, "invalid_evidence"
+		}
+		// Never serialize driver errors, credentials, raw payloads or stack traces.
+		writeHTTPError(w, status, code)
+		return
+	}
+	w.WriteHeader(http.StatusOK)
+	_ = json.NewEncoder(w).Encode(ack)
+}
+
+func writeHTTPError(w http.ResponseWriter, status int, code string) {
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(map[string]string{"error": code})
+}
diff --git a/internal/branchpos/ingestion.go b/internal/branchpos/ingestion.go
new file mode 100644
index 0000000..38cc441
--- /dev/null
+++ b/internal/branchpos/ingestion.go
@@ -0,0 +1,278 @@
+package branchpos
+
+import (
+	"context"
+	"crypto/ed25519"
+	"encoding/json"
+	"fmt"
+	"sort"
+)
+
+type OriginAuthorization struct {
+	PublicKey   ed25519.PublicKey
+	Disposition Disposition
+	Reason      string
+	// Resolved from the protected domain-to-native registry, NOT copied from
+	// the incoming payload or uploader. Ingest matches it to the authenticated
+	// native scope before persisting anything for this envelope.
+	NativeScope NativeScope
+}
+
+type Evidence struct {
+	Envelope  Envelope
+	Canonical []byte
+}
+
+type ProjectionJob struct {
+	Scope       Scope
+	OperationID string
+	ContentHash string
+	Destination string
+}
+
+// AtomicStore MUST serialize/transactionally constrain (branch, operationId)
+// AND (branch, epoch, sequence), retaining uniqueness across epoch changes.
+// Callback failure rolls back ALL evidence, receipts, quarantine/conflicts,
+// outbox and checkpoints. Success means confirmed durable COMMIT. Ambiguous
+// commit returns an error/no ACK and is resolved by retry under the same ID.
+// No production adapter is supplied here: a real replica-set integration test
+// and installed unique indexes are still required before enabling this path.
+type AtomicStore interface {
+	WithinTransaction(context.Context, func(Transaction) error) error
+}
+
+type Transaction interface {
+	// Must recheck current device/service enrollment, scope and revocation.
+	AuthorizeUploader(context.Context, Principal) error
+	// Must resolve the domain Scope through a provisioned one-to-one registry,
+	// reject missing/ambiguous/disabled/reparented mappings and verify the REAL
+	// native Org -> Company -> Branch hierarchy in this admission snapshot.
+	// Mapping identity is unique in BOTH directions at EVERY entity level,
+	// qualified by entity kind/source namespace, not just a unique scope triple.
+	// Disabled identities retain tombstones; historical IDs cannot be reused or
+	// pointed at different native parents. Replay takes the same admission path.
+	// All actor/resource/unit/SKU/scale/config references, signing key ownership
+	// and historic authority/proof/cutoff must match that same scope. It must
+	// neither auto-create mappings nor reinterpret native IDs as UUID/ObjectID.
+	// An epoch increment by itself never fences a writer.
+	ResolveOrigin(context.Context, Payload) (OriginAuthorization, error)
+	FindReceipt(context.Context, Scope, string) (Receipt, bool, error)
+	// Accepted AND quarantined receipts reserve their signed journal position.
+	// A different operation cannot silently replace quarantined history.
+	FindPosition(context.Context, Scope, string, string) (Receipt, bool, error)
+	PutEvidence(context.Context, Evidence) error
+	PutReceipt(context.Context, Scope, Receipt) error
+	PutProjectionJob(context.Context, ProjectionJob) error
+	PutQuarantine(context.Context, Evidence, string) error
+	PutConflict(context.Context, Evidence, string) error
+	// Computes only contiguous ACCEPTED evidence (never quarantine/max seen),
+	// persisting the checkpoint atomically with all preceding inserts.
+	Checkpoint(context.Context, Scope, string) (Checkpoint, error)
+}
+
+type Service struct{ Store AtomicStore }
+
+func (s Service) Ingest(ctx context.Context, principal Principal, batch Batch) (*Acknowledgement, error) {
+	if s.Store == nil {
+		return nil, ErrUnavailable
+	}
+	if principal.Kind != "branch-service" || !principal.NativeScope.valid() || !uuid.MatchString(principal.DeviceID) {
+		return nil, ErrUnauthorized
+	}
+	if batch.SchemaVersion != SchemaVersion || len(batch.Envelopes) == 0 || len(batch.Envelopes) > MaxBatchItems {
+		return nil, invalid("batch version/count")
+	}
+	raw, err := json.Marshal(batch)
+	if err != nil || len(raw) > MaxBatchBytes {
+		return nil, invalid("batch bytes")
+	}
+	evidence := make([]Evidence, len(batch.Envelopes))
+	domainScope := batch.Envelopes[0].Payload.Scope
+	for i, envelope := range batch.Envelopes {
+		if envelope.Payload.Scope != domainScope {
+			return nil, ErrUnauthorized
+		}
+		canonical, err := CanonicalPayload(envelope.Payload)
+		if err != nil {
+			return nil, err
+		}
+		if ContentHash(canonical) != envelope.ContentHash {
+			return nil, invalid("content hash")
+		}
+		evidence[i] = Evidence{Envelope: envelope, Canonical: canonical}
+	}
+
+	var acknowledged *Acknowledgement
+	err = s.Store.WithinTransaction(ctx, func(tx Transaction) error {
+		if tx == nil {
+			return ErrUnavailable
+		}
+		if err := tx.AuthorizeUploader(ctx, principal); err != nil {
+			return err
+		}
+		// The callback may be retried by a Mongo transaction driver. Never
+		// accumulate response items across callback attempts.
+		ack := &Acknowledgement{SchemaVersion: SchemaVersion, Scope: domainScope, Coverage: "central-accepted-evidence-only", Items: []Receipt{}, Checkpoints: []Checkpoint{}}
+		epochs := map[string]bool{}
+		for _, item := range evidence {
+			p := item.Envelope.Payload
+			origin, err := tx.ResolveOrigin(ctx, p)
+			if err != nil {
+				return err
+			}
+			if !origin.NativeScope.valid() || origin.NativeScope != principal.NativeScope {
+				return ErrUnauthorized
+			}
+			if origin.Disposition != Accepted && origin.Disposition != Quarantined {
+				return ErrUnauthorized
+			}
+			if origin.Disposition == Quarantined && origin.Reason == "" {
+				return ErrUnauthorized
+			}
+			if err := VerifySignature(origin.PublicKey, item.Canonical, item.Envelope.Signature); err != nil {
+				return err
+			}
+			epochs[p.AuthorityEpoch] = true
+			receipt := Receipt{OperationID: p.OperationID, ContentHash: item.Envelope.ContentHash, AuthorityEpoch: p.AuthorityEpoch, JournalSequence: p.JournalSequence, Disposition: origin.Disposition}
+			existing, found, err := tx.FindReceipt(ctx, p.Scope, p.OperationID)
+			if err != nil {
+				return err
+			}
+			if found {
+				if existing.ContentHash == receipt.ContentHash {
+					ack.Items = append(ack.Items, existing)
+					continue
+				}
+				if err := tx.PutConflict(ctx, item, "operation_identity_content_mismatch"); err != nil {
+					return err
+				}
+				receipt.Disposition = Conflict
+				ack.Items = append(ack.Items, receipt)
+				continue
+			}
+			position, occupied, err := tx.FindPosition(ctx, p.Scope, p.AuthorityEpoch, p.JournalSequence)
+			if err != nil {
+				return err
+			}
+			if occupied && (position.OperationID != p.OperationID || position.ContentHash != receipt.ContentHash) {
+				if err := tx.PutConflict(ctx, item, "journal_position_content_mismatch"); err != nil {
+					return err
+				}
+				receipt.Disposition = Conflict
+				ack.Items = append(ack.Items, receipt)
+				continue
+			}
+			if receipt.Disposition == Quarantined {
+				if err := tx.PutQuarantine(ctx, item, origin.Reason); err != nil {
+					return err
+				}
+			} else {
+				if err := tx.PutEvidence(ctx, item); err != nil {
+					return err
+				}
+				if err := tx.PutProjectionJob(ctx, ProjectionJob{Scope: p.Scope, OperationID: p.OperationID, ContentHash: receipt.ContentHash, Destination: "central-reporting.v1"}); err != nil {
+					return err
+				}
+			}
+			if err := tx.PutReceipt(ctx, p.Scope, receipt); err != nil {
+				return err
+			}
+			ack.Items = append(ack.Items, receipt)
+		}
+		ordered := make([]string, 0, len(epochs))
+		for epoch := range epochs {
+			ordered = append(ordered, epoch)
+		}
+		sort.Slice(ordered, func(i, j int) bool {
+			a, _ := decimal(ordered[i], true)
+			b, _ := decimal(ordered[j], true)
+			return a < b
+		})
+		for _, epoch := range ordered {
+			checkpoint, err := tx.Checkpoint(ctx, domainScope, epoch)
+			if err != nil {
+				return err
+			}
+			if err := validateCheckpoint(epoch, checkpoint); err != nil {
+				return err
+			}
+			ack.Checkpoints = append(ack.Checkpoints, checkpoint)
+		}
+		acknowledged = ack
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	} // including uncertain commit: never ACK
+	if acknowledged == nil {
+		return nil, ErrUnavailable
+	}
+	return acknowledged, nil
+}
+
+func validateCheckpoint(epoch string, cp Checkpoint) error {
+	low, e1 := decimal(cp.HighestContiguousAcceptedSequence, false)
+	high, e2 := decimal(cp.HighestAcceptedSequence, false)
+	if cp.AuthorityEpoch != epoch || e1 != nil || e2 != nil || low > high || cp.MissingRanges == nil {
+		return invalid("checkpoint")
+	}
+	previous := low
+	for _, gap := range cp.MissingRanges {
+		first, e1 := decimal(gap.First, true)
+		last, e2 := decimal(gap.Last, true)
+		if e1 != nil || e2 != nil || first <= previous || last < first || last >= high {
+			return invalid("checkpoint gaps")
+		}
+		previous = last
+	}
+	if (low == high) != (len(cp.MissingRanges) == 0) {
+		return invalid("checkpoint coverage")
+	}
+	if low != high {
+		first, _ := decimal(cp.MissingRanges[0].First, true)
+		if first != low+1 {
+			return invalid("checkpoint first gap")
+		}
+	}
+	return nil
+}
+
+// ComputeCheckpoint is a deterministic reference calculation over a bounded
+// authoritative set, not a database scanner. previous is a VERIFIED contiguous
+// cut. Real adapters may use indexed contiguous-range tracking; never pass a
+// client claimed cut, last batch maximum, or quarantined positions here.
+func ComputeCheckpoint(epoch, previous string, accepted []string) (Checkpoint, error) {
+	if _, err := decimal(epoch, true); err != nil {
+		return Checkpoint{}, invalid("checkpoint epoch")
+	}
+	cut, err := decimal(previous, false)
+	if err != nil || len(accepted) > 4096 {
+		return Checkpoint{}, invalid("checkpoint inputs")
+	}
+	values := make([]int64, 0, len(accepted))
+	for _, value := range accepted {
+		n, err := decimal(value, true)
+		if err != nil {
+			return Checkpoint{}, invalid("checkpoint sequence")
+		}
+		if n > cut {
+			values = append(values, n)
+		}
+	}
+	sort.Slice(values, func(i, j int) bool { return values[i] < values[j] })
+	cp := Checkpoint{AuthorityEpoch: epoch, HighestContiguousAcceptedSequence: previous, HighestAcceptedSequence: previous, MissingRanges: []SequenceRange{}}
+	last, contiguous := cut, cut
+	for _, value := range values {
+		if value == last {
+			continue
+		}
+		if value-last > 1 {
+			cp.MissingRanges = append(cp.MissingRanges, SequenceRange{First: fmt.Sprint(last + 1), Last: fmt.Sprint(value - 1)})
+		} else if contiguous == last {
+			contiguous = value
+		}
+		last = value
+	}
+	cp.HighestContiguousAcceptedSequence, cp.HighestAcceptedSequence = fmt.Sprint(contiguous), fmt.Sprint(last)
+	return cp, validateCheckpoint(epoch, cp)
+}
diff --git a/internal/branchpos/ingestion_test.go b/internal/branchpos/ingestion_test.go
new file mode 100644
index 0000000..3691a75
--- /dev/null
+++ b/internal/branchpos/ingestion_test.go
@@ -0,0 +1,751 @@
+package branchpos
+
+import (
+	"bytes"
+	"context"
+	"crypto/ed25519"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"maps"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"sync"
+	"testing"
+)
+
+// This copy-on-write fake is a TEST oracle for service orchestration. It is
+// intentionally not exported or available to a server; passing these tests
+// is not Mongo durability/transaction/tenant/recovery acceptance.
+type memoryState struct {
+	receipts    map[string]Receipt
+	evidence    map[string]Evidence
+	jobs        map[string]ProjectionJob
+	quarantine  map[string]Evidence
+	conflicts   map[string]Evidence
+	checkpoints map[string]Checkpoint
+}
+
+func newState() memoryState {
+	return memoryState{map[string]Receipt{}, map[string]Evidence{}, map[string]ProjectionJob{}, map[string]Evidence{}, map[string]Evidence{}, map[string]Checkpoint{}}
+}
+func (s memoryState) copy() memoryState {
+	return memoryState{maps.Clone(s.receipts), maps.Clone(s.evidence), maps.Clone(s.jobs), maps.Clone(s.quarantine), maps.Clone(s.conflicts), maps.Clone(s.checkpoints)}
+}
+
+type memoryStore struct {
+	mu                 sync.Mutex
+	state              memoryState
+	failAt             string
+	dropAfterCommit    bool
+	retryCallback      bool
+	quarantineSequence string
+	revoked            bool
+	// Explicit TEST registry fixtures, not a production mapping adapter.
+	mappings           []fixtureMapping
+	badNativeHierarchy bool
+	resolvedOverride   *NativeScope
+}
+
+type fixtureMapping struct {
+	domain Scope
+	native NativeScope
+	active bool
+}
+
+var interrupted = errors.New("test crash/ambiguous commit")
+var testScope = Scope{id(11), id(12), id(13)}
+var testNativeScope = NativeScope{"test-source", "org-a", "company-a", "branch-a"}
+
+func id(n int) string             { return fmt.Sprintf("00000000-0000-4000-8000-%012x", n) }
+func testKey() ed25519.PrivateKey { return ed25519.NewKeyFromSeed(bytes.Repeat([]byte{0x24}, 32)) }
+func principal() Principal {
+	return Principal{Kind: "branch-service", NativeScope: testNativeScope, DeviceID: id(41)}
+}
+func newStore() *memoryStore {
+	return &memoryStore{state: newState(), mappings: []fixtureMapping{{testScope, testNativeScope, true}}}
+}
+func scopeKey(s Scope) string {
+	return s.OrganizationID + "\x00" + s.CompanyID + "\x00" + s.BranchID + "\x00"
+}
+func opKey(s Scope, op string) string { return scopeKey(s) + op }
+
+func payload(n int, seq string) Payload {
+	return Payload{
+		SchemaVersion: "1", DomainID: id(100 + n), Scope: testScope, OperationID: id(200 + n),
+		AuthorityEpoch: "1", JournalSequence: seq, OriginMasterDeviceID: id(42), SigningKeyID: id(43), AuthorityProofID: id(44), OriginalActorID: id(45),
+		CatalogRevision: "9007199254740993", PolicyRevision: "1", MasterCommittedAt: "2026-10-23T10:20:30.100Z",
+		Effects: []Effect{
+			{EffectID: id(300 + n), Kind: "cashPosted", ResourceID: id(65), Revision: "9223372036854775807", Money: &Money{"EGP", "9007199254740993"}},
+			{EffectID: id(400 + n), Kind: "stockPosted", ResourceID: id(66), Revision: "1", Quantity: &Quantity{id(67), "-1234567", 6}},
+		}, Result: Result{DocumentID: id(500 + n), Revision: "9223372036854775807"},
+	}
+}
+
+func signPayload(t *testing.T, p Payload) Envelope {
+	t.Helper()
+	canonical, err := CanonicalPayload(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return Envelope{p, ContentHash(canonical), base64.StdEncoding.EncodeToString(ed25519.Sign(testKey(), signatureMessage(canonical)))}
+}
+func batch(envelopes ...Envelope) Batch { return Batch{SchemaVersion: "1", Envelopes: envelopes} }
+
+func (s *memoryStore) WithinTransaction(ctx context.Context, fn func(Transaction) error) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	staged := s.state.copy()
+	if err := fn(&memoryTx{s, &staged}); err != nil {
+		return err
+	}
+	if s.retryCallback {
+		staged = s.state.copy()
+		if err := fn(&memoryTx{s, &staged}); err != nil {
+			return err
+		}
+	}
+	s.state = staged
+	if s.dropAfterCommit {
+		s.dropAfterCommit = false
+		return interrupted
+	}
+	return nil
+}
+
+type memoryTx struct {
+	store *memoryStore
+	state *memoryState
+}
+
+func (tx *memoryTx) step(name string) error {
+	if tx.store.failAt == name {
+		return interrupted
+	}
+	return nil
+}
+func (tx *memoryTx) AuthorizeUploader(_ context.Context, p Principal) error {
+	if tx.store.revoked || p.NativeScope != testNativeScope || p.DeviceID != id(41) {
+		return ErrUnauthorized
+	}
+	return nil
+}
+
+// A bounded fixture oracle for the REQUIRED adapter contract. The real store
+// must implement this using protected entity mappings, native parent reads and
+// installed indexes in one transaction; this test code cannot enable a route.
+func (tx *memoryTx) fixtureResolveScope(domain Scope) (NativeScope, error) {
+	var found *fixtureMapping
+	for i := range tx.store.mappings {
+		m := &tx.store.mappings[i]
+		if m.domain == domain {
+			if found != nil || !m.active {
+				return NativeScope{}, ErrUnauthorized
+			}
+			found = m
+		}
+	}
+	if found == nil || tx.store.badNativeHierarchy {
+		return NativeScope{}, ErrUnauthorized
+	}
+	// A unique full triple is insufficient: each domain org/company/branch
+	// must retain its own native identity and parent in both directions.
+	pairs := func(m fixtureMapping) [][2]string {
+		return [][2]string{
+			{m.domain.OrganizationID, m.native.SourceNamespace + "\x00organization\x00" + m.native.OrganizationID},
+			{m.domain.CompanyID, m.native.SourceNamespace + "\x00company\x00" + m.native.CompanyID},
+			{m.domain.BranchID, m.native.SourceNamespace + "\x00branch\x00" + m.native.BranchID},
+		}
+	}
+	for _, other := range tx.store.mappings {
+		left, right := pairs(*found), pairs(other)
+		for i := range left {
+			if (left[i][0] == right[i][0]) != (left[i][1] == right[i][1]) {
+				return NativeScope{}, ErrUnauthorized
+			}
+			if i > 0 && left[i][0] == right[i][0] && left[i-1] != right[i-1] {
+				return NativeScope{}, ErrUnauthorized
+			}
+		}
+	}
+	if tx.store.resolvedOverride != nil {
+		return *tx.store.resolvedOverride, nil
+	}
+	return found.native, nil
+}
+
+func (tx *memoryTx) ResolveOrigin(_ context.Context, p Payload) (OriginAuthorization, error) {
+	native, err := tx.fixtureResolveScope(p.Scope)
+	if err != nil {
+		return OriginAuthorization{}, err
+	}
+	if p.SigningKeyID != id(43) || p.OriginMasterDeviceID != id(42) || p.AuthorityProofID != id(44) || p.OriginalActorID != id(45) || p.CatalogRevision != "9007199254740993" || p.PolicyRevision != "1" {
+		return OriginAuthorization{}, ErrUnauthorized
+	}
+	for _, e := range p.Effects {
+		if e.ResourceID != id(65) && e.ResourceID != id(66) {
+			return OriginAuthorization{}, ErrUnauthorized
+		}
+		if e.Quantity != nil && (e.Quantity.UnitID != id(67) || e.Quantity.Scale != 6) {
+			return OriginAuthorization{}, ErrUnauthorized
+		}
+	}
+	origin := OriginAuthorization{PublicKey: testKey().Public().(ed25519.PublicKey), Disposition: Accepted, NativeScope: native}
+	if p.JournalSequence == tx.store.quarantineSequence {
+		origin.Disposition = Quarantined
+		origin.Reason = "retired_authority_cut"
+	}
+	return origin, nil
+}
+func (tx *memoryTx) FindReceipt(_ context.Context, scope Scope, operation string) (Receipt, bool, error) {
+	r, found := tx.state.receipts[opKey(scope, operation)]
+	return r, found, nil
+}
+func (tx *memoryTx) FindPosition(_ context.Context, scope Scope, epoch, sequence string) (Receipt, bool, error) {
+	for key, r := range tx.state.receipts {
+		if strings.HasPrefix(key, scopeKey(scope)) && r.AuthorityEpoch == epoch && r.JournalSequence == sequence {
+			return r, true, nil
+		}
+	}
+	return Receipt{}, false, nil
+}
+func (tx *memoryTx) PutEvidence(_ context.Context, e Evidence) error {
+	tx.state.evidence[opKey(e.Envelope.Payload.Scope, e.Envelope.Payload.OperationID)] = e
+	return tx.step("evidence")
+}
+func (tx *memoryTx) PutReceipt(_ context.Context, scope Scope, receipt Receipt) error {
+	key := opKey(scope, receipt.OperationID)
+	if _, exists := tx.state.receipts[key]; exists {
+		return errors.New("duplicate test receipt")
+	}
+	tx.state.receipts[key] = receipt
+	return tx.step("receipt")
+}
+func (tx *memoryTx) PutProjectionJob(_ context.Context, job ProjectionJob) error {
+	tx.state.jobs[opKey(job.Scope, job.OperationID)+job.Destination] = job
+	return tx.step("outbox")
+}
+func (tx *memoryTx) PutQuarantine(_ context.Context, e Evidence, _ string) error {
+	tx.state.quarantine[opKey(e.Envelope.Payload.Scope, e.Envelope.Payload.OperationID)] = e
+	return tx.step("quarantine")
+}
+func (tx *memoryTx) PutConflict(_ context.Context, e Evidence, _ string) error {
+	tx.state.conflicts[opKey(e.Envelope.Payload.Scope, e.Envelope.Payload.OperationID)+e.Envelope.ContentHash] = e
+	return tx.step("conflict")
+}
+func (tx *memoryTx) Checkpoint(_ context.Context, scope Scope, epoch string) (Checkpoint, error) {
+	sequences := []string{}
+	for key, r := range tx.state.receipts {
+		if strings.HasPrefix(key, scopeKey(scope)) && r.AuthorityEpoch == epoch && r.Disposition == Accepted {
+			sequences = append(sequences, r.JournalSequence)
+		}
+	}
+	cp, err := ComputeCheckpoint(epoch, "0", sequences)
+	if err != nil {
+		return cp, err
+	}
+	tx.state.checkpoints[scopeKey(scope)+epoch] = cp
+	return cp, tx.step("checkpoint")
+}
+
+func TestAtomicEvidenceReceiptOutboxAndLostReply(t *testing.T) {
+	store := newStore()
+	service := Service{Store: store}
+	envelope := signPayload(t, payload(1, "1"))
+	store.dropAfterCommit = true
+	ack, err := service.Ingest(context.Background(), principal(), batch(envelope))
