+	before := store.state.copy()
+	store.mappings[0].active = false
+	ack, err = service.Ingest(context.Background(), principal(), request)
+	if ack != nil || !errors.Is(err, ErrUnauthorized) || !reflect.DeepEqual(store.state, before) {
+		t.Fatal("replay bypassed current mapping admission", ack, err)
+	}
