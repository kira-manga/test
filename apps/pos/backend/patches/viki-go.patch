+				store.mappings = append(store.mappings, fixtureMapping{Scope{id(21), id(22), id(23)}, testNativeScope, true})
+			case "organization-split", "company-split":
+				other := fixtureMapping{Scope{testScope.OrganizationID, testScope.CompanyID, id(23)}, NativeScope{"test-source", "other-org", "other-company", "other-branch"}, true}
+				if which == "company-split" {
+					other.native.OrganizationID = testNativeScope.OrganizationID
+				} else {
+					other.domain.CompanyID = id(22)
+				}
+				store.mappings = append(store.mappings, other)
+			case "cross-source-organization-split", "cross-source-company-split":
+				other := fixtureMapping{Scope{testScope.OrganizationID, id(22), id(23)}, testNativeScope, true}
+				other.native.SourceNamespace = "another-environment"
+				if which == "cross-source-company-split" {
