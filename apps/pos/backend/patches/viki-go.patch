+		bytes.Replace(raw, []byte(`"schemaVersion"`), []byte(`"SchemaVersion"`), 1),
+		bytes.Replace(raw, []byte(`"minor":"9007199254740993"`), []byte(`"minor":9007199254740993`), 1),
+		bytes.Replace(raw, []byte(`"scale":6`), []byte(`"scale":"6"`), 1),
+		bytes.Replace(raw, []byte(`"scale":6`), []byte(`"scale":6.0`), 1),
+		bytes.Replace(raw, []byte(`"scale":6`), []byte(`"scale":6e0`), 1),
+		bytes.Replace(raw, []byte(`"scale":6`), []byte(`"scale":-0`), 1),
+		bytes.Replace(raw, []byte(`,"scale":6`), nil, 1),
+		bytes.Replace(raw, []byte(`"unitId":"`+id(67)+`",`), nil, 1),
+		append(append([]byte{}, raw...), []byte(` {}`)...),
+		[]byte(`{"schemaVersion":"1","envelopes":null}`),
+		[]byte(`{"schemaVersion":"1","envelopes":[],"extra":true}`),
+		bytes.Repeat([]byte{' '}, MaxBatchBytes+1),
+	} {
+		if _, err := DecodeBatch(bytes.NewReader(bad)); err == nil {
+			t.Fatal("invalid JSON accepted")
+		}
