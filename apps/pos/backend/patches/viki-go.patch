+package db_functions_test
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	"go-viki/internal/document"
+	"go-viki/internal/helpers/db_functions"
+	"go-viki/internal/helpers/modelguard"
+	"go-viki/types"
+)
+
+func TestBranchPosGenericPrimitivesBeforeAnyDatabase(t *testing.T) {
+	const module = "branch_pos__operation_evidence"
+	ctx := context.WithValue(context.Background(), "server_key", true)
+	// Prove protection even if a future registry includes the name, not merely
+	// because current runtime configuration has not been installed.
+	previous, existed := document.Document[module]
+	document.Document[module] = reflect.TypeFor[struct{}]()
+	t.Cleanup(func() {
+		if existed {
+			document.Document[module] = previous
+		} else {
+			delete(document.Document, module)
+		}
+	})
+	if _, _, ok := db_functions.GetModel(module); ok {
+		t.Fatal("raw generic registry lookup exposed protected model")
+	}
+	for name, fn := range map[string]func() error{
+		"count":  func() error { _, err := db_functions.CountModelWithFilter(ctx, module, types.D{}); return err },
+		"bulk":   func() error { _, _, err := db_functions.BulkWrite(ctx, module, nil); return err },
+		"delete": func() error { _, err := db_functions.DeleteModelWithFilter(ctx, module, types.D{}); return err },
+		"update": func() error {
+			_, err := db_functions.UpdateModelWithFilter(ctx, module, types.D{}, types.D{})
+			return err
+		},
+		"aggregate": func() error { _, err := db_functions.AggregateModelWithFilter(ctx, module, []any{}); return err },
+		"cross_aggregate": func() error {
+			_, err := db_functions.AggregateModelWithFilter(ctx, "org__company", []any{map[string]any{"$merge": module}})
+			return err
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if !modelguard.IsProtected(fn()) {
+				t.Fatal("generic primitive did not deny protected target")
+			}
+		})
+	}
+}
diff --git a/internal/helpers/modelguard/configured/check.go b/internal/helpers/modelguard/configured/check.go
new file mode 100644
index 0000000..950dad2
--- /dev/null
+++ b/internal/helpers/modelguard/configured/check.go
@@ -0,0 +1,30 @@
+// Package configured connects namespace-only target validation to the real
+// runtime relation metadata. It does not call Mongo or load configuration.
+package configured
+
+import (
+	"go-viki/internal/config/models_config"
+	"go-viki/internal/helpers/modelguard"
+)
+
+func Relations(model string) map[string]string {
+	refs := map[string]string{}
+	for field, cfg := range models_config.ModuleConfigs[model].Fields {
+		if cfg.Model != "" {
+			refs[field] = cfg.Model
+		}
+	}
+	return refs
+}
+
+func Writes(models any) error { return modelguard.CheckWrites(models, Relations) }
+
+func Envelope(body map[string]any) error {
+	if err := modelguard.CheckSync(body["settings"]); err != nil {
+		return err
+	}
+	if body["data"] == nil {
+		return nil
+	}
+	return Writes(body["data"])
+}
diff --git a/internal/helpers/modelguard/guard.go b/internal/helpers/modelguard/guard.go
new file mode 100644
index 0000000..8e5548c
--- /dev/null
+++ b/internal/helpers/modelguard/guard.go
@@ -0,0 +1,367 @@
+// Package modelguard reserves BranchPos for separately authorized typed paths.
+// These checks deliberately do not inspect credentials, app grants, server keys,
+// or environment flags. None of those can enable generic BranchPos access.
+package modelguard
+
+import (
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+)
+
+const (
+	MaxDepth   = 32
+	MaxTargets = 4096
+)
+
+var ErrBounds = errors.New("generic model target preflight limit exceeded")
+var ErrShape = errors.New("invalid generic model target shape")
+
+type ProtectedNamespaceError struct{}
+
+func (*ProtectedNamespaceError) Error() string {
+	return "branch_pos generic access is disabled; use an authorized typed contract"
+}
+
+func IsProtected(err error) bool {
+	var target *ProtectedNamespaceError
+	return errors.As(err, &target)
+}
+
+// Reserved includes unknown future models and the schema/group aliases. A
+// namespace boundary is required: branch_position and other ordinary data are
+// not BranchPos models. Canonical runtime collection names are branch_pos__*.
+func Reserved(name string) bool {
+	name = strings.ToLower(strings.TrimSpace(name))
+	return name == "branchpos" || name == "branch_pos" ||
+		strings.HasPrefix(name, "branch_pos__") ||
+		strings.HasPrefix(name, "branchpos__") ||
+		strings.HasPrefix(name, "branchpos\\")
+}
+
+func CheckModel(name string) error {
+	if Reserved(name) {
+		return &ProtectedNamespaceError{}
+	}
+	return nil
+}
+
+// Relations returns the configured collection target for each actual relation
+// field. It must not infer targets from untrusted field values or raw JSON.
+type Relations func(model string) map[string]string
+
+type check struct{ targets int }
+
+func (c *check) step(depth int) error {
+	c.targets++
+	if depth > MaxDepth || c.targets > MaxTargets {
+		return ErrBounds
+	}
+	return nil
+}
+
+// CheckWrites walks authoritative model-map keys and configured cascade fields
+// only. Preflight the WHOLE batch before executing any item or file upload.
+// Text such as {note: "branch_pos__operation_evidence"} remains ordinary data.
+func CheckWrites(models any, relations Relations) error {
+	c := &check{}
+	return c.modelMap(models, relations, 0, false)
+}
+
+// CheckQueries additionally examines include model keys. It never treats a
+// filter value or a projected/raw business string as a collection name.
+func CheckQueries(models any) error {
+	c := &check{}
+	return c.modelMap(models, nil, 0, true)
+}
+
+func (c *check) modelMap(models any, relations Relations, depth int, query bool) error {
+	if err := c.step(depth); err != nil {
+		return err
+	}
+	m, ok := object(models)
+	if !ok {
+		return ErrShape
+	}
+	// First inspect all outer targets; no caller can depend on map ordering.
+	for model := range m {
+		if err := CheckModel(model); err != nil {
+			return err
+		}
+	}
+	for model, items := range m {
+		if query {
+			if items == nil {
+				continue // legacy empty options contain no secondary target
+			}
+			opts, ok := object(items)
+			if !ok {
+				// In particular, do not silently skip an oversized/duplicate
+				// options object that still has include/aggregate selectors.
+				return ErrShape
+			}
+			if inc, exists := opts["include"]; exists {
+				if err := c.modelMap(inc, nil, depth+1, true); err != nil {
+					return err
+				}
+			}
+			if pipeline, exists := opts["aggregate"]; exists {
+				if err := c.pipeline(pipeline, depth+1); err != nil {
+					return err
+				}
+			}
+		} else if err := c.document(model, items, relations, depth+1); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *check) document(model string, value any, relations Relations, depth int) error {
+	if err := c.step(depth); err != nil {
+		return err
+	}
+	if err := CheckModel(model); err != nil {
+		return err
+	}
+	r := reflect.ValueOf(value)
+	if r.IsValid() && (r.Kind() == reflect.Slice || r.Kind() == reflect.Array || r.Kind() == reflect.Map) && r.Len() > MaxTargets {
+		return ErrBounds
+	}
+	if list, ok := array(value); ok {
+		for _, item := range list {
+			if err := c.document(model, item, relations, depth+1); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	data, ok := object(value)
+	if !ok || relations == nil {
+		return nil
+	}
+	for field, target := range relations(model) {
+		child, exists := data[field]
+		if !exists {
+			continue
+		}
+		// A plain related ID is a target too, not permission to cross scope.
+		if err := CheckModel(target); err != nil {
+			return err
+		}
+		if err := c.document(target, child, relations, depth+1); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// CheckSync examines only settings.sync.mutations[].module. Mutation data is
+// separately checked by CheckWrites. No receipt/sequence may be consumed first.
+func CheckSync(settings any) error {
+	if settings == nil {
+		return nil
+	}
+	s, ok := object(settings)
+	if !ok {
+		return ErrShape
+	}
+	if s["sync"] == nil {
+		return nil
+	}
+	sy, ok := object(s["sync"])
+	if !ok {
+		return ErrShape
+	}
+	r := reflect.ValueOf(sy["mutations"])
+	if r.IsValid() && (r.Kind() == reflect.Slice || r.Kind() == reflect.Array) && r.Len() > MaxTargets {
+		return ErrBounds
+	}
+	mutations, ok := array(sy["mutations"])
+	if !ok {
+		return nil
+	} // existing protocol validator diagnoses other shapes
+	if len(mutations) > MaxTargets {
+		return ErrBounds
+	}
+	for _, item := range mutations {
+		m, ok := object(item)
+		if !ok {
+			return ErrShape
+		}
+		target, ok := m["module"].(string)
+		if !ok {
+			return ErrShape
+		}
+		if err := CheckModel(target); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// CheckPipeline inspects collection selectors in actual aggregation stages,
+// including nested $facet/$lookup/$unionWith pipelines and write destinations.
+// Other stage expressions ($literal, $match data, ordinary strings) are data.
+func CheckPipeline(pipeline any) error { return (&check{}).pipeline(pipeline, 0) }
+
+func (c *check) pipeline(pipeline any, depth int) error {
+	if err := c.step(depth); err != nil {
+		return err
+	}
+	stages, ok := array(pipeline)
+	if !ok {
+		return ErrShape
+	}
+	for _, raw := range stages {
+		if err := c.step(depth + 1); err != nil {
+			return err
+		}
+		stage, ok := object(raw)
+		if !ok || len(stage) != 1 {
+			return ErrShape
+		}
+		for op, value := range stage {
+			switch op {
+			case "$changeStream", "$currentOp", "$listLocalSessions", "$listSessions", "$listSampledQueries":
+				// These can inspect a database/cluster rather than this checked
+				// collection. A generic grant cannot expose a reserved namespace.
+				return fmt.Errorf("%w: database-wide aggregation stage", ErrShape)
+			case "$lookup", "$graphLookup":
+				args, ok := object(value)
+				if !ok {
+					return ErrShape
+				}
+				if from, exists := args["from"]; exists {
+					if err := collection(from); err != nil {
+						return err
+					}
+				}
+				if inner, exists := args["pipeline"]; exists {
+					if err := c.pipeline(inner, depth+1); err != nil {
+						return err
+					}
+				}
+			case "$unionWith":
+				if name, ok := value.(string); ok {
+					if err := CheckModel(name); err != nil {
+						return err
+					}
+					continue
+				}
+				args, ok := object(value)
+				if !ok {
+					return ErrShape
+				}
+				if coll, exists := args["coll"]; exists {
+					if err := collection(coll); err != nil {
+						return err
+					}
+				}
+				if inner, exists := args["pipeline"]; exists {
+					if err := c.pipeline(inner, depth+1); err != nil {
+						return err
+					}
+				}
+			case "$out":
+				if err := collection(value); err != nil {
+					return err
+				}
+			case "$merge":
+				if name, ok := value.(string); ok {
+					if err := CheckModel(name); err != nil {
+						return err
+					}
+				} else {
+					args, ok := object(value)
+					if !ok {
+						return ErrShape
+					}
+					if err := collection(args["into"]); err != nil {
+						return err
+					}
+				}
+			case "$facet":
+				facets, ok := object(value)
+				if !ok {
+					return ErrShape
+				}
+				for _, inner := range facets {
+					if err := c.pipeline(inner, depth+1); err != nil {
+						return err
+					}
+				}
+			}
+		}
+	}
+	return nil
+}
+
+func collection(value any) error {
+	if name, ok := value.(string); ok {
+		return CheckModel(name)
+	}
+	// $out/$merge may use {db, coll}. A different database is not a bypass.
+	if m, ok := object(value); ok {
+		if name, ok := m["coll"].(string); ok {
+			return CheckModel(name)
+		}
+	}
+	return fmt.Errorf("%w: collection selector", ErrShape)
+}
+
+// Reflection supports JSON maps as well as named map/slice types (types.D,
+// bson.M/A/D) without importing Mongo or pulling the monolith into pure tests.
+func object(value any) (map[string]any, bool) {
+	r := reflect.ValueOf(value)
+	if !r.IsValid() {
+		return nil, false
+	}
+	if r.Kind() == reflect.Map && r.Type().Key().Kind() == reflect.String {
+		if r.Len() > MaxTargets {
+			return nil, false
+		}
+		out := make(map[string]any, r.Len())
+		it := r.MapRange()
+		for it.Next() {
+			out[it.Key().String()] = it.Value().Interface()
+		}
+		return out, true
+	}
+	// bson.D is []bson.E{Key:string, Value:any}; reject duplicate selectors.
+	if r.Kind() == reflect.Slice && r.Type().Elem().Kind() == reflect.Struct {
+		if r.Len() > MaxTargets {
+			return nil, false
+		}
+		out := make(map[string]any, r.Len())
+		for i := 0; i < r.Len(); i++ {
+			key, val := r.Index(i).FieldByName("Key"), r.Index(i).FieldByName("Value")
+			if !key.IsValid() || key.Kind() != reflect.String || !val.IsValid() || !val.CanInterface() {
+				return nil, false
+			}
+			if _, duplicate := out[key.String()]; duplicate {
+				return nil, false
+			}
+			out[key.String()] = val.Interface()
+		}
+		return out, true
+	}
+	return nil, false
+}
+
+func array(value any) ([]any, bool) {
+	r := reflect.ValueOf(value)
+	if !r.IsValid() || (r.Kind() != reflect.Slice && r.Kind() != reflect.Array) || r.Len() > MaxTargets {
+		return nil, false
+	}
+	// A bson.D is an object, never an array of documents.
+	if r.Type().Elem().Kind() == reflect.Struct {
+		return nil, false
+	}
+	out := make([]any, r.Len())
+	for i := range out {
+		out[i] = r.Index(i).Interface()
+	}
+	return out, true
+}
diff --git a/internal/helpers/modelguard/guard_test.go b/internal/helpers/modelguard/guard_test.go
new file mode 100644
index 0000000..045e67b
--- /dev/null
+++ b/internal/helpers/modelguard/guard_test.go
@@ -0,0 +1,165 @@
+package modelguard
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+)
+
+const protected = "branch_pos__operation_evidence"
+
+func TestReservedNamespaceNotData(t *testing.T) {
+	for _, target := range []string{protected, "branch_pos__future_unknown", "branch_pos", "BranchPos", "BRANCH_POS__SALE", "BranchPos\\Sale"} {
+		if !IsProtected(CheckModel(target)) {
+			t.Errorf("not denied: %q", target)
+		}
+	}
+	for _, target := range []string{"pos__item", "branch_position__note", "ordinary_branch_pos__note", "", "a note mentioning branch_pos__operation_evidence"} {
+		if err := CheckModel(target); err != nil {
+			t.Errorf("ordinary target %q: %v", target, err)
+		}
+	}
+	data := map[string]any{"org__company": []any{map[string]any{
+		"note": protected,
+		"raw":  map[string]any{"model": protected, "$lookup": map[string]any{"from": protected}},
+	}}}
+	if err := CheckWrites(data, nil); err != nil {
+		t.Fatalf("ordinary data string was treated as a target: %v", err)
+	}
+}
+
+func TestMixedAndNestedMutationTargets(t *testing.T) {
+	relations := func(model string) map[string]string {
+		switch model {
+		case "org__company":
+			return map[string]string{"child": "org__branch"}
+		case "org__branch":
+			return map[string]string{"evidence": protected}
+		}
+		return nil
+	}
+	tests := []any{
+		map[string]any{"org__company": []any{map[string]any{"name": "normal"}}, protected: []any{}},
+		map[string][]any{"org__company": {}, "branch_pos__not_registered": {}},
+		map[string]any{"org__company": map[string]any{"child": map[string]any{"evidence": "existing-id"}}},
+		map[string]any{"org__company": []any{map[string]any{"child": []any{map[string]any{"evidence": map[string]any{"x": 1}}}}}},
+	}
+	for i, value := range tests {
+		writes := 0
+		err := CheckWrites(value, relations)
+		if err == nil {
+			writes++
+		}
+		if !IsProtected(err) || writes != 0 {
+			t.Errorf("case %d escaped complete preflight: %v", i, err)
+		}
+	}
+}
+
+func TestQueriesAndSync(t *testing.T) {
+	if err := CheckQueries(map[string]any{"org__company": map[string]any{"filters": map[string]any{"note": protected}}}); err != nil {
+		t.Fatal(err)
+	}
+	if !IsProtected(CheckQueries(map[string]any{"org__company": map[string]any{"include": map[string]any{protected: map[string]any{}}}})) {
+		t.Fatal("include target escaped")
+	}
+	settings := map[string]any{"sync": map[string]any{"mutations": []any{map[string]any{"module": protected}}}}
+	if !IsProtected(CheckSync(settings)) {
+		t.Fatal("sync mutation target escaped")
+	}
+	if err := CheckSync(map[string]any{"sync": map[string]any{"mutations": []any{map[string]any{"module": "org__company", "id": protected}}}}); err != nil {
+		t.Fatal("sync id was treated as target", err)
+	}
+}
+
+func TestAggregationTargets(t *testing.T) {
+	stages := []any{
+		map[string]any{"$lookup": map[string]any{"from": protected}},
+		map[string]any{"$graphLookup": map[string]any{"from": protected}},
+		map[string]any{"$unionWith": protected},
+		map[string]any{"$unionWith": map[string]any{"coll": protected}},
+		map[string]any{"$out": protected},
+		map[string]any{"$out": map[string]any{"db": "other", "coll": protected}},
+		map[string]any{"$merge": protected},
+		map[string]any{"$merge": map[string]any{"into": protected}},
+		map[string]any{"$merge": map[string]any{"into": map[string]any{"db": "other", "coll": protected}}},
+	}
+	for i, stage := range stages {
+		for _, wrap := range []func(any) any{
+			func(s any) any { return []any{s} },
+			func(s any) any { return []any{map[string]any{"$facet": map[string]any{"items": []any{s}}}} },
+			func(s any) any {
+				return []any{map[string]any{"$lookup": map[string]any{"from": "org__company", "pipeline": []any{s}}}}
+			},
+			func(s any) any {
+				return []any{map[string]any{"$unionWith": map[string]any{"coll": "org__company", "pipeline": []any{s}}}}
+			},
+		} {
+			if err := CheckPipeline(wrap(stage)); !IsProtected(err) {
+				t.Errorf("case %d escaped: %v", i, err)
+			}
+		}
+	}
+	ordinary := []any{map[string]any{"$match": map[string]any{"note": protected}}, map[string]any{"$project": map[string]any{"note": map[string]any{"$literal": protected}}}}
+	if err := CheckPipeline(ordinary); err != nil {
+		t.Fatal("literal data was rejected", err)
+	}
+	if err := CheckPipeline([]any{map[string]any{"$changeStream": map[string]any{"allChangesForCluster": true}}}); err == nil {
+		t.Fatal("database-wide stream must not bypass checked collection")
+	}
+}
+
+func TestNamedBsonShapedTypesAndBounds(t *testing.T) {
+	type E struct {
+		Key   string
+		Value any
+	}
+	type D []E
+	type A []any
+	type M map[string]any
+	pipeline := A{D{{"$lookup", D{{"from", protected}}}}}
+	if !IsProtected(CheckPipeline(pipeline)) {
+		t.Fatal("bson-shaped target escaped")
+	}
+	if !IsProtected(CheckQueries(M{protected: M{}})) {
+		t.Fatal("named map target escaped")
+	}
+	if err := CheckPipeline(A{D{{"$lookup", M{"from": "org__company"}}, {"$lookup", M{"from": protected}}}}); err == nil {
+		t.Fatal("duplicate selectors accepted")
+	}
+	var deep any = []any{map[string]any{"$match": map[string]any{}}}
+	for i := 0; i < MaxDepth+1; i++ {
+		deep = []any{map[string]any{"$facet": map[string]any{"items": deep}}}
+	}
+	if !errors.Is(CheckPipeline(deep), ErrBounds) {
+		t.Fatal("depth bound not enforced")
+	}
+	tooMany := make(map[string]any, MaxTargets+1)
+	for i := 0; i <= MaxTargets; i++ {
+		tooMany[fmt.Sprintf("org__company_%d", i)] = nil
+	}
+	if CheckWrites(tooMany, nil) == nil {
+		t.Fatal("target bound not enforced")
+	}
+	if CheckSync(map[string]any{"sync": map[string]any{"mutations": make([]any, MaxTargets+1)}}) == nil {
+		t.Fatal("oversized sync list accepted")
+	}
+	if CheckWrites(map[string]any{"org__company": make([]any, MaxTargets+1)}, nil) == nil {
+		t.Fatal("oversized relation list accepted")
+	}
+	wideOptions := make(map[string]any, MaxTargets+1)
+	for i := 0; i < MaxTargets; i++ {
+		wideOptions[fmt.Sprintf("unused_%d", i)] = nil
+	}
+	wideOptions["aggregate"] = []any{map[string]any{"$out": protected}}
+	if CheckQueries(map[string]any{"org__company": wideOptions}) == nil {
+		t.Fatal("oversized query options silently skipped a collection target")
+	}
+	wideOptions["sync"] = map[string]any{"mutations": []any{map[string]any{"module": protected}}}
+	if CheckSync(wideOptions) == nil {
+		t.Fatal("oversized sync settings silently skipped a collection target")
+	}
+	if CheckSync(map[string]any{"sync": wideOptions}) == nil {
+		t.Fatal("oversized nested sync settings silently skipped preflight")
+	}
+}
