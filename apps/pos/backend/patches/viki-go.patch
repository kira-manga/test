+package app_grpc
+
+import (
+	"context"
+	"strings"
+	"testing"
+
+	"google.golang.org/protobuf/types/known/structpb"
+)
+
+func TestBranchPosGenericGRPCMethodsBeforeAnyDatabase(t *testing.T) {
+	server := &MultiServiceServer{}
+	ctx := context.WithValue(context.Background(), "server_key", true)
+	for _, tc := range []struct {
+		name   string
+		body   map[string]any
+		invoke func(context.Context, *structpb.Struct) (*structpb.Struct, error)
+	}{
+		{"query", map[string]any{"branch_pos__operation_evidence": map[string]any{}}, server.MultiQuery},
+		{"count", map[string]any{"branch_pos__operation_evidence": map[string]any{}}, server.CountModels},
+		{"reset", map[string]any{"branch_pos__operation_evidence": map[string]any{}}, server.ResetModels},
+		{"update_many", map[string]any{"branch_pos__operation_evidence": map[string]any{}}, server.UpdateManyModels},
+		{"mixed_write", map[string]any{"data": map[string]any{"org__company": []any{map[string]any{"name": "must-not-write"}}, "branch_pos__future_unknown": []any{}}}, server.UpdateModels},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			request, err := structpb.NewStruct(tc.body)
+			if err != nil {
+				t.Fatal(err)
+			}
+			result, err := tc.invoke(ctx, request)
+			if result != nil || err == nil || !strings.Contains(err.Error(), "branch_pos generic access is disabled") {
+				t.Fatal("gRPC accepted protected target", result, err)
+			}
+		})
+	}
+}
