+package resolvers
+
+import (
+	"context"
+	"testing"
+
+	"github.com/graphql-go/graphql"
+	"go-viki/internal/helpers/modelguard"
+)
+
+func TestBranchPosGraphQLAllReadPathsWithoutDatabase(t *testing.T) {
+	ctx := context.WithValue(context.Background(), "server_key", true)
+	for _, module := range []string{"branch_pos__operation_evidence", "branch_pos__future_unknown"} {
+		for name, invoke := range map[string]func() error{
+			"list": func() error { _, err := GenericListResolver(module)(graphql.ResolveParams{Context: ctx}); return err },
+			"direct_id": func() error {
+				_, err := GenericSingleResolver(module)(graphql.ResolveParams{Context: ctx, Args: map[string]any{"id": "known"}})
+				return err
+			},
+			"relation_ids":     func() error { _, err := batchFetchByIDs(ctx, module, []string{"known"}); return err },
+			"inverse_relation": func() error { _, err := batchFetchByField(ctx, module, "parent", []string{"known"}); return err },
+		} {
+			t.Run(module+"/"+name, func(t *testing.T) {
+				if !modelguard.IsProtected(invoke()) {
+					t.Fatal("protected query did not fail closed")
+				}
+			})
+		}
+		if ids := searchRelatedModel(ctx, module, "name", "x", "exact", false); len(ids) != 0 {
+			t.Fatal("raw relation search exposed protected data")
+		}
+	}
+}
