+func TestNodeProducedCanonicalGolden(t *testing.T) {
+	dir := os.Getenv("BRANCHPOS_GOLDEN_DIR")
+	if dir == "" {
+		dir = "../../../../../backend/contracts/golden"
+	}
+	raw, err := os.ReadFile(filepath.Join(dir, "evidence-v1.json"))
+	if err != nil {
+		t.Fatal("required cross-language golden (BRANCHPOS_GOLDEN_DIR)", err)
+	}
+	type signedGolden struct {
+		CanonicalPayload string   `json:"canonicalPayload"`
+		Envelope         Envelope `json:"envelope"`
+	}
+	var golden struct {
+		signedGolden
+		PublicKey   string          `json:"publicKey"`
+		Batch       json.RawMessage `json:"batch"`
+		TimeVectors struct {
+			Valid   []string `json:"valid"`
+			Invalid []string `json:"invalid"`
+		} `json:"timeVectors"`
+		Variants []struct {
+			signedGolden
+			Name string `json:"name"`
+		} `json:"variants"`
+	}
+	if err := json.Unmarshal(raw, &golden); err != nil {
+		t.Fatal(err)
+	}
+	key, _ := base64.StdEncoding.DecodeString(golden.PublicKey)
+	verify := func(t *testing.T, value signedGolden) {
+		t.Helper()
+		canonical, err := CanonicalPayload(value.Envelope.Payload)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if string(canonical) != value.CanonicalPayload || ContentHash(canonical) != value.Envelope.ContentHash {
+			t.Fatal("Node/Go canonical bytes or SHA256 differ")
+		}
+		if err := VerifySignature(key, canonical, value.Envelope.Signature); err != nil {
+			t.Fatal("Node Ed25519 not verified in Go", err)
+		}
+	}
+	verify(t, golden.signedGolden)
+	for _, variant := range golden.Variants {
+		t.Run(variant.Name, func(t *testing.T) { verify(t, variant.signedGolden) })
+	}
+	if len(golden.Variants) != 6 {
+		t.Fatal("required time-bound/fraction variant missing")
+	}
+	for _, value := range golden.TimeVectors.Valid {
+		if err := ValidateEvidenceV1Time(value); err != nil {
+			t.Fatal(value, err)
+		}
+	}
+	for _, value := range golden.TimeVectors.Invalid {
+		if ValidateEvidenceV1Time(value) == nil {
+			t.Fatal("invalid Node time vector accepted", value)
+		}
+	}
+	decoded, err := DecodeBatch(bytes.NewReader(golden.Batch))
+	if err != nil || !reflect.DeepEqual(decoded, batch(golden.Envelope)) {
+		t.Fatal("Node batch fails actual strict wire decoder", err)
+	}
+	ackRaw, err := os.ReadFile(filepath.Join(dir, "ack-v1.json"))
+	if err != nil {
+		t.Fatal("required ACK example", err)
+	}
+	var wantAck Acknowledgement
+	if err := json.Unmarshal(ackRaw, &wantAck); err != nil {
+		t.Fatal(err)
+	}
+	actualAck, err := (Service{Store: newStore()}).Ingest(context.Background(), principal(), decoded)
+	if err != nil || actualAck == nil || !reflect.DeepEqual(*actualAck, wantAck) {
+		t.Fatal("ACK example differs from actual typed ingestion result", err)
+	}
+	if !reflect.DeepEqual(golden.Envelope, signPayload(t, payload(1, "1"))) {
+		t.Fatal("Node/Go signed envelope differs")
+	}
+}
