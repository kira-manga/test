+package app_handlers
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gofiber/fiber/v2"
+	"go-viki/internal/config/models_config"
+	api "go-viki/internal/helpers/apis/handlers"
+)
+
+func TestBranchPosActualHTTPHandlersBeforeAnyDatabaseOrUpload(t *testing.T) {
+	const model = "branch_pos__operation_evidence"
+	const parent = "branch_guard_test__parent"
+	previous, existed := models_config.ModuleConfigs[parent]
+	models_config.ModuleConfigs[parent] = models_config.ModelConfig{Fields: models_config.FieldMap{"evidence": {Type: "relation", Model: model}}}
+	t.Cleanup(func() {
+		if existed {
+			models_config.ModuleConfigs[parent] = previous
+		} else {
+			delete(models_config.ModuleConfigs, parent)
+		}
+	})
+	cases := []struct {
+		name, route, target, body string
+		handler                   fiber.Handler
+	}{
+		{"multi_query", "/multi_query/", "/multi_query/", `{"branch_pos__operation_evidence":{}}`, MultiQuery},
+		{"nested_include", "/multi_query/", "/multi_query/", `{"org__company":{"include":{"branch_pos__operation_evidence":{}}}}`, MultiQuery},
+		{"count", "/count-data/", "/count-data/", `{"branch_pos__operation_evidence":{}}`, CountModels},
+		{"reset", "/reset-data/", "/reset-data/", `{"branch_pos__operation_evidence":{}}`, ResetModels},
+		{"update_many", "/update-many/", "/update-many/", `{"branch_pos__operation_evidence":{"update":{"$set":{"x":1}}}}`, UpdateManyModels},
+		{"cross_lookup", "/update-many/", "/update-many/", `{"org__company":{"aggregate":[{"$lookup":{"from":"branch_pos__operation_evidence","as":"x"}}]}}`, UpdateManyModels},
+		{"update_one", "/update_one/", "/update_one/", `{"branch_pos__operation_evidence":{}}`, UpdateOneModel},
+		{"nested_cascade", "/update_one/", "/update_one/", `{"branch_guard_test__parent":{"evidence":{"name":"x"}}}`, UpdateOneModel},
+		{"mixed_bulk", "/update_models/", "/update_models/", `{"data":{"org__company":[{"name":"must-not-write"}],"branch_pos__operation_evidence":[]}}`, UpdateModels},
+		{"multi_cascade", "/multi_updates_models/", "/multi_updates_models/", `{"data":{"org__company":[{"name":"must-not-write"}],"branch_pos__operation_evidence":[]}}`, MultiUpdatesModels},
+		{"sync_push", "/multi_updates_models/", "/multi_updates_models/", `{"data":{},"settings":{"sync":{"mutations":[{"module":"branch_pos__future_unknown"}]}}}`, MultiUpdatesModels},
+		{"sync_pull", "/sync/pull/", "/sync/pull/", `{"modules":{"branch_pos__operation_evidence":{}}}`, SyncPull},
+		{"full_query", "/full_query/", "/full_query/", `{"model":"branch_pos__operation_evidence","id":"known"}`, FullQuery},
+		{"unique", "/check-unique/", "/check-unique/", `{"module":"branch_pos__operation_evidence","field":"operation_id","value":"known"}`, CheckUnique},
+		{"translation", "/trans/", "/trans/", `{"model":"branch_pos__operation_evidence","id":"known"}`, Translations},
+		{"module_update", "/:modules/update_one/", "/branch_pos__operation_evidence/update_one/", `{}`, ModuleUpdateOne},
+		{"module_query", "/:modules/multi_query/", "/branch_pos__future_unknown/multi_query/", `{}`, ModuleMultiQuery},
+		{"module_schema", "/:modules/schema/", "/branch_pos/schema/", `{}`, ModuleSchema},
+		{"crud_create", "/create/:module/:model/", "/create/branch_pos/operation_evidence/", `{}`, api.CreateUpdateSingle},
+		{"crud_find", "/find/:module/:model/:id", "/find/branch_pos/operation_evidence/known", `{}`, api.CrudFindAll},
+		{"crud_single", "/:module/:model/single/", "/branch_pos/operation_evidence/single/", `{}`, api.CrudFindSingle},
+	}
+	for _, privileged := range []bool{false, true} {
+		for _, tc := range cases {
+			t.Run(tc.name+map[bool]string{false: "/no_app", true: "/privileged"}[privileged], func(t *testing.T) {
+				app := fiber.New(fiber.Config{DisableStartupMessage: true})
+				app.Use(func(c *fiber.Ctx) error {
+					ctx := context.Background()
+					if privileged {
+						c.Locals("server_key", true)
+						c.Locals("user", map[string]any{"is_super_admin": true})
+						ctx = context.WithValue(ctx, "server_key", true)
+					}
+					c.SetUserContext(ctx)
+					return c.Next()
+				})
+				app.Post(tc.route, tc.handler)
+				request := httptest.NewRequest(http.MethodPost, tc.target, strings.NewReader(tc.body))
+				request.Header.Set("Content-Type", "application/json")
+				response, err := app.Test(request, -1)
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer response.Body.Close()
+				raw, _ := io.ReadAll(response.Body)
+				if response.StatusCode < 400 || response.StatusCode >= 500 || !strings.Contains(string(raw), "branch_pos generic access is disabled") {
+					t.Fatalf("handler did not fail before DB/upload: %d %s", response.StatusCode, raw)
+				}
+			})
+		}
+	}
+}
