+package sync
+
+import (
+	"context"
+	"testing"
+
+	"go-viki/internal/config/models_config"
+	"go-viki/internal/helpers/modelguard"
+)
+
+func TestBranchPosPullAndManifestIgnoreGenericOfflineEnablement(t *testing.T) {
+	ctx := context.WithValue(context.Background(), "server_key", true)
+	_, _, err := Pull(ctx, PullRequest{Modules: map[string]PullModuleRequest{"branch_pos__operation_evidence": {}}})
+	if !modelguard.IsProtected(err) {
+		t.Fatal("pull did not deny before DB cursor lookup", err)
+	}
+	previous := models_config.ModuleConfigs
+	t.Cleanup(func() { models_config.ModuleConfigs = previous })
+	models_config.ModuleConfigs = map[string]models_config.ModelConfig{
+		"branch_pos__operation_evidence": {Offline: &models_config.OfflineConfig{Mode: "full"}},
+	}
+	manifest, _, err := Manifest(ctx)
+	if err != nil || len(manifest) != 0 {
+		t.Fatal("generic offline flag bypassed namespace guard", manifest, err)
+	}
+}
