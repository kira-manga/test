+package import_export_handlers
+
+import (
+	"bytes"
+	"context"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gofiber/fiber/v2"
+	"go-viki/internal/document/common"
+	"go-viki/internal/helpers/modelguard"
+	"go-viki/services/import_export/helpers/functions/imports"
+	insert_models "go-viki/services/import_export/helpers/models/inserts"
+	"go-viki/services/import_export/helpers/service"
+	"go.mongodb.org/mongo-driver/mongo"
+)
+
+func TestBranchPosImportExportBeforeAnyDatabase(t *testing.T) {
+	app := fiber.New(fiber.Config{DisableStartupMessage: true})
+	app.Post("/export/direct", DirectExportHandler)
+	req := httptest.NewRequest(http.MethodPost, "/export/direct", strings.NewReader(`{"module":"branch_pos__operation_evidence","format":"csv"}`))
+	req.Header.Set("Content-Type", "application/json")
+	res, err := app.Test(req, -1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusForbidden {
+		t.Fatal("protected export was not forbidden", res.StatusCode)
+	}
+	if _, err := imports.GetHandler("branch_pos__future_unknown"); !modelguard.IsProtected(err) {
+		t.Fatal("reserved import type not denied", err)
+	}
+	rows := &insert_models.Inserts{Ctx: context.Background(), Inserts: map[string][]mongo.WriteModel{
+		"org__company":                   {mongo.NewInsertOneModel().SetDocument(map[string]any{"name": "must not write"})},
+		"branch_pos__operation_evidence": {mongo.NewInsertOneModel().SetDocument(map[string]any{})},
+	}}
+	if err := rows.FlushInserts(); !modelguard.IsProtected(err) {
+		t.Fatal("mixed import targets not denied before writes", err)
+	}
+	if err := service.ImportProcessUpload(context.Background(), "must-not-open", "branch_pos__future_unknown", "test", false); !modelguard.IsProtected(err) {
+		t.Fatal("protected import created metadata or opened input", err)
+	}
+	if _, err := service.ImportAnalysisSheet(context.Background(), &common.UploadSheetModel{UploadType: "branch_pos__future_unknown"}, false); !modelguard.IsProtected(err) {
+		t.Fatal("protected import deleted/updated metadata before preflight", err)
+	}
+	if err := service.ExportDataToSheet(context.Background(), &common.ExportSheetModel{Module: "branch_pos__future_unknown"}, false); !modelguard.IsProtected(err) {
+		t.Fatal("protected export changed metadata before preflight", err)
+	}
+}
+
+func TestBranchPosImportUploadBeforeSavingAnyFile(t *testing.T) {
+	var body bytes.Buffer
+	w := multipart.NewWriter(&body)
+	if err := w.WriteField("type", "branch_pos__future_unknown"); err != nil {
+		t.Fatal(err)
+	}
+	file, err := w.CreateFormFile("file", "not-created-branch-pos.csv")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := file.Write([]byte("test,data\n")); err != nil {
+		t.Fatal(err)
+	}
+	if err := w.Close(); err != nil {
+		t.Fatal(err)
+	}
+	app := fiber.New(fiber.Config{DisableStartupMessage: true})
+	app.Post("/collect/upload", ImportUploadHandler)
+	req := httptest.NewRequest(http.MethodPost, "/collect/upload", &body)
+	req.Header.Set("Content-Type", w.FormDataContentType())
+	res, err := app.Test(req, -1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusForbidden {
+		t.Fatal("reserved upload not denied before save/DB", res.StatusCode)
+	}
+}
