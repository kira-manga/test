+/** Real JVM threads, still in-memory targets: no native receipt/cleanup inference is made here. */
+class ScopedDisclosureConcurrencyTest {
+    @Test
+    fun concurrentWrapperClaimsHaveOneActualSdkOwner() {
+        val f = Fixture()
+        val workers = Executors.newFixedThreadPool(4)
+        val ready = CountDownLatch(4)
+        val start = CountDownLatch(1)
+        try {
+            val claims = List(4) {
+                val wrapper = object : P2pSession by f.session {}
+                workers.submit(Callable {
+                    ready.countDown()
+                    start.awaitGuard()
+                    runBlocking { runCatching { wrapper.claimInitialDisclosureLifetime() } }
+                })
+            }
+            ready.awaitGuard()
+            start.countDown()
+            val results = claims.map { it.get(5, TimeUnit.SECONDS) }
+            assertEquals(1, results.count { it.isSuccess })
+            assertEquals(3, results.count { it.exceptionOrNull() is P2pError.ConnectionFailed })
+        } finally {
+            start.countDown()
+            workers.shutdownNow()
+            assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS))
+            f.close()
+        }
+    }
+
+    @Test
+    fun sealCompletesOnAnotherThreadWhilePrecommitAndSendMutexWaitersRemainPaused() {
+        val atBoundary = CountDownLatch(1)
+        val allowCommitAttempt = CountDownLatch(1)
+        val f = Fixture(beforeCommit = {
+            atBoundary.countDown()
+            allowCommitAttempt.awaitGuard()
+        })
+        val workers = Executors.newFixedThreadPool(3)
+        try {
+            val lifetime = runBlocking { f.session.claimInitialDisclosureLifetime() }
+            val tickets = runBlocking { List(2) { lifetime.prepare(binary(), lifetime.deadlineAfter(100)) } }
+            val first = workers.submit(Callable { runBlocking { runCatching { f.session.sendScoped(tickets[0]) } } })
+            atBoundary.awaitGuard()
+            val secondEntered = CountDownLatch(1)
+            val second = workers.submit(Callable {
+                secondEntered.countDown()
+                runBlocking { runCatching { f.session.sendScoped(tickets[1]) } }
+            })
+            secondEntered.awaitGuard()
+            awaitCondition { tickets[1].state == P2pDisclosureTicketState.Preparing }
+            val sealing = workers.submit(Callable { runBlocking { lifetime.seal() } })
+            sealing.get(5, TimeUnit.SECONDS)
+            assertFalse(first.isDone)
+            assertTrue(lifetime.isSealed)
+            assertTrue(tickets.all { it.state == P2pDisclosureTicketState.Sealed })
+            assertTrue(f.raw.frames.isEmpty())
+            assertEquals(0L, f.budget.retainedBytes.value)
+            allowCommitAttempt.countDown()
+            assertIs<P2pError>(first.get(5, TimeUnit.SECONDS).exceptionOrNull())
+            assertIs<P2pError>(second.get(5, TimeUnit.SECONDS).exceptionOrNull())
+            assertTrue(f.raw.frames.isEmpty())
+        } finally {
+            allowCommitAttempt.countDown()
+            workers.shutdownNow()
+            assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS))
+            f.close()
+        }
+    }
+
+    @Test
+    fun committedWriterMayBeginOnOriginalTargetAfterSealWithoutBlockingTheAuthority() {
+        val writerEntered = CountDownLatch(1)
+        val allowWriter = CountDownLatch(1)
+        val f = Fixture(beforeOutput = {
+            writerEntered.countDown()
+            allowWriter.awaitGuard()
+        })
+        val workers = Executors.newFixedThreadPool(2)
+        try {
+            val lifetime = runBlocking { f.session.claimInitialDisclosureLifetime() }
+            val ticket = runBlocking { lifetime.prepare(binary(), lifetime.deadlineAfter(100)) }
+            val sending = workers.submit(Callable { runBlocking { f.session.sendScoped(ticket) } })
+            writerEntered.awaitGuard()
+            assertEquals(P2pDisclosureTicketState.Committed, ticket.state)
+            assertTrue(f.raw.frames.isEmpty())
+            val sealing = workers.submit(Callable { runBlocking { lifetime.seal() } })
+            sealing.get(5, TimeUnit.SECONDS)
+            assertFalse(sending.isDone)
+            assertEquals(P2pDisclosureTicketState.Committed, ticket.state)
+            assertEquals(513L, f.budget.retainedBytes.value)
+            assertFalse(runBlocking { ticket.cancelBeforeCommit() })
+            allowWriter.countDown()
+            sending.get(5, TimeUnit.SECONDS)
+            assertSame(f.raw, f.targets.single())
+            assertEquals(1, f.raw.frames.size)
+            assertEquals(P2pDisclosureTicketState.Finished, ticket.state)
+            assertEquals(0L, f.budget.retainedBytes.value)
+        } finally {
+            allowWriter.countDown()
+            workers.shutdownNow()
+            assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS))
+            f.close()
+        }
+    }
+
+    @Test
+    fun observableBudgetReservationDoesNotHoldTheAuthorityGateAcrossAppCode() {
+        val budget = PayloadBudget(4_096)
+        val lifetime = P2pInitialDisclosureLifetime(Any(), Any(), { 1_000L }, budget, 512)
+        val callbackEntered = CountDownLatch(1)
+        val releaseCallback = CountDownLatch(1)
+        val observerOwner = SupervisorJob()
+        val observerScope = CoroutineScope(Dispatchers.Unconfined + observerOwner)
+        val workers = Executors.newFixedThreadPool(2)
+        try {
+            observerScope.launch(start = CoroutineStart.UNDISPATCHED) {
+                budget.retainedBytes.collect { retained ->
+                    if (retained > 0) {
+                        callbackEntered.countDown()
+                        releaseCallback.awaitGuard()
+                    }
+                }
+            }
+            val preparing = workers.submit(Callable {
+                runBlocking { runCatching { lifetime.prepare(binary(), lifetime.deadlineAfter(100)) } }
+            })
+            callbackEntered.awaitGuard()
+            val sealing = workers.submit(Callable { runBlocking { lifetime.seal() } })
+            sealing.get(5, TimeUnit.SECONDS)
+            assertTrue(lifetime.isSealed)
+            assertFalse(preparing.isDone, "the public budget callback is intentionally still running")
+            releaseCallback.countDown()
+            assertIs<P2pError.AuthorizationRejected>(preparing.get(5, TimeUnit.SECONDS).exceptionOrNull())
+            assertEquals(0L, budget.retainedBytes.value)
+        } finally {
+            releaseCallback.countDown()
+            observerOwner.cancel()
+            workers.shutdownNow()
+            assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS))
+            runBlocking { withTimeout(5_000) { observerOwner.join() } }
+        }
+    }
+
+    @Test
+    fun lifecycleBudgetReleaseDoesNotRunAppObserversUnderTheOuterConnectionLock() {
+        val f = Fixture()
+        val callbackEntered = CountDownLatch(1)
+        val releaseCallback = CountDownLatch(1)
+        val observerOwner = SupervisorJob()
+        val observerScope = CoroutineScope(Dispatchers.Unconfined + observerOwner)
+        val workers = Executors.newFixedThreadPool(2)
+        try {
+            val lifetime = runBlocking { f.session.claimInitialDisclosureLifetime() }
+            runBlocking { lifetime.prepare(binary(), lifetime.deadlineAfter(100)) }
+            observerScope.launch(start = CoroutineStart.UNDISPATCHED) {
+                f.budget.retainedBytes.collect { retained ->
+                    if (retained == 0L) {
+                        callbackEntered.countDown()
+                        releaseCallback.awaitGuard()
+                    }
+                }
+            }
+            val closing = workers.submit(Callable { runBlocking { f.session.close() } })
+            callbackEntered.awaitGuard()
+            assertTrue(lifetime.isSealed)
+            val competingClaim = workers.submit(Callable {
+                runBlocking { runCatching { f.session.claimInitialDisclosureLifetime() } }
+            })
+            // This call needs connectionLock. It must fail promptly while the observer is still parked.
+            assertIs<P2pError.ConnectionFailed>(competingClaim.get(5, TimeUnit.SECONDS).exceptionOrNull())
+            assertFalse(closing.isDone)
+            releaseCallback.countDown()
+            closing.get(5, TimeUnit.SECONDS)
+        } finally {
+            releaseCallback.countDown()
+            observerOwner.cancel()
+            workers.shutdownNow()
+            assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS))
