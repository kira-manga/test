@@ -0,0 +1,67 @@
+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.core.PayloadBudget
+import dev.p2pkit.core.security.payloadSha256
+import dev.p2pkit.rpc.RpcFailure
+import dev.p2pkit.rpc.RpcFailureKind
+import dev.p2pkit.rpc.RpcFailurePhase
+import dev.p2pkit.rpc.ScopedRpcBinding
+
+internal class ScopedPacket(val bindingDigest: String, val message: WireMessage)
+
+/** Explicit incompatible outer profile. The existing PRPC/v1 encoder/decoder is unchanged. */
+internal object ScopedRpcWire {
+    const val HEADER_BYTES: Int = 40
+    const val MAX_PACKET_BYTES: Int = HEADER_BYTES + RpcWire.HEADER_BYTES + 96 + 65_536
+    private val magic = byteArrayOf(0x50, 0x53, 0x52, 0x50) // PSRP, not legacy PRPC.
+    private const val VERSION: Int = 1
+    private const val STRICT_INVOKE_ONLY: Int = 1
+
+    fun bindingDigest(binding: ScopedRpcBinding): String {
+        val fields = listOf("p2pkit.scoped-invoke-only/v1", binding.scopeId, binding.actorId,
+            binding.applicationSessionId, binding.purpose, binding.projectionId)
+        // ASCII identifiers, explicitly length framed. No delimiter aliases or caller-provided digest.
+        val text = fields.joinToString("") { "${it.length}:$it" }
+        return payloadSha256(text.encodeToByteArray()).toHex()
+    }
+
+    fun encode(bindingDigest: String, message: WireMessage): ByteArray {
+        if (message.kind !in setOf(WireKind.Hello, WireKind.Ready, WireKind.Invoke, WireKind.Success,
+                WireKind.ApplicationError, WireKind.Failure, WireKind.Running) ||
+            (message.kind == WireKind.Ready && message.code != 1) ||
+            (message.kind == WireKind.Invoke && (message.code != 0 || message.attempt != 1)) ||
+            (message.body?.size ?: 0) > 65_536
+        ) invalid()
+        val inner = RpcWire.encode(message)
+        if (HEADER_BYTES + inner.size > MAX_PACKET_BYTES) invalid()
+        return ByteArray(HEADER_BYTES + inner.size).also { result ->
+            magic.copyInto(result)
+            result[4] = VERSION.toByte()
+            result[5] = STRICT_INVOKE_ONLY.toByte()
+            parseHex(bindingDigest, 32).copyInto(result, 8)
+            inner.copyInto(result, HEADER_BYTES)
+        }
+    }
+
+    fun decode(bytes: ByteArray, budget: PayloadBudget): ScopedPacket {
+        if (bytes.size !in (HEADER_BYTES + RpcWire.HEADER_BYTES)..MAX_PACKET_BYTES ||
+            magic.indices.any { bytes[it] != magic[it] } || bytes[4].toInt() != VERSION ||
+            bytes[5].toInt() != STRICT_INVOKE_ONLY || bytes[6] != 0.toByte() || bytes[7] != 0.toByte()
+        ) invalid()
+        val digest = bytes.copyOfRange(8, HEADER_BYTES).toHex()
+        val message = RpcWire.decode(bytes.copyOfRange(HEADER_BYTES, bytes.size), budget)
+        if ((message.body?.size ?: 0) > 65_536) {
+            message.release()
+            invalid()
+        }
+        return ScopedPacket(digest, message)
+    }
+
+    private fun invalid(): Nothing = throw RpcFailure(
+        RpcFailureKind.IncompatibleVersion, RpcFailurePhase.Negotiation,
+    )
+}
+
+/** No existence query, cancellation, receipt eviction or notification publication is allowed. */
+internal fun WireKind.disabledInScopedProfile(): Boolean = this == WireKind.Status || this == WireKind.Cancel ||
+    this == WireKind.Receipt || this == WireKind.Notify
