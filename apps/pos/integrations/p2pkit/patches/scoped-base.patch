+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.core.PayloadBudget
+import dev.p2pkit.core.PayloadLease
+import dev.p2pkit.rpc.RpcReply
+import dev.p2pkit.rpc.ScopedRpcBinding
+import dev.p2pkit.rpc.ScopedRpcCallContext
+import dev.p2pkit.rpc.ScopedRpcProcedure
+import dev.p2pkit.rpc.ScopedRpcRequestContext
+import dev.p2pkit.rpc.ScopedRpcRequestGrant
+
+internal interface ScopedRegisteredProcedure {
+    val name: String
+    val version: Int
+    val key: String get() = "$name/$version"
+    val requestLimit: Int
+    val resultLimit: Int
+    fun windowMillis(binding: ScopedRpcBinding): Long
+    suspend fun authenticate(
+        context: ScopedRpcRequestContext,
+        body: OwnedBytes,
+        budget: PayloadBudget,
+        retainedDecodedAllowance: PayloadLease,
+    ): ScopedAuthorizedRequest?
+}
+
+/** Owns decoded Q only until THIS invocation exits. Tombstones retain neither this nor raw Q. */
+internal class ScopedAuthorizedRequest(
+    val grant: ScopedRpcRequestGrant,
+    private val retainedDecodedAllowance: PayloadLease,
+    action: suspend (ScopedRpcCallContext, PayloadLease) -> EncodedReply,
+) {
+    private var action: (suspend (ScopedRpcCallContext, PayloadLease) -> EncodedReply)? = action
+    suspend fun execute(context: ScopedRpcCallContext, resultAllowance: PayloadLease): EncodedReply =
+        checkNotNull(action)(context, resultAllowance)
+
+    fun release() {
+        action = null
+        retainedDecodedAllowance.release()
+    }
+}
+
+internal fun <Q, R, E> scopedRegisteredProcedure(
+    procedure: ScopedRpcProcedure<Q, R, E>,
+    windowMillis: (ScopedRpcBinding) -> Long,
+    authorize: suspend (ScopedRpcRequestContext, Q) -> ScopedRpcRequestGrant?,
+    handler: suspend (ScopedRpcCallContext, Q) -> RpcReply<R, E>,
+): ScopedRegisteredProcedure = object : ScopedRegisteredProcedure {
+    override val name: String = procedure.name
+    override val version: Int = procedure.version
+    override val requestLimit: Int = procedure.requestLimitBytes
+    override val resultLimit: Int = maxOf(procedure.responseLimitBytes, procedure.errorLimitBytes)
+    override fun windowMillis(binding: ScopedRpcBinding): Long = windowMillis.invoke(binding)
+
+    override suspend fun authenticate(
+        context: ScopedRpcRequestContext,
+        body: OwnedBytes,
+        budget: PayloadBudget,
+        retainedDecodedAllowance: PayloadLease,
+    ): ScopedAuthorizedRequest? {
+        // A separate retained allowance keeps the decoded credential object charged throughout async
+        // authorization/handler execution; RpcBodyCodec's temporary parser allowance is not that owner.
+        val decoded = RpcBodyCodec.decode(procedure.request, body, requestLimit, budget)
+        val grant = authorize(context, decoded) ?: return null
+        return ScopedAuthorizedRequest(grant, retainedDecodedAllowance) { call, resultAllowance ->
+            when (val reply = handler(call, decoded)) {
+                is RpcReply.Success -> EncodedReply(WireKind.Success,
+                    RpcBodyCodec.encode(procedure.response, reply.value, procedure.responseLimitBytes,
+                        budget, resultAllowance))
+                is RpcReply.ApplicationError -> EncodedReply(WireKind.ApplicationError,
+                    RpcBodyCodec.encode(procedure.applicationError, reply.error, procedure.errorLimitBytes,
+                        budget, resultAllowance))
+            }
+        }
+    }
+}
