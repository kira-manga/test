+            register(procedure, { 10_000 }) { _, value -> executions++; RpcReply.Success(value) }
+        }
+        val missingWindow = ScopedRpcHostConfiguration().apply {
+            disclose = ScopedRpcDisclosureAuthorizer { true }
+            register(procedure, authorize = { _, _ -> scopedGrant() }) { _, value ->
+                executions++; RpcReply.Success(value)
+            }
+        }
+        val missingCurrentAuthority = configuration(handler = { _, value ->
+            executions++; RpcReply.Success(value)
+        }).apply { disclose = ScopedRpcDisclosureAuthorizer { false } }
+        for (config in listOf(missingProof, missingWindow, missingCurrentAuthority)) {
+            val fixture = ScopedHostFixture(backgroundScope, config)
+            fixture.start(); runCurrent(); fixture.link.clearSent()
+            fixture.invoke(); runCurrent()
