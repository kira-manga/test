+            val wrapperB = object : P2pSession by f.session {}
+            val start = CompletableDeferred<Unit>()
+            val claims = listOf(wrapperA, wrapperB, f.session).map { session ->
+                f.scope.async { start.await(); runCatching { session.claimInitialDisclosureLifetime() } }
+            }
+            start.complete(Unit)
+            runCurrent()
+            assertEquals(1, claims.count { it.await().isSuccess })
+            assertEquals(2, claims.count { it.await().exceptionOrNull() is P2pError.ConnectionFailed })
+            assertFailsWith<P2pError.ConnectionFailed> { f.session.claimInitialDisclosureLifetime() }
+        } finally {
+            dispose(f)
+        }
+    }
