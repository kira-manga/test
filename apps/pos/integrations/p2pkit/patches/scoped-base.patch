+            f.close()
+        }
+    }
+
+    @Test
+    fun queuedUnconfinedWaiterCanDelayLifecycleReturnButCannotReopenSealedAuthority() {
+        val f = Fixture()
+        val defaultOwner = SupervisorJob()
+        val defaultScope = CoroutineScope(Dispatchers.Default + defaultOwner)
+        val unconfinedOwner = SupervisorJob()
+        val unconfinedScope = CoroutineScope(Dispatchers.Unconfined + unconfinedOwner)
+        val waiterReturned = CountDownLatch(1)
+        val releaseWaiter = CountDownLatch(1)
+        var initiallyHeldGate: Mutex? = null
+        try {
+            val lifetime = runBlocking { f.session.claimInitialDisclosureLifetime() }
+            // Private JVM-only synchronization: no production callback/test seam inside the authority gate.
+            val gate = P2pInitialDisclosureLifetime::class.java.getDeclaredField("gate").let { field ->
+                field.isAccessible = true
+                field.get(lifetime) as Mutex
+            }
+            val deadline = lifetime.deadlineAfter(100)
+            val ticket = runBlocking { lifetime.prepare(binary(), deadline) }
+            val publication = runBlocking { lifetime.preparePublication(deadline) }
+            val independentPublication = runBlocking { lifetime.preparePublication(deadline) }
+            runBlocking { gate.lock() }
+            initiallyHeldGate = gate
+
+            // The idle fixture has no connection-lock contender: close first suspends at lifetime.gate,
+            // keeping connectionLock and taking the FIRST FIFO waiter slot on this held gate.
+            val closing = defaultScope.async(start = CoroutineStart.UNDISPATCHED) { f.session.close() }
+            assertFalse(closing.isCompleted)
+            val waiter = unconfinedScope.async(start = CoroutineStart.UNDISPATCHED) {
+                assertFalse(publication.tryCommit())
+                waiterReturned.countDown()
+                releaseWaiter.awaitGuard()
+            }
+            assertFalse(waiter.isCompleted)
+            gate.unlock()
+            initiallyHeldGate = null
+
+            // Default close seals then unlocks. The second, Unconfined waiter returns false and its
+            // app code blocks inline AFTER lifetime unlock, but BEFORE the outer connection unlock.
+            waiterReturned.awaitGuard()
+            assertTrue(lifetime.isSealed)
+            assertEquals(P2pDisclosureTicketState.Sealed, ticket.state)
+            assertEquals(P2pDisclosureTicketState.Sealed, publication.state)
+            assertEquals(P2pDisclosureTicketState.Sealed, independentPublication.state)
+            runBlocking {
+                withTimeout(5_000) {
+                    assertFalse(independentPublication.tryCommit())
+                    assertFailsWith<P2pError.ConnectionFailed> { f.session.sendScoped(ticket) }
+                }
+            }
+            assertTrue(f.targets.isEmpty())
+            assertTrue(f.raw.frames.isEmpty())
+            val competingClaim = defaultScope.async(start = CoroutineStart.UNDISPATCHED) {
+                runCatching { f.session.claimInitialDisclosureLifetime() }
+            }
+            // UNDISPATCHED reached the occupied connection mutex: these are suspension assertions,
+            // not a timed negative wait or a claim that lifecycle return is callback-free.
+            assertFalse(competingClaim.isCompleted)
+            assertFalse(closing.isCompleted)
+            releaseWaiter.countDown()
+            runBlocking {
+                withTimeout(5_000) {
+                    waiter.await()
+                    assertIs<P2pError.ConnectionFailed>(competingClaim.await().exceptionOrNull())
+                    closing.await()
+                }
+            }
+            assertEquals(0L, f.budget.retainedBytes.value)
+        } finally {
+            releaseWaiter.countDown()
+            initiallyHeldGate?.unlock()
+            defaultOwner.cancel()
+            unconfinedOwner.cancel()
+            try {
+                runBlocking {
+                    withTimeout(5_000) {
+                        defaultOwner.join()
+                        unconfinedOwner.join()
+                    }
+                }
+            } finally {
+                f.close()
+            }
+        }
+    }
+
+    @Test
+    fun preparationAndDeadlineApisDeclareExpectedExceptionSignatures() {
+        // JVM throws metadata regression only: this is NOT exported Swift header/runtime qualification.
+        val declarations = listOf(
+            P2pInitialDisclosureLifetime::class.java to "prepare",
+            P2pInitialDisclosureLifetime::class.java to "preparePublication",
+            P2pInitialDisclosureLifetime::class.java to "deadlineAfter",
+            P2pDisclosureDeadline::class.java to "limitTo",
+        )
+        for ((owner, name) in declarations) {
+            val method = owner.declaredMethods.single { it.name == name }
+            assertTrue(
+                method.exceptionTypes.any { it == Exception::class.java },
+                "$name must declare the expected refusal/input-validation exception boundary",
+            )
+        }
+    }
+
+    @Test
+    fun racingPublicationCommitCancelAndSealAlwaysHaveASingleTerminalDecision() {
+        val workers = Executors.newFixedThreadPool(3)
+        try {
+            repeat(128) {
+                val budget = PayloadBudget(512)
+                val lifetime = P2pInitialDisclosureLifetime(Any(), Any(), { 1_000L }, budget, 512)
+                val publication = runBlocking { lifetime.preparePublication(lifetime.deadlineAfter(100)) }
+                val ready = CountDownLatch(3)
+                val start = CountDownLatch(1)
+                val commit = workers.submit(Callable {
+                    ready.countDown()
+                    start.awaitGuard()
+                    runBlocking { publication.tryCommit() }
+                })
+                val cancel = workers.submit(Callable {
+                    ready.countDown()
+                    start.awaitGuard()
+                    runBlocking { publication.cancelBeforeCommit() }
+                })
+                val seal = workers.submit(Callable {
+                    ready.countDown()
+                    start.awaitGuard()
+                    runBlocking { lifetime.seal() }
+                })
+                ready.awaitGuard()
+                start.countDown()
+                val committed = commit.get(5, TimeUnit.SECONDS)
+                val cancelled = cancel.get(5, TimeUnit.SECONDS)
+                seal.get(5, TimeUnit.SECONDS)
+                assertFalse(committed && cancelled)
+                assertEquals(committed, publication.hasCommitted)
+                assertEquals(
+                    when {
+                        committed -> P2pDisclosureTicketState.Committed
+                        cancelled -> P2pDisclosureTicketState.Cancelled
+                        else -> P2pDisclosureTicketState.Sealed
+                    },
+                    publication.state,
+                )
+                assertTrue(lifetime.isSealed)
+                assertFalse(runBlocking { publication.tryCommit() })
+                assertFalse(runBlocking { publication.cancelBeforeCommit() })
+                assertEquals(0L, budget.retainedBytes.value)
+            }
+        } finally {
+            workers.shutdownNow()
+            assertTrue(workers.awaitTermination(5, TimeUnit.SECONDS))
+        }
+    }
+
+    private class Fixture(
+        beforeCommit: (suspend () -> Unit)? = null,
+        private val beforeOutput: (() -> Unit)? = null,
+    ) {
+        private val owner = SupervisorJob()
+        private val scope = CoroutineScope(Dispatchers.Default + owner)
+        val budget = PayloadBudget(1_048_576)
+        val raw = RecordingConnection()
+        val targets = ConcurrentLinkedQueue<RawConnection>()
+        private val profile = P2pSessionProfile({ PeerAdmission.Trusted }, budget, 1, maxApplicationBytes = 512)
+        private val peer = Peer(PeerId("race-peer"), "Peer", Platform.JVM_DESKTOP, setOf(TransportKind.LAN))
+        private val delegate = DefaultP2pProtocol(
+            clock = { 1_000L }, version = ProtocolConstants.SECURE_VERSION, sessionProfile = profile,
+        )
+        private val protocol = object : P2pProtocol by delegate {
+            override suspend fun sendMessage(
+                connection: RawConnection, message: P2pMessage, sessionState: ProtocolSessionState,
+            ) {
+                targets += connection
+                beforeOutput?.invoke()
+                delegate.sendMessage(connection, message, sessionState)
+            }
+        }
+        val session = P2pSessionImpl(
+            id = "race-session", peer = peer,
+            peerIdentity = PeerIdentity(peer.id, PeerFingerprint.fromDigest(ByteArray(32) { 11 })),
+            initialConnection = raw, initialEvents = Channel<ProtocolEvent>(Channel.UNLIMITED),
+            initialProtocolState = ProtocolSessionState(
+                "race-local", true, restrictedApplicationBytes = 512,
+            ).also { it.completeHello(peer.id.value, ProtocolFeatures.SECURE_V2) },
+            protocol = protocol, parentScope = scope, keepAlive = KeepAliveConfig(60_000, 120_000),
+            clock = { 1_000L }, monotonicClock = { 1_000L }, logger = P2pLogger.NoOp,
+            sessionProfile = profile, beforeScopedDisclosureCommitForTest = beforeCommit,
+        ).also { it.start() }
+
+        fun close() = runBlocking {
+            try {
+                withTimeout(5_000) { session.close() }
+            } finally {
+                owner.cancel()
+                withTimeout(5_000) { owner.join() }
+            }
+        }
+    }
+
+    private class RecordingConnection : RawConnection {
+        override val state = MutableStateFlow(ConnectionState.Connected)
+        val frames = ConcurrentLinkedQueue<ByteArray>()
+
+        override suspend fun write(bytes: ByteArray) {
+            check(state.value == ConnectionState.Connected)
+            frames += bytes.copyOf()
+        }
+
+        override fun read() = flow<ByteArray> { awaitCancellation() }
+
+        override suspend fun close() {
+            state.value = ConnectionState.Closed
+        }
+    }
+
+    private fun CountDownLatch.awaitGuard() {
+        assertTrue(await(5, TimeUnit.SECONDS), "owned race-test barrier was not released")
+    }
+
+    private fun awaitCondition(ready: () -> Boolean) {
+        val began = System.nanoTime()
+        while (!ready()) {
+            assertTrue(System.nanoTime() - began < TimeUnit.SECONDS.toNanos(5), "owned waiter did not reach its gate")
+            Thread.yield()
+        }
+    }
+
+    private fun binary(): P2pMessage.Binary = P2pMessage.Binary(byteArrayOf(1))
+}
