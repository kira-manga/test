+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.core.ConnectionState
+import dev.p2pkit.core.P2pDisclosureDeadline
+import dev.p2pkit.core.P2pDisclosurePublication
+import dev.p2pkit.core.P2pDisclosureTicket
+import dev.p2pkit.core.P2pError
+import dev.p2pkit.core.P2pInitialDisclosureLifetime
+import dev.p2pkit.core.P2pMessage
+import dev.p2pkit.core.P2pSession
+import dev.p2pkit.core.PayloadBudget
+import dev.p2pkit.core.PayloadLease
+import dev.p2pkit.core.PeerIdentity
+import dev.p2pkit.rpc.RpcFailure
+import dev.p2pkit.rpc.RpcFailureKind
+import dev.p2pkit.rpc.RpcFailurePhase
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.awaitCancellation
+import kotlinx.coroutines.cancel
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.collect
+import kotlinx.coroutines.flow.combine
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+/** Internal deterministic-test seam. Public factories accept ONLY a real SDK session, never this seam. */
+internal interface ScopedRpcLink {
+    val identity: PeerIdentity
+    val isSealed: Boolean
+    fun deadlineAfter(validForMillis: Long): ScopedDeadline
+    fun start(onMessage: suspend (ScopedPacket, ScopedDeadline) -> Unit, onSealed: suspend () -> Unit)
+    suspend fun offer(message: WireMessage, deadline: ScopedDeadline): ScopedSendTicket?
+    suspend fun preparePublication(deadline: ScopedDeadline): ScopedPublication
+    suspend fun seal()
+    suspend fun close()
+}
+
+internal interface ScopedDeadline {
+    /** Local timeout/admission aid. Only the SDK commitment is the authoritative disclosure fence. */
+    val remainingMillis: Long
+    fun limitTo(validForMillis: Long): ScopedDeadline
+}
+
+internal interface ScopedSendTicket {
+    val hasCommitted: Boolean
+    val completion: Deferred<Boolean>
+    suspend fun cancelBeforeCommit(): Boolean
+}
+
+internal interface ScopedPublication {
+    suspend fun tryCommit(): Boolean
+    suspend fun cancelBeforeCommit(): Boolean
+}
+
+private class SdkScopedDeadline(
+    val owner: P2pInitialDisclosureLifetime,
+    val value: P2pDisclosureDeadline,
+    private val clock: RpcClock,
+    private val beganAt: Long,
+    private val allowance: Long,
+) : ScopedDeadline {
+    override val remainingMillis: Long get() {
+        val elapsed = clock.now() - beganAt
+        return if (elapsed < 0 || elapsed >= allowance) 0 else allowance - elapsed
+    }
+
+    override fun limitTo(validForMillis: Long): ScopedDeadline {
+        require(validForMillis in 1..30_000L)
+        return SdkScopedDeadline(owner, value.limitTo(validForMillis), clock, beganAt,
+            minOf(allowance, validForMillis))
+    }
+}
+
+private class SdkScopedPublication(private val value: P2pDisclosurePublication) : ScopedPublication {
+    override suspend fun tryCommit(): Boolean = value.tryCommit()
+    override suspend fun cancelBeforeCommit(): Boolean = value.cancelBeforeCommit()
+}
+
+/**
+ * Exactly one immutable physical target. No peer map, generation substitution, re-encoding at send,
+ * legacy send fallback, or reconnect loop. Claim precedes ALL application binary, including HELLO.
+ */
+internal class SessionScopedRpcLink private constructor(
+    private val session: P2pSession,
+    private val lifetime: P2pInitialDisclosureLifetime,
+    parent: CoroutineScope,
+    private val budget: PayloadBudget,
+    private val clock: RpcClock,
+    private val bindingDigest: String,
+    queueLimit: Int,
+) : ScopedRpcLink {
+    private val owner = SupervisorJob(parent.coroutineContext[Job])
+    private val scope = CoroutineScope(parent.coroutineContext + owner)
+    private val sealed = MutableStateFlow(false)
+    private val started = MutableStateFlow(false)
+    private val lock = Mutex()
+    private val queue = ArrayDeque<Outbound>()
+    // Includes preparing, queued AND in-flight entries. Cancelled entries are physically removed.
+    private val entries = Semaphore(queueLimit)
+    private val wake = Channel<Unit>(Channel.CONFLATED)
+    private var onSealed: suspend () -> Unit = {}
+    override val identity: PeerIdentity = session.peerIdentity
+    override val isSealed: Boolean get() = sealed.value || lifetime.isSealed
+
+    private inner class Outbound(
+        val ticket: P2pDisclosureTicket,
+        private val allowance: PayloadLease,
+    ) : ScopedSendTicket {
+        private val finished = MutableStateFlow(false)
+        override val completion = CompletableDeferred<Boolean>()
+        override val hasCommitted: Boolean get() = ticket.hasCommitted
+
+        override suspend fun cancelBeforeCommit(): Boolean = withContext(NonCancellable) {
+            val cancelled = ticket.cancelBeforeCommit()
+            val removed = lock.withLock { queue.remove(this@Outbound) }
+            if (removed) finish(false)
+            // If a writer already owns this entry, its finally retains/relinquishes its allowance.
+            cancelled
+        }
+
+        fun finish(success: Boolean) {
+            if (!finished.compareAndSet(false, true)) return
+            allowance.release()
+            entries.release()
+            completion.complete(success)
+        }
+    }
+
+    override fun deadlineAfter(validForMillis: Long): ScopedDeadline {
+        // The auxiliary clock starts first, conservatively; neither clock is rebased after auth.
+        val beganAt = clock.now()
+        return SdkScopedDeadline(lifetime, lifetime.deadlineAfter(validForMillis), clock,
+            beganAt, validForMillis)
+    }
+
+    private fun sdkDeadline(deadline: ScopedDeadline): P2pDisclosureDeadline {
+        require(deadline is SdkScopedDeadline && deadline.owner === lifetime) {
+            "Scoped deadline belongs to another physical lifetime"
+        }
+        return deadline.value
+    }
+
+    override fun start(
+        onMessage: suspend (ScopedPacket, ScopedDeadline) -> Unit,
+        onSealed: suspend () -> Unit,
+    ) {
+        check(started.compareAndSet(false, true) && !isSealed)
+        this.onSealed = onSealed
+        // Subscribe before the first HELLO. Malformed/disabled peer messages cannot cancel records.
+        scope.launch(start = CoroutineStart.UNDISPATCHED) {
+            try {
+                session.incoming.collect { raw ->
+                    val boundary = deadlineAfter(30_000)
+                    if (raw !is P2pMessage.Binary || raw.metadata.isNotEmpty() ||
+                        raw.sizeBytes > ScopedRpcWire.MAX_PACKET_BYTES || isSealed
+                    ) return@collect
+                    val scratch = budget.tryReserve(3L * raw.sizeBytes + 1_024) ?: return@collect
+                    try {
+                        val packet = try {
+                            ScopedRpcWire.decode(raw.bytes, budget)
+                        } catch (cancelled: CancellationException) {
+                            throw cancelled
+                        } catch (_: Exception) {
+                            // Explicit profile refusal: no READY, no downgrade, and no application reply.
+                            return@collect
+                        }
+                        try { onMessage(packet, boundary) } finally { packet.message.release() }
+                    } finally { scratch.release() }
+                }
+            } finally {
+                withContext(NonCancellable) { seal() }
+            }
+        }
+        scope.launch {
+            try {
+                for (ignored in wake) {
+                    while (true) {
+                        val next = lock.withLock { queue.removeFirstOrNull() } ?: break
+                        var success = false
+                        try {
+                            currentCoroutineContext().ensureActive()
+                            session.sendScoped(next.ticket)
+                            success = true
+                        } catch (cancelled: CancellationException) {
+                            throw cancelled
+                        } catch (_: Exception) {
+                            // Evidence comes from the SDK ticket, not entry into this Kotlin worker.
+                        } finally {
+                            withContext(NonCancellable) {
+                                next.ticket.cancelBeforeCommit()
+                                next.finish(success)
+                            }
+                        }
+                    }
+                }
+            } finally {
+                withContext(NonCancellable) { seal() }
+            }
+        }
+        scope.launch(start = CoroutineStart.UNDISPATCHED) {
+            try {
+                combine(session.state, session.connectionInfo) { state, info -> state to info.generation }
+                    .collect { (state, generation) ->
+                        if (state != ConnectionState.Connected || generation != 1L) seal()
+                    }
+            } finally {
+                withContext(NonCancellable) { seal() }
+            }
+        }
+        scope.launch(start = CoroutineStart.UNDISPATCHED) {
+            try { awaitCancellation() } finally { withContext(NonCancellable) { seal() } }
+        }
+    }
+
+    override suspend fun offer(message: WireMessage, deadline: ScopedDeadline): ScopedSendTicket? {
+        currentCoroutineContext().ensureActive()
+        if (isSealed || deadline.remainingMillis <= 0 || !entries.tryAcquire()) return null
+        var allowance: PayloadLease? = null
+        var prepared: P2pDisclosureTicket? = null
+        var outbound: Outbound? = null
+        var queued = false
+        try {
+            val size = ScopedRpcWire.HEADER_BYTES + RpcWire.HEADER_BYTES + message.name.length +
+                (message.body?.size ?: 0)
+            allowance = budget.reserve(4L * size + 4_096)
+            val binary = P2pMessage.Binary(ScopedRpcWire.encode(bindingDigest, message))
+            prepared = lifetime.prepare(binary, sdkDeadline(deadline))
+            allowance.shrinkTo(size.toLong() + 1_024)
+            val entry = Outbound(prepared, allowance)
+            outbound = entry
+            queued = lock.withLock {
+                if (isSealed) false else {
+                    queue.addLast(entry)
+                    true
+                }
+            }
+            if (!queued) return null
+            wake.trySend(Unit)
+            return entry
+        } finally {
+            if (!queued) withContext(NonCancellable) {
+                prepared?.cancelBeforeCommit()
+                if (outbound != null) outbound.finish(false) else {
+                    allowance?.release()
+                    entries.release()
+                }
+            }
+        }
+    }
+
+    override suspend fun preparePublication(deadline: ScopedDeadline): ScopedPublication =
+        SdkScopedPublication(lifetime.preparePublication(sdkDeadline(deadline)))
+
+    override suspend fun seal(): Unit = withContext(NonCancellable) {
+        // The SDK authority is sealed FIRST, independently of coroutine scheduling or native cleanup.
+        lifetime.seal()
+        val drained = lock.withLock {
+            if (sealed.value) return@withLock null
+            sealed.value = true
+            queue.toList().also { queue.clear() }
+        } ?: return@withContext
+        drained.forEach { it.finish(false) }
+        wake.cancel()
+        scope.cancel()
+        // No callback, payload release, completion, or native wait runs under the queue/state lock.
+        onSealed()
+    }
+
+    override suspend fun close(): Unit = withContext(NonCancellable) {
+        seal()
+        // Repeated calls reobserve the actual SDK's retained native cleanup result. Never self-join.
+        session.close()
+    }
+
+    companion object {
+        suspend fun claim(
+            session: P2pSession,
+            parent: CoroutineScope,
+            budget: PayloadBudget,
+            clock: RpcClock,
+            bindingDigest: String,
+            queueLimit: Int,
+        ): SessionScopedRpcLink {
+            currentCoroutineContext().ensureActive()
+            val lifetime = session.claimInitialDisclosureLifetime()
+            try {
+                // A virtual/delegating session can forward claim while substituting identity/incoming.
+                // Only the SDK's final opaque authority can attest the exact object without callbacks.
+                if (!lifetime.belongsTo(session)) {
+                    throw P2pError.ConnectionFailed("Scoped RPC requires the actual initial SDK session owner")
+                }
+                currentCoroutineContext().ensureActive()
+                return SessionScopedRpcLink(session, lifetime, parent, budget, clock, bindingDigest, queueLimit)
+            } catch (failure: Throwable) {
+                withContext(NonCancellable) { lifetime.seal() }
+                throw failure
+            }
+        }
+    }
+}
+
+internal fun scopedDenied(phase: RpcFailurePhase = RpcFailurePhase.Admission): Nothing =
+    throw RpcFailure(RpcFailureKind.Unauthorized, phase)
