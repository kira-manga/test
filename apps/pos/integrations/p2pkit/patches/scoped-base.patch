--- /dev/null
+++ b/library/p2p-rpc/src/commonMain/kotlin/dev/p2pkit/rpc/internal/ScopedRpcClientEngine.kt
@@ -0,0 +1,468 @@
+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.core.P2pError
+import dev.p2pkit.core.PayloadBudget
+import dev.p2pkit.core.PayloadLease
+import dev.p2pkit.core.security.payloadSha256
+import dev.p2pkit.rpc.RpcExecutionEvidence
+import dev.p2pkit.rpc.RpcFailure
+import dev.p2pkit.rpc.RpcFailureKind
+import dev.p2pkit.rpc.RpcFailurePhase
+import dev.p2pkit.rpc.RpcReply
+import dev.p2pkit.rpc.RpcRequestId
+import dev.p2pkit.rpc.RpcRetryAdvice
+import dev.p2pkit.rpc.ScopedRpcBinding
+import dev.p2pkit.rpc.ScopedRpcDelivery
+import dev.p2pkit.rpc.ScopedRpcDisclosureAuthorizer
+import dev.p2pkit.rpc.ScopedRpcDisclosurePhase
+import dev.p2pkit.rpc.ScopedRpcLimits
+import dev.p2pkit.rpc.ScopedRpcProcedure
+import dev.p2pkit.rpc.ScopedRpcRequestContext
+import dev.p2pkit.rpc.ScopedRpcRequestGrant
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.channels.Channel
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+import kotlinx.coroutines.withTimeoutOrNull
+
+internal interface ScopedDeliveryOwner {
+    suspend fun take(currentPresentationBinding: ScopedRpcBinding): RpcReply<*, *>
+    suspend fun discard()
+}
+
+internal data class ScopedClientSnapshot(val pending: Int, val deliveries: Int, val outstanding: Int)
+
+/** One immutable attachment; a new authenticated application recovery call is NOT a transport retry. */
+internal class ScopedRpcClientEngine(
+    private val link: ScopedRpcLink,
+    private val binding: ScopedRpcBinding,
+    private val limits: ScopedRpcLimits,
+    private val windowMillis: (ScopedRpcBinding) -> Long,
+    private val authorize: ScopedRpcDisclosureAuthorizer,
+    internal val budget: PayloadBudget,
+) {
+    private class Pending(val request: ScopedRpcRequestContext, val incarnation: String) {
+        val replies = Channel<WireMessage>(1, onUndeliveredElement = { it.release() })
+        var active = true
+        var terminalReceived = false
+    }
+
+    private inner class Allowance(val metadata: PayloadLease) {
+        private val released = MutableStateFlow(false)
+        var decoded: PayloadLease? = null
+        fun release() {
+            if (!released.compareAndSet(false, true)) return
+            decoded?.release()
+            metadata.release()
+            slots.release()
+        }
+    }
+
+    private inner class Delivery(
+        val request: ScopedRpcRequestContext,
+        val grant: ScopedRpcRequestGrant,
+        val deadline: ScopedDeadline,
+        val allowance: Allowance,
+        var value: RpcReply<*, *>?,
+    ) : ScopedDeliveryOwner {
+        // Guarded by the engine lock. In-progress publication keeps its allowance until actual exit.
+        var taking = false
+        var discarded = false
+        var done = false
+        override suspend fun take(currentPresentationBinding: ScopedRpcBinding): RpcReply<*, *> =
+            takeDelivery(this, currentPresentationBinding)
+        override suspend fun discard() = discardDelivery(this)
+    }
+
+    private val lock = Mutex()
+    private val sealed = MutableStateFlow(false)
+    private val slots = Semaphore(limits.calls)
+    private val pending = mutableMapOf<String, Pending>()
+    private val deliveries = mutableMapOf<String, Delivery>()
+    private val bindingDigest = ScopedRpcWire.bindingDigest(binding)
+    private val helloId = newWireId()
+    private val readiness = CompletableDeferred<String>()
+    private var incarnation: String? = null
+    internal val isSealed: Boolean get() = sealed.value || link.isSealed
+
+    fun start() { link.start(::onMessage, ::invalidate) }
+
+    suspend fun negotiate() {
+        val deadline = link.deadlineAfter(5_000)
+        val tickets = mutableListOf<ScopedSendTicket>()
+        try {
+            withTimeout(5_000) {
+                while (!readiness.isCompleted) {
+                    if (isSealed || deadline.remainingMillis <= 0) {
+                        throw RpcFailure(RpcFailureKind.NotConnected, RpcFailurePhase.Negotiation)
+                    }
+                    link.offer(WireMessage(WireKind.Hello, helloId), deadline)?.let(tickets::add)
+                    // At most twenty nonsecret HELLO attempts; one origin, no application retry.
+                    if (withTimeoutOrNull(minOf(250, deadline.remainingMillis).coerceAtLeast(1)) {
+                            readiness.await()
+                        } != null
+                    ) break
+                }
+                readiness.await()
+            }
+        } catch (_: TimeoutCancellationException) {
+            // Absence of a matching scoped READY is not proof of which peer/network condition failed.
+            throw RpcFailure(RpcFailureKind.DeadlineExceeded, RpcFailurePhase.Negotiation)
+        } catch (cancelled: CancellationException) {
+            if (!currentCoroutineContext().isActive) throw cancelled
+            throw RpcFailure(RpcFailureKind.Closed, RpcFailurePhase.Negotiation)
+        } finally {
+            withContext(NonCancellable) { tickets.forEach { it.cancelBeforeCommit() } }
+        }
+    }
+
+    @Suppress("UNUSED_PARAMETER")
+    internal suspend fun onMessage(packet: ScopedPacket, ignoredBoundary: ScopedDeadline) {
+        val message = packet.message
+        if (message.kind.disabledInScopedProfile()) return
+        if (packet.bindingDigest != bindingDigest || isSealed) return
+        when (message.kind) {
+            WireKind.Ready -> {
+                if (message.id != helloId || message.code != 1) return
+                val accepted = lock.withLock {
+                    if (sealed.value || (incarnation != null && incarnation != message.incarnation)) false else {
+                        incarnation = message.incarnation
+                        true
+                    }
+                }
+                if (accepted) readiness.complete(message.incarnation)
+            }
+            WireKind.Success, WireKind.ApplicationError, WireKind.Failure -> {
+                val target = lock.withLock {
+                    val call = pending[message.id] ?: return@withLock null
+                    if (sealed.value || !call.active || call.terminalReceived ||
+                        message.incarnation != call.incarnation ||
+                        message.name != call.request.procedureName || message.version != call.request.procedureVersion
+                    ) return@withLock null
+                    call.terminalReceived = true
+                    call
+                } ?: return
+                // Never resume application authorization/decoding while holding the state lock.
+                val owned = message.retained()
+                if (target.replies.trySend(owned).isFailure) owned.release()
+            }
+            else -> Unit // RUNNING never initiates a status request, reinvocation, or deadline renewal.
+        }
+    }
+
+    suspend fun <Q, R, E> call(
+        procedure: ScopedRpcProcedure<Q, R, E>,
+        value: Q,
+        grant: ScopedRpcRequestGrant,
+        timeoutMillis: Long,
+    ): ScopedRpcDelivery<R, E> {
+        require(timeoutMillis in 1..30_000L)
+        val boundary = link.deadlineAfter(timeoutMillis)
+        if (grant.binding != binding) scopedDenied()
+        val window = try { windowMillis(binding) } catch (_: Exception) { 0 }
+        if (window <= 0) scopedDenied()
+        val deadline = boundary.limitTo(minOf(window, 30_000))
+        currentCoroutineContext().ensureActive()
+        if (isSealed) throw RpcFailure(RpcFailureKind.Closed, RpcFailurePhase.Admission)
+        if (deadline.remainingMillis <= 0) scopedDenied()
+        val id = RpcRequestId(newWireId())
+        if (!slots.tryAcquire()) throw RpcFailure(RpcFailureKind.Overloaded, RpcFailurePhase.Admission)
+        val metadata = budget.tryReserve(CALL_ALLOWANCE)
+        if (metadata == null) {
+            slots.release()
+            throw RpcFailure(RpcFailureKind.Overloaded, RpcFailurePhase.Admission)
+        }
+        val allowance = Allowance(metadata)
+        var input: OwnedBytes? = null
+        var response: WireMessage? = null
+        var call: Pending? = null
+        var ticket: ScopedSendTicket? = null
+        var failurePublication: ScopedPublication? = null
+        var publishedRemoteFailure: RpcFailure? = null
+        var delivery: Delivery? = null
+        var transferred = false
+        var cleaned = false
+        suspend fun cleanupCall() = withContext(NonCancellable) {
+            ticket?.cancelBeforeCommit()
+            failurePublication?.cancelBeforeCommit()
+            val registered = call
+            if (registered != null) {
+                lock.withLock {
+                    registered.active = false
+                    if (pending[id.value] === registered) pending.remove(id.value)
+                }
+                registered.replies.cancel()
+            }
+            input?.release()
+            input = null
+            response?.release()
+            response = null
+        }
+        try {
+            input = atCodecPhase(RpcFailurePhase.Encoding) {
+                RpcBodyCodec.encode(procedure.request, value, procedure.requestLimitBytes, budget)
+            }
+            val request = ScopedRpcRequestContext(link.identity, binding, id, procedure.name, procedure.version,
+                payloadSha256(checkNotNull(input).bytes).toHex(), deadline.remainingMillis)
+            val registered = lock.withLock {
+                if (sealed.value || link.isSealed) throw RpcFailure(RpcFailureKind.Closed, RpcFailurePhase.Admission)
+                val ready = incarnation ?: throw RpcFailure(RpcFailureKind.NotConnected, RpcFailurePhase.Negotiation)
+                Pending(request, ready).also { pending[id.value] = it }
+            }
+            call = registered
+            withTimeout(deadline.remainingMillis.coerceAtLeast(1)) {
+                if (!scopedAuthorize(authorize, request, grant, ScopedRpcDisclosurePhase.Request, deadline)) {
+                    scopedDenied(RpcFailurePhase.Sending)
+                }
+                currentCoroutineContext().ensureActive()
+                if (deadline.remainingMillis <= 0) scopedDenied(RpcFailurePhase.Sending)
+                val invocation = WireMessage(WireKind.Invoke, id.value, registered.incarnation, procedure.name,
+                    procedure.version, deadline.remainingMillis.coerceAtLeast(1).toInt(), 1, body = input)
+                ticket = link.offer(invocation, deadline)
+                    ?: throw RpcFailure(RpcFailureKind.Overloaded, RpcFailurePhase.Sending)
+                input?.release()
+                input = null
+                if (!checkNotNull(ticket).completion.await()) {
+                    throw RpcFailure(RpcFailureKind.NotConnected, RpcFailurePhase.Sending)
+                }
+                response = registered.replies.receiveCatching().getOrNull()
+                    ?: throw RpcFailure(RpcFailureKind.Closed, RpcFailurePhase.AwaitingResponse)
+                val received = checkNotNull(response)
+                if (!scopedAuthorize(authorize, request, grant, ScopedRpcDisclosurePhase.Response, deadline)) {
+                    scopedDenied(RpcFailurePhase.AwaitingResponse)
+                }
+                lock.withLock { requirePending(registered) }
+                if (received.kind == WireKind.Failure) {
+                    // Even an execution-status/error disclosure needs CURRENT local publication authority.
+                    if (!scopedAuthorize(authorize, request, grant, ScopedRpcDisclosurePhase.Publication, deadline)) {
+                        scopedDenied(RpcFailurePhase.AwaitingResponse)
+                    }
+                    failurePublication = link.preparePublication(deadline)
+                    if (!checkNotNull(failurePublication).tryCommit()) scopedDenied(RpcFailurePhase.AwaitingResponse)
+                    lock.withLock { requirePending(registered) }
+                    val failure = WireFailure.entries.first { it.code == received.code }
+                    val reported = RpcFailure(failure.kind, RpcFailurePhase.AwaitingResponse, id, failure.evidence,
+                        if (failure.evidence == RpcExecutionEvidence.RejectedBeforeExecution) {
+                            RpcRetryAdvice.SafeBeforeExecution
+                        } else RpcRetryAdvice.ApplicationIdempotencyRequired)
+                    // Only this exact engine-created exception has authorized remote provenance.
+                    // Public fields (including requestId/evidence) can be supplied by serializers.
+                    publishedRemoteFailure = reported
+                    throw reported
+                }
+                val body = checkNotNull(received.body)
+                val decoded: RpcReply<R, E> = atCodecPhase(RpcFailurePhase.Decoding) {
+                    allowance.decoded = budget.reserve(4L * body.size + 32_768)
+                    when (received.kind) {
+                        WireKind.Success -> RpcReply.Success(
+                            RpcBodyCodec.decode(procedure.response, body, procedure.responseLimitBytes, budget),
+                        )
+                        WireKind.ApplicationError -> RpcReply.ApplicationError(
+                            RpcBodyCodec.decode(procedure.applicationError, body, procedure.errorLimitBytes, budget),
+                        )
+                        else -> error("Nonterminal scoped reply")
+                    }
+                }
+                val owned = Delivery(request, grant, deadline, allowance, decoded)
+                delivery = owned
+                lock.withLock {
+                    requirePending(registered)
+                    if (deadline.remainingMillis <= 0) scopedDenied(RpcFailurePhase.Decoding)
+                    pending.remove(id.value)
+                    registered.active = false
+                    deliveries[id.value] = owned
+                }
+                // Cancellation (not close) releases all undelivered body handles immediately.
+                registered.replies.cancel()
+            }
+            // Finish ALL suspending pending/ticket cleanup before handing off an opaque resource.
+            // Cancellation during cleanup must still discard the not-yet-returned delivery/slot.
+            cleanupCall()
+            cleaned = true
+            currentCoroutineContext().ensureActive()
+            val owned = checkNotNull(delivery)
+            lock.withLock {
+                if (sealed.value || owned.discarded || owned.done) scopedDenied(RpcFailurePhase.Decoding)
+            }
+            val result = ScopedRpcDelivery<R, E>(id, binding, owned)
+            currentCoroutineContext().ensureActive()
+            transferred = true
+            return result
+        } catch (cancelled: TimeoutCancellationException) {
+            withContext(NonCancellable) { ticket?.cancelBeforeCommit() }
+            throw callFailure(RpcFailureKind.DeadlineExceeded, RpcFailurePhase.AwaitingResponse, id, ticket)
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (failure: RpcFailure) {
+            // Cancel FIRST: a formerly queued send cannot commit after being reported as NotSent.
+            withContext(NonCancellable) { ticket?.cancelBeforeCommit() }
+            if (failure === publishedRemoteFailure) throw failure
+            throw callFailure(failure.kind, failure.phase, id, ticket)
+        } catch (failure: Exception) {
+            withContext(NonCancellable) { ticket?.cancelBeforeCommit() }
+            val kind = when (failure) {
+                is P2pError.AuthorizationRejected -> RpcFailureKind.Unauthorized
+                is P2pError.PayloadTooLarge -> RpcFailureKind.InvalidPayload
+                is P2pError.ProtocolError -> RpcFailureKind.Overloaded
+                else -> RpcFailureKind.NotConnected
+            }
+            throw callFailure(kind, RpcFailurePhase.AwaitingResponse, id, ticket)
+        } finally {
+            if (!cleaned || !transferred) withContext(NonCancellable) {
+                if (!cleaned) cleanupCall()
+                if (!transferred) {
+                    delivery?.let { discardDelivery(it) }
+                    allowance.release()
+                }
+            }
+        }
+    }
+
+    private inline fun <T> atCodecPhase(phase: RpcFailurePhase, action: () -> T): T = try {
+        action()
+    } catch (failure: RpcFailure) {
+        // A serializer is not a source of execution evidence, request identity, or diagnostic phase.
+        // The outer call boundary derives evidence/advice only from its original SDK send ticket.
+        throw RpcFailure(failure.kind, phase)
+    }
+
+    private fun requirePending(call: Pending) {
+        if (sealed.value || link.isSealed || !call.active || pending[call.request.requestId.value] !== call) {
+            scopedDenied(RpcFailurePhase.AwaitingResponse)
+        }
+    }
+
+    private suspend fun takeDelivery(delivery: Delivery, presentation: ScopedRpcBinding): RpcReply<*, *> {
+        if (presentation != binding) {
+            discardDelivery(delivery)
+            scopedDenied(RpcFailurePhase.Decoding)
+        }
+        lock.withLock {
+            if (sealed.value || link.isSealed || delivery.discarded || delivery.done || delivery.taking ||
+                deliveries[delivery.request.requestId.value] !== delivery
+            ) scopedDenied(RpcFailurePhase.Decoding)
+            delivery.taking = true
+        }
+        var publication: ScopedPublication? = null
+        try {
+            if (!scopedAuthorize(authorize, delivery.request, delivery.grant,
+                    ScopedRpcDisclosurePhase.Publication, delivery.deadline)
+            ) scopedDenied(RpcFailurePhase.Decoding)
+            currentCoroutineContext().ensureActive()
+            publication = link.preparePublication(delivery.deadline)
+            if (!checkNotNull(publication).tryCommit()) scopedDenied(RpcFailurePhase.Decoding)
+            val result = lock.withLock {
+                if (sealed.value || delivery.discarded || delivery.done ||
+                    deliveries[delivery.request.requestId.value] !== delivery
+                ) scopedDenied(RpcFailurePhase.Decoding)
+                // The SDK commitment immediately precedes OLD-context ownership transfer. Seal may
+                // discard an untaken handle; it cannot recall an already transferred application value.
+                checkNotNull(delivery.value).also {
+                    delivery.value = null
+                    delivery.done = true
+                    deliveries.remove(delivery.request.requestId.value)
+                }
+            }
+            currentCoroutineContext().ensureActive()
+            return result
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (failure: RpcFailure) {
+            throw failure
+        } catch (_: Exception) {
+            scopedDenied(RpcFailurePhase.Decoding)
+        } finally {
+            withContext(NonCancellable) {
+                publication?.cancelBeforeCommit()
+                lock.withLock {
+                    delivery.taking = false
+                    delivery.done = true
+                    delivery.discarded = true
+                    delivery.value = null
+                    if (deliveries[delivery.request.requestId.value] === delivery) {
+                        deliveries.remove(delivery.request.requestId.value)
+                    }
+                }
+                delivery.allowance.release()
+            }
+        }
+    }
+
+    private suspend fun discardDelivery(delivery: Delivery): Unit = withContext(NonCancellable) {
+        val release = lock.withLock {
+            delivery.discarded = true
+            if (deliveries[delivery.request.requestId.value] === delivery) {
+                deliveries.remove(delivery.request.requestId.value)
+            }
+            if (delivery.taking || delivery.done) false else {
+                delivery.value = null
+                delivery.done = true
+                true
+            }
+        }
+        if (release) delivery.allowance.release()
+    }
+
+    private suspend fun invalidate(): Unit = withContext(NonCancellable) {
+        val calls = mutableListOf<Pending>()
+        val releases = mutableListOf<Allowance>()
+        lock.withLock {
+            if (sealed.value) return@withLock
+            sealed.value = true
+            incarnation = null
+            pending.values.forEach { it.active = false; calls.add(it) }
+            pending.clear()
+            deliveries.values.forEach {
+                it.discarded = true
+                if (!it.taking && !it.done) {
+                    it.done = true
+                    it.value = null
+                    releases.add(it.allowance)
+                }
+            }
+            deliveries.clear()
+        }
+        readiness.cancel()
+        calls.forEach { it.replies.cancel() }
+        releases.forEach { it.release() }
+        // In-progress non-cooperative authorization/decoding retains its own slot/leases until exit.
+    }
+
+    suspend fun seal() {
+        link.seal()
+        invalidate()
+    }
+
+    suspend fun close() {
+        seal()
+        link.close()
+    }
+
+    internal suspend fun snapshot(): ScopedClientSnapshot = lock.withLock {
+        ScopedClientSnapshot(pending.size, deliveries.size, limits.calls - slots.availablePermits)
+    }
+
+    private fun callFailure(
+        kind: RpcFailureKind,
+        phase: RpcFailurePhase,
+        id: RpcRequestId,
+        ticket: ScopedSendTicket?,
+    ): RpcFailure {
+        val committed = ticket?.hasCommitted == true
+        return RpcFailure(kind, phase, id,
+            if (committed) RpcExecutionEvidence.MayHaveExecuted else RpcExecutionEvidence.NotSent,
+            if (committed) RpcRetryAdvice.ApplicationIdempotencyRequired else RpcRetryAdvice.SafeBeforeExecution)
+    }
+
+    private companion object { const val CALL_ALLOWANCE = 4_096L }
+}
