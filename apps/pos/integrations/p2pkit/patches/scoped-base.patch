+    private suspend fun assertDeserializerFailureUsesOriginalEvidence(scope: CoroutineScope, kind: WireKind) {
+        for (sameIdValue in listOf(false, true)) {
+            var originalId: RpcRequestId? = null
+            var spoofed: RpcFailure? = null
+            var responseChecks = 0
+            var publicationChecks = 0
+            val broken = object : KSerializer<String> by String.serializer() {
+                override fun deserialize(decoder: Decoder): String {
+                    decoder.decodeString()
+                    val original = checkNotNull(originalId).value
+                    val claimedId = if (sameIdValue) original else {
+                        (if (original.first() == '0') "1" else "0") + original.drop(1)
+                    }
+                    val failure = RpcFailure(RpcFailureKind.Overloaded,
+                        if (sameIdValue) RpcFailurePhase.Negotiation else RpcFailurePhase.Trust,
+                        RpcRequestId(claimedId), RpcExecutionEvidence.RejectedBeforeExecution,
+                        RpcRetryAdvice.SafeBeforeExecution)
+                    spoofed = failure
+                    throw failure
+                }
+            }
+            val brokenProcedure = ScopedRpcProcedure("scoped.echo", 1, String.serializer(), broken, broken,
+                128, 128, 128)
+            val fixture = ScopedClientFixture(scope, configuration().apply {
+                authorize = ScopedRpcDisclosureAuthorizer {
+                    when (it.phase) {
+                        ScopedRpcDisclosurePhase.Request -> { originalId = it.request.requestId; true }
+                        ScopedRpcDisclosurePhase.Response -> { responseChecks++; true }
+                        ScopedRpcDisclosurePhase.Publication -> { publicationChecks++; false }
+                    }
+                }
+            })
+            fixture.start()
+            fixture.onInvoke = { fixture.respond(it, kind) }
+            val failure = assertFailsWith<RpcFailure> {
+                fixture.client.call(brokenProcedure, "valid", scopedGrant(), 5_000)
+            }
+            assertNotSame(assertNotNull(spoofed), failure)
+            assertSame(assertNotNull(originalId), failure.requestId)
+            assertEquals(fixture.link.sent.single().id, failure.requestId?.value)
+            assertEquals(RpcFailureKind.Overloaded, failure.kind)
+            assertEquals(RpcFailurePhase.Decoding, failure.phase)
+            assertEquals(RpcExecutionEvidence.MayHaveExecuted, failure.executionEvidence)
+            assertEquals(RpcRetryAdvice.ApplicationIdempotencyRequired, failure.retryAdvice)
+            assertEquals(1, responseChecks)
+            assertEquals(0, publicationChecks)
+            assertEquals(0, fixture.link.publicationCommits)
+            assertEquals(1, fixture.link.offeredInvocations)
+            assertEquals(listOf(WireKind.Invoke), fixture.link.sent.map { it.kind })
+            assertEquals(ScopedClientSnapshot(0, 0, 0), fixture.client.snapshot())
+            assertEquals(0L, fixture.budget.retainedBytes.value)
+            fixture.close()
+        }
+    }
