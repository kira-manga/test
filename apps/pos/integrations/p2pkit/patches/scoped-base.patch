+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.Semaphore
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+
+internal data class ScopedHostSnapshot(val records: Int, val running: Int, val recordLookups: Long)
+
+/** Bounded invoke-only state for ONE physical lifetime. There is deliberately no business work queue. */
+internal class ScopedRpcHostEngine(
+    parent: CoroutineScope,
+    private val link: ScopedRpcLink,
+    private val binding: ScopedRpcBinding,
+    private val procedures: Map<String, ScopedRegisteredProcedure>,
+    private val limits: ScopedRpcLimits,
+    private val disclose: ScopedRpcDisclosureAuthorizer,
+    internal val budget: PayloadBudget,
+    internal val incarnation: String = newWireId(),
+) {
+    private class Record(
+        val request: ScopedRpcRequestContext,
+        val grant: ScopedRpcRequestGrant,
+        val deadline: ScopedDeadline,
+        val metadata: PayloadLease,
+    ) {
+        var running = true
+        var workerActive = true
+        var retired = false
+        var kind = WireKind.Running
+        var code = 0
+        var cached: OwnedBytes? = null
+        var cacheAllowance: PayloadLease? = null
+    }
+
+    private class Response(
+        val request: ScopedRpcRequestContext,
+        val grant: ScopedRpcRequestGrant,
+        val message: WireMessage,
+    )
+
+    private sealed class Admission {
+        data object Fresh : Admission()
+        data object Drop : Admission()
+        data object Full : Admission()
+        class Duplicate(val response: Response) : Admission()
+    }
+
+    private val owner = SupervisorJob(parent.coroutineContext[Job])
+    private val scope = CoroutineScope(parent.coroutineContext + owner)
+    private val lock = Mutex()
+    private val sealed = MutableStateFlow(false)
+    private val bindingDigest = ScopedRpcWire.bindingDigest(binding)
+    private val attempts = Semaphore(2 * limits.calls)
+    private val executions = Semaphore(limits.calls)
+    private val cache = limits.resultCacheBytes.takeIf { it > 0 }?.let(::PayloadBudget)
+    private val records = mutableMapOf<String, Record>()
+    private var helloId: String? = null
+    private var ready = false
+    private var recordLookups = 0L
+    internal val isSealed: Boolean get() = sealed.value || link.isSealed
+
+    fun start() {
+        try { link.start(::onMessage, ::invalidate) } catch (failure: Throwable) {
+            scope.cancel()
+            throw failure
+        }
+    }
+
+    internal suspend fun onMessage(packet: ScopedPacket, boundary: ScopedDeadline) {
+        val message = packet.message
+        // Deliberately BEFORE binding/incarnation/existence checks or record mutation. These packets
+        // are not an indirect close, cancellation, cache eviction, result query, or event publication.
+        if (message.kind.disabledInScopedProfile()) return
+        if (packet.bindingDigest != bindingDigest || isSealed) return
+        when (message.kind) {
+            WireKind.Hello -> hello(message, boundary)
+            WireKind.Invoke -> {
+                if (message.attempt != 1 || message.code != 0 || message.body == null) return
+                val negotiated = lock.withLock { ready && message.incarnation == incarnation && !sealed.value }
+                if (!negotiated) return
+                val procedure = procedures[message.key] ?: return
+                if (message.body.size > procedure.requestLimit || !attempts.tryAcquire()) return
+                val owned = message.retained()
+                val worker = scope.launch(start = CoroutineStart.LAZY) {
+                    try { process(procedure, owned, boundary) } catch (cancelled: CancellationException) {
+                        throw cancelled
+                    } catch (_: Exception) {
+                        // All application/auth/encoding failures are handled below. No untrusted fallback.
+                    }
+                }
+                // Also runs if the parent cancels this lazy child before its body ever starts.
+                worker.invokeOnCompletion { owned.release(); attempts.release() }
+                worker.start()
+            }
+            else -> Unit // No pairing, login bypass, notification, renegotiation, or legacy dispatch.
+        }
+    }
+
+    private suspend fun hello(message: WireMessage, boundary: ScopedDeadline) {
+        val accepted = lock.withLock {
+            if (sealed.value || (helloId != null && helloId != message.id)) false else {
+                helloId = message.id
+                true
+            }
+        }
+        if (!accepted) return
+        val ticket = try {
+            link.offer(WireMessage(WireKind.Ready, message.id, incarnation, code = 1), boundary.limitTo(5_000))
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) { null }
+        if (ticket != null) lock.withLock { if (!sealed.value) ready = true }
+    }
+
+    private suspend fun process(
+        procedure: ScopedRegisteredProcedure,
+        message: WireMessage,
+        boundary: ScopedDeadline,
+    ) {
+        // Captured by the transport before wire decode. limitTo NEVER reads a clock or rebases origin.
+        var deadline = boundary.limitTo(message.budgetMillis.toLong())
+        val window = try { procedure.windowMillis(binding) } catch (_: Exception) { return }
+        if (window <= 0) return
+        deadline = deadline.limitTo(minOf(window, 30_000))
+        if (deadline.remainingMillis <= 0 || isSealed) return
+        val body = checkNotNull(message.body)
+        val request = ScopedRpcRequestContext(link.identity, binding, RpcRequestId(message.id), procedure.name,
+            procedure.version, payloadSha256(body.bytes).toHex(), deadline.remainingMillis)
+        var decodedAllowance: PayloadLease? = null
+        var authenticated: ScopedAuthorizedRequest? = null
+        var resultAllowance: PayloadLease? = null
+        var metadata: PayloadLease? = null
+        var hasExecutionSlot = false
+        var record: Record? = null
+        var encoded: EncodedReply? = null
+        try {
+            decodedAllowance = budget.tryReserve(4L * body.size + 32_768) ?: return
+            try {
+                withTimeout(deadline.remainingMillis.coerceAtLeast(1)) {
+                    authenticated = procedure.authenticate(request, body, budget, checkNotNull(decodedAllowance))
+                }
+            } catch (_: TimeoutCancellationException) { return
+            } catch (cancelled: CancellationException) { throw cancelled
+            } catch (_: Exception) { return }
+            // The authorized closure now owns decoded Q, not the raw JSON/credential bytes.
+            message.release()
+            val proof = authenticated ?: return
+            if (proof.grant.binding != binding || isSealed || deadline.remainingMillis <= 0) return
+            if (!scopedAuthorize(disclose, request, proof.grant, ScopedRpcDisclosurePhase.Request, deadline)) return
+
+            // Only independently authenticated ORIGINAL Q can reach either of these dedup lookups.
+            val first = lock.withLock { inspect(request, proof.grant, deadline) }
+            if (first !is Admission.Fresh) {
+                proof.release()
+                authenticated = null
+                respondToAdmission(first, request, proof.grant, deadline)
+                return
+            }
+            if (!executions.tryAcquire()) {
+                proof.release()
+                authenticated = null
+                respondToAdmission(Admission.Full, request, proof.grant, deadline)
+                return
+            }
+            hasExecutionSlot = true
+            metadata = budget.tryReserve(RECORD_ALLOWANCE)
+            resultAllowance = budget.tryReserve(RpcBodyCodec.encodingAllowance(procedure.resultLimit))
+            if (metadata == null || resultAllowance == null) {
+                proof.release()
+                authenticated = null
+                respondToAdmission(Admission.Full, request, proof.grant, deadline)
+                return
+            }
+            val decision = lock.withLock {
+                val again = inspect(request, proof.grant, deadline)
+                if (again is Admission.Fresh) {
+                    Record(request, proof.grant, deadline, checkNotNull(metadata)).also {
+                        records[message.id] = it
+                        record = it
+                    }
+                }
+                again
+            }
+            if (decision !is Admission.Fresh) {
+                proof.release()
+                authenticated = null
+                respondToAdmission(decision, request, proof.grant, deadline)
+                return
+            }
+            metadata = null // The lifetime tombstone (or active worker after seal) owns this lease.
+            val accepted = checkNotNull(record)
+            var failure: WireFailure? = null
+            try {
+                currentCoroutineContext().ensureActive()
+                if (isSealed || deadline.remainingMillis <= 0) {
+                    failure = WireFailure.DeadlineBeforeStart
+                } else {
+                    withTimeout(deadline.remainingMillis) {
+                        // Assignment is INSIDE the timeout so a late result cannot lose its payload lease.
+                        encoded = proof.execute(ScopedRpcCallContext(request.atDeadline(deadline), proof.grant),
+                            checkNotNull(resultAllowance))
+                    }
+                    if (deadline.remainingMillis <= 0) failure = WireFailure.Deadline
+                }
+            } catch (_: TimeoutCancellationException) {
+                failure = WireFailure.Deadline
+            } catch (cancelled: CancellationException) {
+                if (!currentCoroutineContext().isActive) throw cancelled
+                failure = WireFailure.HandlerFailed
+            } catch (_: Exception) {
+                failure = WireFailure.HandlerFailed
+            } finally {
+                // A non-cooperative handler still holds its call slot/Q allowance until ACTUAL exit.
+                proof.release()
+                authenticated = null
+                if (encoded != null) resultAllowance = null // OwnedBytes now owns the shrunk reservation.
+            }
+            if (failure != null) {
+                encoded?.body?.release()
+                encoded = null
+            }
+            val reply = WireMessage(encoded?.kind ?: WireKind.Failure, message.id, incarnation,
+                procedure.name, procedure.version, code = failure?.code ?: 0, body = encoded?.body)
+            encoded = null // reply owns the encoded payload on every send/cache/cancellation path.
+            try {
+                complete(accepted, reply)
+                respond(Response(accepted.request, accepted.grant, reply), accepted.deadline)
+            } finally { reply.release() }
+        } finally {
+            message.release()
+            authenticated?.release()
+            encoded?.body?.release()
+            decodedAllowance?.release()
+            resultAllowance?.release()
+            metadata?.release()
+            val accepted = record
+            if (accepted != null) {
+                val retired = withContext(NonCancellable) {
+                    lock.withLock {
+                        accepted.workerActive = false
+                        // Unexpected cancellation is a tombstone, never permission to execute again.
+                        if (accepted.running) {
+                            accepted.running = false
+                            accepted.kind = WireKind.Failure
+                            accepted.code = WireFailure.HandlerFailed.code
+                        }
+                        accepted.retired
+                    }
+                }
+                if (retired) accepted.metadata.release()
+            }
+            if (hasExecutionSlot) executions.release()
+        }
+    }
+
+    /** Own the lock. No application callback, budget observer, timer, or suspension is invoked here. */
+    private fun inspect(
+        request: ScopedRpcRequestContext,
+        grant: ScopedRpcRequestGrant,
+        deadline: ScopedDeadline,
+    ): Admission {
+        if (sealed.value || link.isSealed || deadline.remainingMillis <= 0) return Admission.Drop
+        recordLookups++
+        val previous = records[request.requestId.value]
+        if (previous == null) return if (records.size >= limits.records) Admission.Full else Admission.Fresh
+        if (previous.request.procedureName != request.procedureName ||
+            previous.request.procedureVersion != request.procedureVersion ||
+            previous.request.requestDigest != request.requestDigest || previous.grant != grant
+        ) return Admission.Drop // No existence-dependent error, mutation, proof replacement, or reexecution.
+        val kind = when {
+            previous.running -> WireKind.Running
+            previous.kind == WireKind.Failure -> WireKind.Failure
+            previous.cached != null -> previous.kind
+            else -> WireKind.Failure
+        }
+        val code = when {
+            previous.running -> 0
+            previous.kind == WireKind.Failure -> previous.code
+            previous.cached == null -> WireFailure.ResultUnavailable.code
+            else -> 0
+        }
+        val response = WireMessage(kind, request.requestId.value, incarnation, request.procedureName,
+            request.procedureVersion, code = code, body = previous.cached?.retain())
+        return Admission.Duplicate(Response(previous.request, previous.grant, response))
+    }
+
+    private suspend fun respondToAdmission(
+        admission: Admission,
+        request: ScopedRpcRequestContext,
+        grant: ScopedRpcRequestGrant,
+        deadline: ScopedDeadline,
+    ) {
+        val response = when (admission) {
+            is Admission.Duplicate -> admission.response
+            Admission.Full -> Response(request, grant, WireMessage(WireKind.Failure, request.requestId.value,
+                incarnation, request.procedureName, request.procedureVersion, code = WireFailure.Overloaded.code))
+            else -> return
+        }
+        try { respond(response, deadline) } finally { response.message.release() }
+    }
+
+    private suspend fun complete(record: Record, reply: WireMessage) {
+        val cacheAllowance = reply.body?.let { cache?.tryReserve(it.size.toLong() + 256) }
+        var retained = false
+        try {
+            lock.withLock {
+                if (sealed.value || record.retired) return@withLock
+                record.running = false
+                record.kind = reply.kind
+                record.code = reply.code
+                if (cacheAllowance != null) {
+                    record.cached = reply.body.retain()
+                    record.cacheAllowance = cacheAllowance
+                    retained = true
+                }
+            }
+        } finally { if (!retained) cacheAllowance?.release() }
+    }
+
+    private suspend fun respond(response: Response, deadline: ScopedDeadline) {
+        if (isSealed || !scopedAuthorize(disclose, response.request, response.grant,
+                ScopedRpcDisclosurePhase.Response, deadline)
+        ) return
+        currentCoroutineContext().ensureActive()
+        try { link.offer(response.message, deadline) } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            // Cache/tombstone remains. There is no less-protected generic error or alternate transport.
+        }
+    }
+
+    private suspend fun invalidate(): Unit = withContext(NonCancellable) {
+        val releases = mutableListOf<() -> Unit>()
+        lock.withLock {
+            if (sealed.value) return@withLock
+            sealed.value = true
+            ready = false
+            records.values.forEach { record ->
+                record.retired = true
+                record.cached?.let { releases.add(it::release) }
+                record.cached = null
+                record.cacheAllowance?.let { releases.add(it::release) }
+                record.cacheAllowance = null
+                if (!record.workerActive) releases.add(record.metadata::release)
+            }
+            records.clear()
+        }
+        releases.forEach { it() }
+        scope.cancel()
+    }
+
+    suspend fun seal() {
+        link.seal()
+        invalidate()
+    }
+
+    suspend fun close() {
+        seal()
+        link.close()
+    }
+
+    internal suspend fun snapshot(): ScopedHostSnapshot = lock.withLock {
+        ScopedHostSnapshot(records.size, limits.calls - executions.availablePermits, recordLookups)
+    }
+
+    private companion object {
+        const val RECORD_ALLOWANCE = 4_096L
+    }
+}
