+    private class Fixture(
+        testScope: TestScope,
+        restricted: Boolean = true,
+        secure: Boolean = true,
+        helloComplete: Boolean = true,
+        verifiedFingerprint: Boolean = true,
+        admission: PeerAdmission = PeerAdmission.Trusted,
+        protocolLimit: Int? = MAX_MESSAGE,
+        matchingHelloIdentity: Boolean = true,
+        holdBeforeCommit: Boolean = false,
+        holdProtocolOutput: Boolean = false,
+        holdAfterFirstFrame: Boolean = false,
+        holdBeforeRearmClose: Boolean = false,
+        holdCloseOutput: Boolean = false,
+        holdAfterTerminalClaim: Boolean = false,
+    ) {
+        val supervisor = SupervisorJob(testScope.backgroundScope.coroutineContext[Job])
+        val scope = CoroutineScope(StandardTestDispatcher(testScope.testScheduler) + supervisor)
+        val wallClock = MutableStateFlow(10_000L)
+        val monotonic = MutableStateFlow(1_000L)
+        val budget = PayloadBudget(16L * 1_048_576)
+        private val profile = P2pSessionProfile({ admission }, budget, 1, maxApplicationBytes = MAX_MESSAGE)
+        val initialPair = FakeConnectionPair()
+        val replacementPair = FakeConnectionPair()
+        val initial = ChunkHoldingConnection(initialPair.a, holdAfterFirstFrame)
+        val beforeCommit = Pause()
+        val beforeRearmClose = Pause()
+        val afterTerminalClaim = Pause()
+        val events = Channel<ProtocolEvent>(Channel.UNLIMITED, onUndeliveredElement = ProtocolEvent::release)
+        val protocol = HeldProtocol(
+            DefaultP2pProtocol(
+                clock = { wallClock.value }, version = ProtocolConstants.SECURE_VERSION,
+                sessionProfile = if (restricted) profile else null,
+            ),
+            holdProtocolOutput, holdCloseOutput,
+        )
+        private val peer = Peer(PeerId("scoped-peer"), "Peer", Platform.JVM_DESKTOP, setOf(TransportKind.LAN))
+        private val initialProtocolState = ProtocolSessionState(
+            "scoped-local", secure, restrictedApplicationBytes = protocolLimit,
+        ).also {
+            if (helloComplete) {
+                it.completeHello(
+                    if (matchingHelloIdentity) peer.id.value else "different-peer",
+                    ProtocolFeatures.SECURE_V2,
+                )
+            }
+        }
+        val session = P2pSessionImpl(
+            id = "same-public-id", peer = peer,
+            peerIdentity = PeerIdentity(
+                peer.id, if (verifiedFingerprint) PeerFingerprint.fromDigest(ByteArray(32) { 7 }) else null,
+            ),
+            initialConnection = initial, initialEvents = events, initialProtocolState = initialProtocolState,
+            protocol = protocol, parentScope = scope,
+            keepAlive = KeepAliveConfig(60_000, 120_000), clock = { wallClock.value },
+            monotonicClock = { monotonic.value }, logger = P2pLogger.NoOp,
+            sessionProfile = if (restricted) profile else null, admittedAs = admission,
+            beforeScopedDisclosureCommitForTest = if (holdBeforeCommit) beforeCommit::waitHere else null,
+            beforeRearmRawCloseForTest = if (holdBeforeRearmClose) beforeRearmClose::waitHere else null,
+            afterTerminalClaimForTest = if (holdAfterTerminalClaim) afterTerminalClaim::waitHere else null,
+        ).also { it.start() }
+
+        suspend fun rearm(state: ProtocolSessionState = replacementState()): Boolean = session.rearmWith(
+            replacementPair.a, Channel(Channel.UNLIMITED, onUndeliveredElement = ProtocolEvent::release), state,
+        )
+
+        private fun replacementState(): ProtocolSessionState = ProtocolSessionState(
+            "scoped-local", true, restrictedApplicationBytes = MAX_MESSAGE,
+        ).also { it.completeHello(peer.id.value, ProtocolFeatures.SECURE_V2) }
+
+        fun releaseAndCancel() {
+            beforeCommit.release.complete(Unit)
+            beforeRearmClose.release.complete(Unit)
+            afterTerminalClaim.release.complete(Unit)
+            protocol.beforeOutput.release.complete(Unit)
+            protocol.beforeClose.release.complete(Unit)
+            initial.afterFirstFrame.release.complete(Unit)
+            supervisor.cancel()
+            initialPair.a.breakWith()
+            initialPair.b.breakWith()
+            replacementPair.a.breakWith()
+            replacementPair.b.breakWith()
+        }
+    }
+
+    private class HeldProtocol(
+        private val delegate: P2pProtocol,
+        private val holdOutput: Boolean,
+        private val holdClose: Boolean,
+    ) : P2pProtocol by delegate {
+        val beforeOutput = Pause()
+        val beforeClose = Pause()
+        val targets = mutableListOf<RawConnection>()
+
+        override suspend fun sendMessage(
+            connection: RawConnection,
+            message: P2pMessage,
+            sessionState: ProtocolSessionState,
+        ) {
+            targets += connection
+            if (holdOutput) beforeOutput.waitHere()
+            delegate.sendMessage(connection, message, sessionState)
+        }
+
+        override suspend fun sendClose(connection: RawConnection) {
+            if (holdClose) beforeClose.waitHere()
+            delegate.sendClose(connection)
+        }
+    }
+
+    private class ChunkHoldingConnection(
+        private val delegate: RawConnection,
+        private val holdAfterFirst: Boolean,
+    ) : RawConnection by delegate {
+        val afterFirstFrame = Pause()
+
+        override suspend fun write(bytes: ByteArray) {
+            delegate.write(bytes)
+            if (holdAfterFirst) {
+                val frame = FrameCodec.decode(bytes, ProtocolConstants.SECURE_VERSION)
+                if (frame.type == PacketType.DATA && frame.chunkIndex == 0) afterFirstFrame.waitHere()
+            }
+        }
+    }
+
+    @Suppress("OVERRIDE_DEPRECATION")
+    private class UnsupportedSession : P2pSession {
+        override val id = "unsupported"
+        override val peer = Peer(PeerId("unsupported"), "Peer", Platform.JVM_DESKTOP, setOf(TransportKind.LAN))
+        override val state = MutableStateFlow(ConnectionState.Connected)
+        override val incoming = MutableSharedFlow<P2pMessage>()
+        override val incomingFiles = MutableSharedFlow<P2pFileOffer>()
+        var bareSends = 0
+
+        override suspend fun send(message: P2pMessage) {
+            bareSends++
+        }
+
+        override suspend fun sendFile(
+            name: String, sizeBytes: Long, mimeType: String?, source: RawSource,
+        ): P2pFileTransfer = error("not used")
+
+        override suspend fun close() = Unit
+    }
+
+    private fun TestScope.dispose(fixture: Fixture) {
+        fixture.releaseAndCancel()
+        runAtCurrentTimeUntil { fixture.supervisor.isCompleted }
+    }
+
+    private fun TestScope.runAtCurrentTimeUntil(ready: () -> Boolean) {
+        // Real cleanup dispatchers must settle without silently advancing virtual auth/close deadlines.
+        // The real timeout is only a harness deadlock guard, never the behavior being asserted.
+        runBlocking(Dispatchers.Default) {
+            withTimeout(5_000L) {
+                while (!ready()) {
+                    testScheduler.runCurrent()
+                    yield()
+                }
+            }
+        }
+    }
+
+    private fun binary(): P2pMessage.Binary = P2pMessage.Binary(byteArrayOf(1))
+
+    private companion object {
+        const val MAX_MESSAGE = 1_048_576
+    }
+}
