@@ -0,0 +1,75 @@
+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.core.ConnectionState
+import dev.p2pkit.core.P2pDisclosureTicket
+import dev.p2pkit.core.P2pMessage
+import dev.p2pkit.core.P2pSession
+import dev.p2pkit.core.Peer
+import dev.p2pkit.core.PeerId
+import dev.p2pkit.core.PeerIdentity
+import dev.p2pkit.core.Platform
+import dev.p2pkit.core.SessionConnectionInfo
+import dev.p2pkit.core.TransportKind
+import dev.p2pkit.core.transfer.P2pFileOffer
+import dev.p2pkit.core.transfer.P2pFileTransfer
+import dev.p2pkit.rpc.RpcFailure
+import dev.p2pkit.rpc.RpcFailureKind
+import dev.p2pkit.rpc.ScopedRpcClientSession
+import dev.p2pkit.rpc.ScopedRpcHostSession
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.test.runTest
+import kotlinx.io.RawSource
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+
+/** Looks connected/trusted to legacy API, but has NO genuine SDK initial-lifetime capability. */
+private class UnsupportedScopedSession : P2pSession {
+    override val id = "synthetic-unsupported-session"
+    override val peer = Peer(PeerId("synthetic-peer"), "fixture", Platform.UNKNOWN, setOf(TransportKind.LAN))
+    override val peerIdentity = PeerIdentity(peer.id, testFingerprint())
+    override val state = MutableStateFlow(ConnectionState.Connected)
+    override val connectionInfo = MutableStateFlow(SessionConnectionInfo(1))
+    override val incoming = MutableSharedFlow<P2pMessage>()
+    @Deprecated("Observe pendingFileOffers")
+    override val incomingFiles = MutableSharedFlow<P2pFileOffer>()
+    var sends = 0
+    var scopedSends = 0
+    var closes = 0
+    override suspend fun send(message: P2pMessage) { sends++ }
+    override suspend fun sendAtGeneration(message: P2pMessage, generation: Long) { sends++ }
+    override suspend fun sendScoped(ticket: P2pDisclosureTicket) { scopedSends++ }
+    @Deprecated("Scoped RPC has no file transfer fallback")
+    override suspend fun sendFile(
+        name: String, sizeBytes: Long, mimeType: String?, source: RawSource,
+    ): P2pFileTransfer = error("No file transfer")
+    override suspend fun close() { closes++ }
+}
+
+class ScopedRpcSessionRefusalTest {
+    @Test
+    fun unsupportedHostSessionFailsClaimBeforeAnyApplicationHelloReadyOrLegacySend() = runTest {
+        val session = UnsupportedScopedSession()
+        val failure = assertFailsWith<RpcFailure> {
+            ScopedRpcHostSession.create(session, SCOPED_BINDING, backgroundScope) {}
+        }
+        assertEquals(RpcFailureKind.NotConnected, failure.kind)
+        assertEquals(0, session.sends)
+        assertEquals(0, session.scopedSends)
+        assertEquals(0, session.closes) // Failed claim did not take ownership of another caller's session.
+    }
+
+    @Test
+    fun unsupportedDelegatingClientSessionHasNoBareSendOrPairingFallback() = runTest {
+        val target = UnsupportedScopedSession()
+        val wrapper = object : P2pSession by target {}
+        val failure = assertFailsWith<RpcFailure> {
+            ScopedRpcClientSession.create(wrapper, SCOPED_BINDING, backgroundScope) {}
+        }
+        assertEquals(RpcFailureKind.NotConnected, failure.kind)
+        assertEquals(0, target.sends)
+        assertEquals(0, target.scopedSends)
+        assertEquals(0, target.closes)
+    }
+}
diff --git a/library/p2p-rpc/src/commonTest/kotlin/dev/p2pkit/rpc/internal/ScopedRpcTestLink.kt b/library/p2p-rpc/src/commonTest/kotlin/dev/p2pkit/rpc/internal/ScopedRpcTestLink.kt
new file mode 100644
index 0000000000000000000000000000000000000000..939fcebed9a691f427be30f82dce0f25bc0b1595
--- /dev/null
+++ b/library/p2p-rpc/src/commonTest/kotlin/dev/p2pkit/rpc/internal/ScopedRpcTestLink.kt
@@ -0,0 +1,284 @@
+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.core.PayloadBudget
+import dev.p2pkit.core.PayloadLease
+import dev.p2pkit.core.PeerId
+import dev.p2pkit.core.PeerIdentity
+import dev.p2pkit.rpc.RpcFailure
+import dev.p2pkit.rpc.RpcFailureKind
+import dev.p2pkit.rpc.RpcFailurePhase
+import dev.p2pkit.rpc.ScopedRpcBinding
+import dev.p2pkit.rpc.ScopedRpcHostConfiguration
+import dev.p2pkit.rpc.ScopedRpcRequestGrant
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CompletableDeferred
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+internal val SCOPED_BINDING = ScopedRpcBinding("branch-a", "actor-a", "session-a", "retail", "cashier-a")
+internal val SCOPED_OTHER_BINDING = SCOPED_BINDING.copy(actorId = "actor-b", applicationSessionId = "session-b")
+internal fun scopedGrant(binding: ScopedRpcBinding = SCOPED_BINDING): ScopedRpcRequestGrant =
+    ScopedRpcRequestGrant(binding, "fixture-resource")
+
+/** Two independently advanceable clocks prove that no coroutine timer/local hint grants core commitment. */
+internal class ScopedTestClock(var local: Long = 0, var core: Long = 0) {
+    fun advance(millis: Long) { local += millis; core += millis }
+}
+
+/**
+ * Test-only logical gate/transport model, NOT proof of SDK/native behavior. Public factories cannot
+ * accept this seam. Core's own tests qualify its opaque authority; platform/native gates remain open.
+ */
+internal class ScopedRpcTestLink(
+    private val scope: CoroutineScope,
+    private val budget: PayloadBudget,
+    val clock: ScopedTestClock,
+    binding: ScopedRpcBinding = SCOPED_BINDING,
+    private val maximumEntries: Int = 24,
+) : ScopedRpcLink {
+    private inner class Deadline(
+        val beganCore: Long,
+        val beganLocal: Long,
+        val allowance: Long,
+    ) : ScopedDeadline {
+        val owner: ScopedRpcTestLink get() = this@ScopedRpcTestLink
+        override val remainingMillis: Long get() {
+            val elapsed = clock.local - beganLocal
+            return if (elapsed < 0 || elapsed >= allowance) 0 else allowance - elapsed
+        }
+        override fun limitTo(validForMillis: Long): ScopedDeadline {
+            require(validForMillis in 1..30_000L)
+            return Deadline(beganCore, beganLocal, minOf(allowance, validForMillis))
+        }
+    }
+
+    private inner class Ticket(var payload: OwnedBytes?, val deadline: Deadline) : ScopedSendTicket {
+        override var hasCommitted = false
+        override val completion = CompletableDeferred<Boolean>()
+        var done = false
+        override suspend fun cancelBeforeCommit(): Boolean = withContext(NonCancellable) {
+            beforeTicketCancellation()
+            val release = gate.withLock {
+                if (done || hasCommitted) return@withLock null
+                done = true
+                queued.remove(this@Ticket)
+                tickets.remove(this@Ticket)
+                payload.also { payload = null }
+            } ?: return@withContext false
+            release.release()
+            completion.complete(false)
+            true
+        }
+    }
+
+    private inner class Publication(val deadline: Deadline, val allowance: PayloadLease) : ScopedPublication {
+        var done = false
+        override suspend fun tryCommit(): Boolean {
+            beforePublicationCommit()
+            val accepted = gate.withLock {
+                if (done || isSealed || expired(deadline)) false else {
+                    done = true
+                    publications.remove(this@Publication)
+                    publicationCommits++
+                    true
+                }
+            }
+            if (accepted) allowance.release()
+            return accepted
+        }
+        override suspend fun cancelBeforeCommit(): Boolean {
+            val cancelled = gate.withLock {
+                if (done) false else {
+                    done = true
+                    publications.remove(this@Publication)
+                    true
+                }
+            }
+            if (cancelled) allowance.release()
+            return cancelled
+        }
+    }
+
+    private val gate = Mutex()
+    private val tickets = mutableSetOf<Ticket>()
+    private val queued = mutableListOf<Ticket>()
+    private val publications = mutableSetOf<Publication>()
+    private val evidenceBudget = PayloadBudget(16L * 1_048_576)
+    private val bindingDigest = ScopedRpcWire.bindingDigest(binding)
+    private var receiveCallback: suspend (ScopedPacket, ScopedDeadline) -> Unit = { _, _ -> }
+    private var sealedCallback: suspend () -> Unit = {}
+    private var started = false
+    override val identity = PeerIdentity(PeerId("scoped-fixture-peer"), testFingerprint())
+    override var isSealed = false
+        private set
+    val sent = mutableListOf<WireMessage>()
+    var paused = false
+    var beforeSendCommit: suspend () -> Unit = {}
+    var afterSendCommit: suspend () -> Unit = {}
+    var beforePublicationCommit: suspend () -> Unit = {}
+    var beforeTicketCancellation: suspend () -> Unit = {}
+    var onSend: suspend (WireMessage) -> Unit = {}
+    var failCommittedSend = false
+    var closeFailure = false
+    var closeAttempts = 0
+    var deadlineCaptures = 0
+    var publicationCommits = 0
+    var offeredInvocations = 0
+    val queuedCount: Int get() = queued.size
+
+    override fun deadlineAfter(validForMillis: Long): ScopedDeadline {
+        require(validForMillis in 1..30_000L)
+        deadlineCaptures++
+        return Deadline(clock.core, clock.local, validForMillis)
+    }
+
+    private fun own(deadline: ScopedDeadline): Deadline {
+        require(deadline is ScopedRpcTestLink.Deadline && deadline.owner === this)
+        return deadline
+    }
+
+    private fun expired(deadline: Deadline): Boolean {
+        val elapsed = clock.core - deadline.beganCore
+        return elapsed < 0 || elapsed >= deadline.allowance
+    }
+
+    override fun start(
+        onMessage: suspend (ScopedPacket, ScopedDeadline) -> Unit,
+        onSealed: suspend () -> Unit,
+    ) {
+        check(!started && !isSealed)
+        started = true
+        receiveCallback = onMessage
+        sealedCallback = onSealed
+    }
+
+    /** Copies ingress ownership into the receiving budget, as the production decoder does. */
+    suspend fun receive(message: WireMessage, digest: String = bindingDigest) {
+        val boundary = deadlineAfter(30_000)
+        val received = message.copy(body = message.body?.let { OwnedBytes.copy(it.bytes, budget) })
+        try { receiveCallback(ScopedPacket(digest, received), boundary) } finally { received.release() }
+    }
+
+    override suspend fun offer(message: WireMessage, deadline: ScopedDeadline): ScopedSendTicket? {
+        val original = own(deadline)
+        if (message.kind == WireKind.Invoke) offeredInvocations++
+        if (isSealed || expired(original) || tickets.size >= maximumEntries) return null
+        // Immutable FULL scoped encoding happens now, not after a paused queue/policy switch.
+        val payload = OwnedBytes.copy(ScopedRpcWire.encode(bindingDigest, message), budget)
+        val ticket = Ticket(payload, original)
+        val accepted = gate.withLock {
+            if (isSealed || expired(original) || tickets.size >= maximumEntries) false else {
+                tickets.add(ticket)
+                queued.add(ticket)
+                true
+            }
+        }
+        if (!accepted) { payload.release(); return null }
+        if (!paused) scope.launch { deliver(ticket) }
+        return ticket
+    }
+
+    private suspend fun deliver(ticket: Ticket) {
+        if (!gate.withLock { queued.remove(ticket) }) return
+        var success = false
+        try {
+            beforeSendCommit()
+            val committedPayload = gate.withLock {
+                if (ticket.done || ticket.hasCommitted || isSealed || expired(ticket.deadline)) null else {
+                    ticket.hasCommitted = true
+                    ticket.payload
+                }
+            }
+            val payload = committedPayload ?: return
+            afterSendCommit()
+            if (failCommittedSend) throw IllegalStateException("synthetic transport failure")
+            val decoded = ScopedRpcWire.decode(payload.bytes, evidenceBudget).message
+            try {
+                sent.add(decoded.retained())
+                onSend(decoded)
+                success = true
+            } finally { decoded.release() }
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            // The model reports local completion and preserves committed ambiguity.
+        } finally {
+            withContext(NonCancellable) {
+                val release = gate.withLock {
+                    queued.remove(ticket)
+                    tickets.remove(ticket)
+                    ticket.done = true
+                    ticket.payload.also { ticket.payload = null }
+                }
+                release?.release()
+                ticket.completion.complete(success)
+            }
+        }
+    }
+
+    suspend fun flush() { queued.toList().forEach { deliver(it) } }
+
+    override suspend fun preparePublication(deadline: ScopedDeadline): ScopedPublication {
+        val original = own(deadline)
+        val allowance = budget.reserve(512)
+        var retained = false
+        try {
+            return gate.withLock {
+                if (isSealed || expired(original) || tickets.size + publications.size >= 32) scopedDenied()
+                Publication(original, allowance).also { publications.add(it); retained = true }
+            }
+        } finally { if (!retained) allowance.release() }
+    }
+
+    override suspend fun seal(): Unit = withContext(NonCancellable) {
+        val changed = gate.withLock {
+            if (isSealed) false else { isSealed = true; true }
+        }
+        tickets.toList().forEach { it.cancelBeforeCommit() }
+        publications.toList().forEach { it.cancelBeforeCommit() }
+        if (changed) sealedCallback()
+    }
+
+    override suspend fun close() {
+        seal()
+        closeAttempts++
+        if (closeFailure) throw RpcFailure(RpcFailureKind.Closed, RpcFailurePhase.Admission)
+    }
+
+    fun clearSent() { sent.forEach { it.release() }; sent.clear() }
+}
+
+internal class ScopedHostFixture(
+    scope: CoroutineScope,
+    val configuration: ScopedRpcHostConfiguration,
+    val clock: ScopedTestClock = ScopedTestClock(),
+    val binding: ScopedRpcBinding = SCOPED_BINDING,
+) {
+    val budget = PayloadBudget(configuration.limits.payloadBytes)
+    val link = ScopedRpcTestLink(scope, budget, clock, binding)
+    val host = ScopedRpcHostEngine(scope, link, binding, configuration.procedures.toMap(), configuration.limits,
+        configuration.disclose, budget, TEST_INCARNATION)
+
+    suspend fun start() {
+        host.start()
+        link.receive(WireMessage(WireKind.Hello, TEST_SECOND))
+    }
+
+    suspend fun invoke(
+        json: String = "\"valid\"",
+        id: String = TEST_REQUEST,
+        name: String = "scoped.echo",
+        budgetMillis: Int = 10_000,
+        digest: String = ScopedRpcWire.bindingDigest(binding),
+    ) {
+        val message = WireMessage(WireKind.Invoke, id, TEST_INCARNATION, name, 1, budgetMillis, 1,
+            body = testBody(json, budget))
+        try { link.receive(message, digest) } finally { message.release() }
+    }
+
+    suspend fun close() { host.close(); link.clearSent() }
+}
