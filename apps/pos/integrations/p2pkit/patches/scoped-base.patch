+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.core.PayloadBudget
+import dev.p2pkit.rpc.RpcFailure
+import dev.p2pkit.rpc.RpcProcedure
+import dev.p2pkit.rpc.ScopedRpcBinding
+import dev.p2pkit.rpc.ScopedRpcLimits
+import dev.p2pkit.rpc.ScopedRpcProcedure
+import kotlinx.serialization.builtins.serializer
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertFalse
+import kotlin.test.assertNotEquals
+import kotlin.test.assertTrue
+
+class ScopedRpcWireTest {
+    @Test
+    fun profileIsExplicitlyIncompatibleWithLegacyInBothDirections() {
+        val budget = PayloadBudget(1_048_576)
+        val hello = WireMessage(WireKind.Hello, TEST_REQUEST)
+        val scoped = ScopedRpcWire.encode(ScopedRpcWire.bindingDigest(SCOPED_BINDING), hello)
+        assertFailsWith<RpcFailure> { RpcWire.decode(scoped, budget) }
+        assertFailsWith<RpcFailure> { ScopedRpcWire.decode(RpcWire.encode(hello), budget) }
+        val decoded = ScopedRpcWire.decode(scoped, budget)
+        assertEquals(ScopedRpcWire.bindingDigest(SCOPED_BINDING), decoded.bindingDigest)
+        assertEquals(WireKind.Hello, decoded.message.kind)
+        decoded.message.release()
+        assertEquals(0L, budget.retainedBytes.value)
+    }
+
+    @Test
+    fun unknownProfileCapabilityVersionAndReservedBitsFailClosed() {
+        val budget = PayloadBudget(1_048_576)
+        val original = ScopedRpcWire.encode(ScopedRpcWire.bindingDigest(SCOPED_BINDING),
+            WireMessage(WireKind.Hello, TEST_REQUEST))
+        for (offset in listOf(0, 4, 5, 6, 7)) {
+            val altered = original.copyOf()
+            altered[offset] = (altered[offset].toInt() xor 0x40).toByte()
+            assertFailsWith<RpcFailure> { ScopedRpcWire.decode(altered, budget) }
+        }
+        assertEquals(0L, budget.retainedBytes.value)
+    }
+
+    @Test
+    fun bindingHashIsFramedAndIncludesEveryIndependentApplicationField() {
+        val original = ScopedRpcWire.bindingDigest(SCOPED_BINDING)
+        val changes = listOf(
+            SCOPED_BINDING.copy(scopeId = "branch-b"),
+            SCOPED_BINDING.copy(actorId = "actor-b"),
+            SCOPED_BINDING.copy(applicationSessionId = "session-b"),
+            SCOPED_BINDING.copy(purpose = "return"),
+            SCOPED_BINDING.copy(projectionId = "supervisor"),
+        )
+        changes.forEach { assertNotEquals(original, ScopedRpcWire.bindingDigest(it)) }
+        assertNotEquals(ScopedRpcWire.bindingDigest(SCOPED_BINDING.copy(scopeId = "ab", actorId = "c")),
+            ScopedRpcWire.bindingDigest(SCOPED_BINDING.copy(scopeId = "a", actorId = "bc")))
+        assertEquals(64, original.length)
+    }
+
+    @Test
+    fun scopedEncoderCannotSendControlsPairingEnrollmentOrAdditionalInvokeAttempts() {
+        val digest = ScopedRpcWire.bindingDigest(SCOPED_BINDING)
+        val forbidden = listOf(WireKind.Status, WireKind.Cancel, WireKind.Receipt, WireKind.Notify,
+            WireKind.PairRequest, WireKind.PairPending, WireKind.PairApproved, WireKind.PairDenied,
+            WireKind.RequestApproval)
+        forbidden.forEach { kind ->
+            assertFailsWith<RpcFailure> {
+                ScopedRpcWire.encode(digest, WireMessage(kind, TEST_REQUEST, TEST_INCARNATION))
+            }
+        }
+        assertFailsWith<RpcFailure> {
+            ScopedRpcWire.encode(digest, WireMessage(WireKind.Ready, TEST_REQUEST, TEST_INCARNATION, code = 2))
+        }
+        val budget = PayloadBudget(1_048_576)
+        val retry = WireMessage(WireKind.Invoke, TEST_REQUEST, TEST_INCARNATION, "scoped.echo", 1, 1_000, 2,
+            body = testBody("\"valid\"", budget))
+        try { assertFailsWith<RpcFailure> { ScopedRpcWire.encode(digest, retry) } } finally { retry.release() }
+        assertEquals(0L, budget.retainedBytes.value)
+    }
+
+    @Test
+    fun aggregatePacketCeilingDoesNotPermitAnOversizedIndividualBody() {
+        val budget = PayloadBudget(1_048_576)
+        val digest = ScopedRpcWire.bindingDigest(SCOPED_BINDING)
+        val header = ScopedRpcWire.encode(digest, WireMessage(WireKind.Hello, TEST_REQUEST))
+            .copyOfRange(0, ScopedRpcWire.HEADER_BYTES)
+        val body = OwnedBytes.copy(ByteArray(65_537) { 32 }, budget)
+        val invocation = WireMessage(WireKind.Invoke, TEST_REQUEST, TEST_INCARNATION, "a", 1, 1_000, 1, body = body)
+        try {
+            val packet = header + RpcWire.encode(invocation)
+            assertTrue(packet.size <= ScopedRpcWire.MAX_PACKET_BYTES)
+            val before = budget.retainedBytes.value
+            assertFailsWith<RpcFailure> { ScopedRpcWire.decode(packet, budget) }
+            assertEquals(before, budget.retainedBytes.value)
+            assertFailsWith<RpcFailure> { ScopedRpcWire.encode(digest, invocation) }
+        } finally { invocation.release() }
+        assertEquals(0L, budget.retainedBytes.value)
+    }
+
+    @Test
+    fun scopedDescriptorsAreNotLegacyDescriptorsAndPublicBoundsAreExplicit() {
+        val descriptor: Any = ScopedRpcProcedure("scoped.echo", 1, String.serializer(), String.serializer(),
+            String.serializer())
+        assertFalse(descriptor is RpcProcedure<*, *, *>)
+        assertFailsWith<IllegalArgumentException> {
+            ScopedRpcProcedure("scoped.echo", 1, String.serializer(), String.serializer(), String.serializer(),
+                requestLimitBytes = 65_537)
+        }
+        assertFailsWith<IllegalArgumentException> { ScopedRpcLimits(calls = 9) }
+        assertFailsWith<IllegalArgumentException> { ScopedRpcLimits(sendQueue = 25) }
+        assertFailsWith<IllegalArgumentException> { ScopedRpcLimits(records = 1_025) }
+        assertFailsWith<IllegalArgumentException> { ScopedRpcLimits(payloadBytes = 65_535, resultCacheBytes = 0) }
+        assertFailsWith<IllegalArgumentException> { ScopedRpcBinding("a\nb", "c", "d", "e", "f") }
+    }
+}
