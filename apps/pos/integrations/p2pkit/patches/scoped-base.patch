@@ -0,0 +1,175 @@
+package dev.p2pkit.rpc
+
+import dev.p2pkit.core.PeerIdentity
+import dev.p2pkit.rpc.internal.ScopedDeliveryOwner
+import dev.p2pkit.rpc.internal.ScopedRegisteredProcedure
+import dev.p2pkit.rpc.internal.scopedRegisteredProcedure
+import kotlinx.serialization.KSerializer
+
+/**
+ * Independently supplied LOCAL application identity for one initial physical session. None of these
+ * identifiers is a credential. Never put passwords, tokens, request bodies or private display text here.
+ * A policy/projection/credential/session change must seal the old runtime BEFORE becoming active, then
+ * use a genuinely fresh physical session. This value is never learned from an incoming packet.
+ */
+public data class ScopedRpcBinding(
+    public val scopeId: String,
+    public val actorId: String,
+    public val applicationSessionId: String,
+    public val purpose: String,
+    public val projectionId: String,
+) {
+    init { listOf(scopeId, actorId, applicationSessionId, purpose, projectionId).forEach(::scopedIdentifier) }
+    override fun toString(): String = "ScopedRpcBinding(identifiers omitted)"
+}
+
+/**
+ * Deliberately NOT an RpcProcedure: legacy register/call cannot accept a scoped descriptor. There is no
+ * conversion API, public/bootstrap flag, automatic retry, notification or unauthenticated error route.
+ * Login/refresh/credential replies, if implemented by the application, require the same original-Q
+ * proof and disclosure checks. A challenge lifetime never upgrades into an employee lifetime.
+ */
+public class ScopedRpcProcedure<Q, R, E>(
+    public val name: String,
+    public val version: Int,
+    public val request: KSerializer<Q>,
+    public val response: KSerializer<R>,
+    public val applicationError: KSerializer<E>,
+    public val requestLimitBytes: Int = 65_536,
+    public val responseLimitBytes: Int = 65_536,
+    public val errorLimitBytes: Int = 65_536,
+) {
+    init {
+        validateRpcName(name, version)
+        require(listOf(requestLimitBytes, responseLimitBytes, errorLimitBytes).all { it in 1..65_536 })
+    }
+    internal val key: String get() = "$name/$version"
+    override fun toString(): String = "ScopedRpcProcedure($key)"
+}
+
+/** Bounded policy allowances for ONE physical session, not a qualified 128-client host service. */
+public class ScopedRpcLimits(
+    public val calls: Int = 4,
+    public val records: Int = 128,
+    public val sendQueue: Int = 16,
+    public val payloadBytes: Long = 8L * 1_048_576,
+    public val resultCacheBytes: Long = 1_048_576,
+) {
+    init {
+        require(calls in 1..8 && records in calls..1_024 && sendQueue in 1..24)
+        require(payloadBytes in 65_536..(16L * 1_048_576))
+        require(resultCacheBytes in 0..minOf(payloadBytes, 4L * 1_048_576))
+    }
+}
+
+/** Library-derived identity of the actual received request, never an asserted caller digest. */
+public class ScopedRpcRequestContext internal constructor(
+    public val peer: PeerIdentity,
+    public val binding: ScopedRpcBinding,
+    public val requestId: RpcRequestId,
+    public val procedureName: String,
+    public val procedureVersion: Int,
+    public val requestDigest: String,
+    /** Remaining part of the window captured BEFORE decode/authorization; never a renewal. */
+    public val remainingMillis: Long,
+) {
+    override fun toString(): String = "ScopedRpcRequestContext(application identity omitted)"
+}
+
+/**
+ * Return ONLY after verifying the original typed Q credential/challenge and its exact target/purpose.
+ * This is a trusted application-adapter result, not SDK authentication or a serializable capability.
+ * disclosureKey is bounded NONSECRET metadata identifying the original resource/projection/policy cut
+ * needed for later current disclosure authorization. No raw Q, password, token or mutable proof is kept.
+ */
+public data class ScopedRpcRequestGrant(
+    public val binding: ScopedRpcBinding,
+    public val disclosureKey: String,
+) {
+    init { scopedIdentifier(disclosureKey, 256) }
+    override fun toString(): String = "ScopedRpcRequestGrant(binding omitted)"
+}
+
+public class ScopedRpcCallContext internal constructor(
+    public val request: ScopedRpcRequestContext,
+    public val grant: ScopedRpcRequestGrant,
+)
+
+public enum class ScopedRpcDisclosurePhase { Request, Response, Publication }
+
+/** Original immutable binding only; current state must be checked by the authoritative adapter. */
+public class ScopedRpcDisclosureContext internal constructor(
+    public val request: ScopedRpcRequestContext,
+    public val grant: ScopedRpcRequestGrant,
+    public val phase: ScopedRpcDisclosurePhase,
+) {
+    override fun toString(): String = "ScopedRpcDisclosureContext(application identity omitted)"
+}
+
+/**
+ * Must be cancellation-cooperative and consult current authority, not a saved login Boolean. Every
+ * affected runtime must be sealed before changing that authority. SDK deadlines are a second fence,
+ * not a substitute for this ordering. Exceptions/timeouts deny; there is no public-error fallback.
+ */
+public fun interface ScopedRpcDisclosureAuthorizer {
+    public suspend fun authorize(context: ScopedRpcDisclosureContext): Boolean
+}
+
+public class ScopedRpcHostConfiguration internal constructor() {
+    public var limits: ScopedRpcLimits = ScopedRpcLimits()
+    public var disclose: ScopedRpcDisclosureAuthorizer = ScopedRpcDisclosureAuthorizer { false }
+    internal val procedures: MutableMap<String, ScopedRegisteredProcedure> = mutableMapOf()
+
+    /**
+     * windowMillis is sampled BEFORE decoding Q or suspending authorization. It must conservatively
+     * cap the earliest credential/policy expiry for this fixed application binding (0 denies). There
+     * is no in-place token refresh. The typed authorizer must independently verify Q on EVERY original
+     * and duplicate, and reject any proof not valid throughout this window. A returned grant must match
+     * this runtime's independently supplied binding; duplicates must also match the ORIGINAL grant.
+     */
+    public fun <Q, R, E> register(
+        procedure: ScopedRpcProcedure<Q, R, E>,
+        windowMillis: (ScopedRpcBinding) -> Long = { 0 },
+        authorize: suspend (ScopedRpcRequestContext, Q) -> ScopedRpcRequestGrant? = { _, _ -> null },
+        handler: suspend (ScopedRpcCallContext, Q) -> RpcReply<R, E>,
+    ) {
+        require(procedure.key !in procedures) { "Duplicate scoped procedure descriptor" }
+        procedures[procedure.key] = scopedRegisteredProcedure(procedure, windowMillis, authorize, handler)
+    }
+}
+
+public class ScopedRpcClientConfiguration internal constructor() {
+    public var limits: ScopedRpcLimits = ScopedRpcLimits()
+    /** Capture before encoding/auth/send; cap earliest ORIGINAL credential/policy expiry. 0 denies. */
+    public var windowMillis: (ScopedRpcBinding) -> Long = { 0 }
+    public var authorize: ScopedRpcDisclosureAuthorizer = ScopedRpcDisclosureAuthorizer { false }
+}
+
+/**
+ * One-use, original-context delivery. The decoded value remains charged to the client budget until
+ * [take] or [discard], and untaken deliveries are discarded on seal. Taking freshly authorizes local
+ * publication and commits it against the ORIGINAL call deadline, even if an expiry timer never ran.
+ * There is intentionally no raw reply property or shared result flow. Taking transfers ownership to
+ * the OLD application context;
+ * the SDK cannot revoke values an application has already taken or prevent its deliberate copying.
+ */
+public class ScopedRpcDelivery<out R, out E> internal constructor(
+    public val requestId: RpcRequestId,
+    public val binding: ScopedRpcBinding,
+    private val owner: ScopedDeliveryOwner,
+) {
+    /** The caller must supply its own current presentation binding, not copy this handle's binding. */
+    @Throws(Exception::class)
+    @Suppress("UNCHECKED_CAST")
+    public suspend fun take(currentPresentationBinding: ScopedRpcBinding): RpcReply<R, E> =
+        owner.take(currentPresentationBinding) as RpcReply<R, E>
+
+    public suspend fun discard(): Unit = owner.discard()
+    override fun toString(): String = "ScopedRpcDelivery(application data omitted)"
+}
+
+internal fun scopedIdentifier(value: String, maximum: Int = 128) {
+    require(value.length in 1..maximum && value.all { it in '!'..'~' }) {
+        "Scoped identifiers must be bounded, nonsecret ASCII identifiers"
+    }
+}
