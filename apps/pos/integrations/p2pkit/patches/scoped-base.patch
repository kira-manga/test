@@ -0,0 +1,37 @@
+package dev.p2pkit.rpc.internal
+
+import dev.p2pkit.rpc.ScopedRpcDisclosureAuthorizer
+import dev.p2pkit.rpc.ScopedRpcDisclosureContext
+import dev.p2pkit.rpc.ScopedRpcDisclosurePhase
+import dev.p2pkit.rpc.ScopedRpcRequestContext
+import dev.p2pkit.rpc.ScopedRpcRequestGrant
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.TimeoutCancellationException
+import kotlinx.coroutines.withTimeout
+
+internal fun ScopedRpcRequestContext.atDeadline(deadline: ScopedDeadline): ScopedRpcRequestContext =
+    ScopedRpcRequestContext(peer, binding, requestId, procedureName, procedureVersion, requestDigest,
+        deadline.remainingMillis)
+
+internal suspend fun scopedAuthorize(
+    authorizer: ScopedRpcDisclosureAuthorizer,
+    request: ScopedRpcRequestContext,
+    grant: ScopedRpcRequestGrant,
+    phase: ScopedRpcDisclosurePhase,
+    deadline: ScopedDeadline,
+): Boolean {
+    val remaining = deadline.remainingMillis
+    if (remaining <= 0) return false
+    return try {
+        val allowed = withTimeout(remaining) {
+            authorizer.authorize(ScopedRpcDisclosureContext(request.atDeadline(deadline), grant, phase))
+        }
+        allowed && deadline.remainingMillis > 0
+    } catch (_: TimeoutCancellationException) {
+        false
+    } catch (cancelled: CancellationException) {
+        throw cancelled
+    } catch (_: Exception) {
+        false
+    }
+}
