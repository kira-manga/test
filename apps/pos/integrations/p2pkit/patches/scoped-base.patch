+            )
+            val substitutedIncoming = MutableSharedFlow<P2pMessage>()
+            var identityReads = 0
+            var incomingReads = 0
+            val wrapper = object : P2pSession by f.session {
+                override val peerIdentity: PeerIdentity
+                    get() {
+                        identityReads++
+                        return substitutedIdentity
+                    }
+                override val incoming: MutableSharedFlow<P2pMessage>
+                    get() {
+                        incomingReads++
+                        return substitutedIncoming
+                    }
+
+                override fun equals(other: Any?): Boolean = error("Owner attestation must not use virtual equality")
+                override fun hashCode(): Int = error("Owner attestation must not use virtual hashing")
+            }
+            // The virtual claim forwards a genuine core authority; it does NOT attest wrapper views.
+            val lifetime = wrapper.claimInitialDisclosureLifetime()
+            assertFalse(lifetime.belongsTo(wrapper))
+            assertTrue(lifetime.belongsTo(f.session))
+            assertEquals(0, identityReads)
+            assertEquals(0, incomingReads)
+            assertSame(substitutedIdentity, wrapper.peerIdentity)
+            assertSame(substitutedIncoming, wrapper.incoming)
+            // A strict RPC factory can reject and retire this claim before reading either fake view.
+            lifetime.seal()
+            assertTrue(lifetime.belongsTo(f.session), "Ownership is immutable, not a live authorization check")
+            assertFalse(lifetime.belongsTo(wrapper))
+            assertFailsWith<P2pError.ConnectionFailed> { f.session.claimInitialDisclosureLifetime() }
