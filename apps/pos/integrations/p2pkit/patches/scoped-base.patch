+package dev.p2pkit.rpc
+
+import dev.p2pkit.core.P2pSession
+import dev.p2pkit.core.PayloadBudget
+import dev.p2pkit.core.PeerIdentity
+import dev.p2pkit.rpc.internal.MonotonicRpcClock
+import dev.p2pkit.rpc.internal.ScopedRpcClientEngine
+import dev.p2pkit.rpc.internal.ScopedRpcHostEngine
+import dev.p2pkit.rpc.internal.ScopedRpcWire
+import dev.p2pkit.rpc.internal.SessionScopedRpcLink
+import dev.p2pkit.rpc.internal.rpcBoundary
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+
+/**
+ * Experimental, opt-in invoke-only host for ONE already-authenticated, trusted, restricted SDK session.
+ * This is not a multi-client host, employee authentication, bootstrap/login bypass, or a POS adapter.
+ * Subscribe immediately after accepting the P2P session. Do not attach any legacy RPC/application writer.
+ *
+ * Each endpoint independently supplies the exact same immutable application binding. A scope, actor,
+ * device, application-session, purpose, credential, ownership or projection policy change must await
+ * [seal] BEFORE replacement authority becomes active. Reusing a SessionManager result for the same peer
+ * is not a fresh physical lifetime: the SDK's exclusive initial claim will refuse it.
+ */
+public class ScopedRpcHostSession private constructor(
+    public val binding: ScopedRpcBinding,
+    public val peer: PeerIdentity,
+    private val engine: ScopedRpcHostEngine,
+) {
+    /** Advisory only. No check-then-send authorization is implied. */
+    public val isSealed: Boolean get() = engine.isSealed
+
+    /** Permanent, non-cancellable logical revocation; does not await a handler or native writer. */
+    public suspend fun seal(): Unit = engine.seal()
+
+    /** Seal first, then reobserve the original SDK session's retained native cleanup result. */
+    @Throws(Exception::class)
+    public suspend fun close(): Unit = rpcBoundary { engine.close() }
+
+    public companion object {
+        /**
+         * Claims the SDK lifetime BEFORE HELLO/READY or any application binary. Unsupported, untrusted,
+         * unscoped, previously used, wrapped, retired, or rearmed sessions have no compatibility fallback.
+         * A failure after claim permanently seals that session; it must never be passed to legacy RPC.
+         */
+        @Throws(Exception::class)
+        public suspend fun create(
+            session: P2pSession,
+            binding: ScopedRpcBinding,
+            applicationScope: CoroutineScope,
+            configure: ScopedRpcHostConfiguration.() -> Unit,
+        ): ScopedRpcHostSession = rpcBoundary {
+            applicationScope.coroutineContext.ensureActive()
+            val configuration = ScopedRpcHostConfiguration().apply(configure)
+            val limits = configuration.limits
+            val budget = PayloadBudget(limits.payloadBytes)
+            val link = SessionScopedRpcLink.claim(session, applicationScope, budget, MonotonicRpcClock(),
+                ScopedRpcWire.bindingDigest(binding), limits.sendQueue)
+            try {
+                val engine = ScopedRpcHostEngine(applicationScope, link, binding, configuration.procedures.toMap(),
+                    limits, configuration.disclose, budget)
+                engine.start()
+                applicationScope.coroutineContext.ensureActive()
+                if (engine.isSealed) throw RpcFailure(RpcFailureKind.Closed, RpcFailurePhase.Negotiation)
+                ScopedRpcHostSession(binding, link.identity, engine)
+            } catch (failure: Throwable) {
+                withContext(NonCancellable) {
+                    try { link.close() } catch (_: Exception) {
+                        // Revocation already committed. The caller still owns the original SDK session
+                        // and can reobserve incomplete native cleanup with its close()/kit.stop().
+                    }
+                }
+                throw failure
+            }
+        }
+    }
+}
+
+/**
+ * Experimental, fixed-lifetime client. A call sends exactly ONE Invoke and never sends Status, Cancel,
+ * Receipt, notification, pairing, or automatic reinvocation. Recovery is a NEW authenticated application
+ * operation-result procedure with a NEW RPC request ID and the application's durable operation identity.
+ * No result can be rebound onto another physical/application context.
+ */
+public class ScopedRpcClientSession private constructor(
+    public val binding: ScopedRpcBinding,
+    public val peer: PeerIdentity,
+    private val engine: ScopedRpcClientEngine,
+) {
+    /** Advisory only; every send and actual value publication uses the SDK commitment gate. */
+    public val isSealed: Boolean get() = engine.isSealed
+
+    /**
+     * disclosure is locally derived, nonsecret ORIGINAL resource/projection metadata, never a received
+     * capability. It must match this session's independently supplied binding. The host must separately
+     * authenticate the actual typed request. No deadline is renewed after encoding, auth, queueing or reply.
+     *
+     * The returned handle owns a call slot and decoded-payload allowance until take/discard/seal. Taking
+     * requires the caller's current presentation binding and freshly checks local publication authority
+     * and the original deadline. An already taken value is application-owned and cannot be recalled.
+     */
+    @Throws(Exception::class)
+    public suspend fun <Q, R, E> call(
+        procedure: ScopedRpcProcedure<Q, R, E>,
+        request: Q,
+        disclosure: ScopedRpcRequestGrant,
+        timeoutMillis: Long = 5_000,
+    ): ScopedRpcDelivery<R, E> = engine.call(procedure, request, disclosure, timeoutMillis)
+
+    /** Await BEFORE activating any relevant replacement application/policy/device context. */
+    public suspend fun seal(): Unit = engine.seal()
+
+    /** Logical seal is independent of this potentially incomplete original-target native cleanup. */
+    @Throws(Exception::class)
+    public suspend fun close(): Unit = rpcBoundary { engine.close() }
+
+    public companion object {
+        @Throws(Exception::class)
+        public suspend fun create(
+            session: P2pSession,
+            binding: ScopedRpcBinding,
+            applicationScope: CoroutineScope,
+            configure: ScopedRpcClientConfiguration.() -> Unit,
+        ): ScopedRpcClientSession = rpcBoundary {
+            applicationScope.coroutineContext.ensureActive()
+            val configuration = ScopedRpcClientConfiguration().apply(configure)
+            val limits = configuration.limits
+            val budget = PayloadBudget(limits.payloadBytes)
+            val link = SessionScopedRpcLink.claim(session, applicationScope, budget, MonotonicRpcClock(),
+                ScopedRpcWire.bindingDigest(binding), limits.sendQueue)
+            try {
+                val engine = ScopedRpcClientEngine(link, binding, limits, configuration.windowMillis,
+                    configuration.authorize, budget)
+                engine.start()
+                engine.negotiate()
+                applicationScope.coroutineContext.ensureActive()
+                if (engine.isSealed) throw RpcFailure(RpcFailureKind.Closed, RpcFailurePhase.Negotiation)
+                ScopedRpcClientSession(binding, link.identity, engine)
+            } catch (failure: Throwable) {
+                withContext(NonCancellable) {
+                    try { link.close() } catch (_: Exception) {
+                        // The SDK retains cleanup evidence; a claimed lifetime never falls back to legacy.
+                    }
+                }
+                throw failure
+            }
+        }
+    }
+}
