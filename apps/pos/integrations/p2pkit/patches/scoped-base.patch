@@ -0,0 +1,374 @@
+package dev.p2pkit.core
+
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.coroutines.withContext
+
+/**
+ * A deadline measured by the SDK's monotonic clock and bound to one initial lifetime.
+ * There is deliberately no public constructor, serialized form, or renewal operation.
+ */
+public class P2pDisclosureDeadline internal constructor(
+    internal val lifetime: P2pInitialDisclosureLifetime,
+    internal val beganAt: Long,
+    internal val validForMillis: Long,
+) {
+    /**
+     * Narrow the allowance without moving its ORIGINAL start or sampling another clock.
+     * Capture the deadline before calculating remaining credential/policy validity, then narrow it.
+     * A later calculation may shorten validity conservatively; this operation can never renew it.
+     */
+    @Throws(Exception::class)
+    public fun limitTo(validForMillis: Long): P2pDisclosureDeadline {
+        require(validForMillis in 1..30_000L) { "Disclosure allowance must be 1..30000 ms" }
+        return if (validForMillis >= this.validForMillis) this else {
+            P2pDisclosureDeadline(lifetime, beganAt, validForMillis)
+        }
+    }
+
+    override fun toString(): String = "P2pDisclosureDeadline(opaque)"
+}
+
+/** These are local ownership states, never evidence of remote receipt or native cleanup. */
+public enum class P2pDisclosureTicketState {
+    Prepared,
+    /** Claimed by sendScoped, but still revocable while waiting for its logical commitment. */
+    Preparing,
+    Committed,
+    /** A committed Kotlin send invocation exited, successfully or exceptionally. */
+    Finished,
+    Cancelled,
+    Expired,
+    Sealed,
+    Discarded,
+}
+
+/**
+ * One immutable binary message, owned by its original SDK session and revocation gate.
+ * No constructor or copying API can create a second send right. A state read is not an authorization grant.
+ */
+public class P2pDisclosureTicket internal constructor(internal val entry: DisclosureEntry) {
+    public val state: P2pDisclosureTicketState get() = entry.state.value
+    public val hasCommitted: Boolean get() = state == P2pDisclosureTicketState.Committed ||
+        state == P2pDisclosureTicketState.Finished
+
+    /** True only if this call revoked a still-uncommitted message. Never recalls a committed message. */
+    public suspend fun cancelBeforeCommit(): Boolean = entry.lifetime.cancel(entry)
+
+    override fun toString(): String = "P2pDisclosureTicket(payload omitted)"
+}
+
+/**
+ * One local publication decision, serialized with the same lifetime seal as outbound disclosure.
+ *
+ * Capture the deadline before asynchronous authorization/decoding, then call [tryCommit] immediately
+ * before publishing into the immutable ORIGINAL pending/application context. This does not execute a
+ * callback, complete a continuation, or publish a value. A successful decision may finish in that old
+ * context after seal, but must never be transferred into a new employee's context or a shared queue.
+ * Previously returned application values cannot be revoked by this API.
+ */
+public class P2pDisclosurePublication internal constructor(internal val entry: DisclosureEntry) {
+    public val state: P2pDisclosureTicketState get() = entry.state.value
+    public val hasCommitted: Boolean get() = state == P2pDisclosureTicketState.Committed
+
+    /** A one-shot logical publication commitment, not a physical publication/arrival cutoff. */
+    public suspend fun tryCommit(): Boolean = entry.lifetime.commitPublication(entry)
+
+    public suspend fun cancelBeforeCommit(): Boolean = entry.lifetime.cancel(entry)
+
+    override fun toString(): String = "P2pDisclosurePublication(opaque)"
+}
+
+/**
+ * SDK-owned, single-use INITIAL physical-session lifetime and its permanent revocation authority.
+ *
+ * Obtain only through [P2pSession.claimInitialDisclosureLifetime]. This is not employee authentication,
+ * business authorization, permission to reuse a transport after login, or a result-recovery capability.
+ * The application protocol must bind one immutable authenticated principal/purpose to this lifetime,
+ * authenticate ORIGINAL request credentials, and freshly authorize every result, including failures.
+ * It must call and await [seal] BEFORE a relevant account/session/device/ownership/projection policy
+ * replacement becomes active. An observer, timer, logout event, or later cleanup callback is not that
+ * authoritative ordering. Revocation conservatively retires this entire lifetime; it never reopens.
+ *
+ * [prepare] and [preparePublication] only reserve bounded transport/publication ownership. They do not
+ * authenticate their caller. Deadline capture must precede asynchronous authorization; its allowance
+ * must not exceed the earliest applicable credential/policy expiry. The core rechecks it at commitment
+ * even if an expiry timer never runs. There is no automatic renewal at preparation or commitment.
+ * Suspend-inclusive clock/native timing qualification is NOT available for this candidate: its clock
+ * is not proven to advance across device sleep. Real credential expiry across suspend remains a required
+ * production gate; sensitive POS binding is prohibited until that gate is implemented and qualified.
+ *
+ * The gate contains only library-owned state/accounting and the SDK monotonic-clock sample: no app
+ * callback, continuation, suspension, or I/O runs inside the critical section. Acquiring the gate may
+ * suspend. State snapshots are intentionally not collectable flows that could resume app code there.
+ * Unlocking may resume a queued caller outside that critical section; it does not guarantee hard
+ * return-time progress or universally callback-free outer lifecycle/connection-lock completion.
+ *
+ * At most 32 prepared/in-flight messages/publications and 8 MiB of policy allowance (binary size plus
+ * 512 bytes per entry) are retained, additionally charged to the session profile's shared budget.
+ * Expired, uncommitted entries are reclaimed on the next gate operation or [seal]; no timer is required.
+ * Caller-held data and native buffers are outside these policy allowances. Seal discards uncommitted
+ * payloads but does NOT close the transport, join workers, prove native completion, or recall anything.
+ */
+public class P2pInitialDisclosureLifetime internal constructor(
+    internal val sessionIdentity: Any,
+    internal val epochIdentity: Any,
+    private val monotonicClock: () -> Long,
+    private val sharedBudget: PayloadBudget?,
+    private val messageLimitBytes: Int,
+) {
+    private val gate = Mutex()
+    // Private flows have no collectors: their CAS/visibility support cannot resume application code.
+    private val sealedState = MutableStateFlow(false)
+    private val entries = mutableSetOf<DisclosureEntry>()
+    private var retainedBytes = 0L
+    private var lastClockSample = monotonicClock()
+
+    /** Advisory snapshot only. Use the actual send/publication commitment, not a check-then-publish. */
+    public val isSealed: Boolean get() = sealedState.value
+
+    /**
+     * Whether [session] is the exact SDK instance that owns this authority, using reference identity only.
+     * This final method reads no virtual session property and invokes no wrapper callback or equality.
+     * A delegated claim can return a genuine lifetime without authenticating a wrapper's substituted
+     * incoming stream or peer identity. Application protocols must check this immediately after claiming,
+     * before trusting those views or sending a handshake. False means reject, never an unscoped fallback.
+     * True is an immutable ownership fact, not authentication, freshness, or proof this lifetime is live.
+     */
+    public fun belongsTo(session: P2pSession): Boolean = sessionIdentity === session
+
+    /** Capture BEFORE suspending authorization; 30 seconds is a ceiling, never an authorization policy. */
+    @Throws(Exception::class)
+    public fun deadlineAfter(validForMillis: Long): P2pDisclosureDeadline {
+        require(validForMillis in 1..MAX_DEADLINE_MILLIS) { "Disclosure allowance must be 1..30000 ms" }
+        return P2pDisclosureDeadline(this, monotonicClock(), validForMillis)
+    }
+
+    /**
+     * Prepare a nonempty, metadata-free, fully encoded immutable message AFTER explicit app authorization.
+     * Wrong-lifetime deadlines/invalid binary shape are API misuse; sealed/expired admission is rejected.
+     */
+    @Throws(Exception::class)
+    public suspend fun prepare(
+        message: P2pMessage.Binary,
+        deadline: P2pDisclosureDeadline,
+    ): P2pDisclosureTicket {
+        require(message.sizeBytes > 0 && message.metadata.isEmpty()) {
+            "Scoped disclosure requires a nonempty metadata-free binary message"
+        }
+        if (message.sizeBytes > messageLimitBytes) throw P2pError.PayloadTooLarge(
+            messageLimitBytes.toLong(), message.sizeBytes.toLong(),
+        )
+        return P2pDisclosureTicket(prepareEntry(message, deadline, publication = false))
+    }
+
+    /** Reserves bounded metadata only; the decoded value remains owned by the calling application. */
+    @Throws(Exception::class)
+    public suspend fun preparePublication(deadline: P2pDisclosureDeadline): P2pDisclosurePublication =
+        P2pDisclosurePublication(prepareEntry(null, deadline, publication = true))
+
+    /**
+     * Permanently seals this authority and releases every uncommitted entry, independently of writers.
+     * Once entered, revocation is non-cancellable; it performs no transport/native/worker cleanup.
+     */
+    public suspend fun seal() {
+        val releases = sealWithoutReleasing()
+        releases.forEach { it.release() }
+    }
+
+    /** Core lifecycle callers release observable budget accounting AFTER releasing connectionLock. */
+    internal suspend fun sealWithoutReleasing(): List<PayloadLease> = withContext(NonCancellable) {
+        val releases = mutableListOf<PayloadLease>()
+        gate.withLock { sealLocked(releases) }
+        releases
+    }
+
+    private suspend fun prepareEntry(
+        message: P2pMessage.Binary?,
+        deadline: P2pDisclosureDeadline,
+        publication: Boolean,
+    ): DisclosureEntry {
+        require(deadline.lifetime === this) { "Disclosure deadline belongs to another lifetime" }
+        val caller = currentCoroutineContext()
+        caller.ensureActive()
+        val cost = (message?.sizeBytes ?: 0).toLong() + ENTRY_ALLOWANCE_BYTES
+        // Reclaim expired leases before reserving from the shared budget. Recheck after reservation too.
+        locked { releases ->
+            caller.ensureActive()
+            val now = sampleClockLocked(releases, deadline)
+            expireLocked(now, releases)
+            if (sealedState.value || expired(deadline, now)) denied()
+        }
+        // PayloadBudget publishes observable accounting. Never invoke it under the disclosure gate.
+        val lease = sharedBudget?.reserveOrThrow(cost)
+        try {
+            return locked { releases ->
+                caller.ensureActive()
+                val now = sampleClockLocked(releases, deadline)
+                expireLocked(now, releases)
+                if (sealedState.value || expired(deadline, now)) denied()
+                if (entries.size >= MAX_ENTRIES || cost > MAX_RETAINED_BYTES - retainedBytes) {
+                    throw P2pError.ProtocolError("Scoped disclosure retention capacity exceeded")
+                }
+                DisclosureEntry(this, deadline, message, publication, cost, lease).also {
+                    entries.add(it)
+                    retainedBytes += cost
+                }
+            }
+        } catch (failure: Throwable) {
+            lease?.release()
+            throw failure
+        }
+    }
+
+    internal suspend fun claimSend(entry: DisclosureEntry) {
+        val caller = currentCoroutineContext()
+        locked { releases ->
+            caller.ensureActive()
+            val now = sampleClockLocked(releases, entry.deadline)
+            expireLocked(now, releases)
+            if (entry.publication || entry.state.value != P2pDisclosureTicketState.Prepared) {
+                throw P2pError.ConnectionFailed("Disclosure message is not available for a new send")
+            }
+            if (sealedState.value || expired(entry.deadline, now)) denied()
+            entry.state.value = P2pDisclosureTicketState.Preparing
+        }
+    }
+
+    /** Called only after the original core target was validated while owning sendMutex. */
+    internal suspend fun commitSend(entry: DisclosureEntry): P2pMessage.Binary {
+        val caller = currentCoroutineContext()
+        return locked { releases ->
+            caller.ensureActive()
+            val now = sampleClockLocked(releases, entry.deadline)
+            expireLocked(now, releases)
+            if (entry.publication || sealedState.value ||
+                entry.state.value != P2pDisclosureTicketState.Preparing || expired(entry.deadline, now)
+            ) denied()
+            val message = checkNotNull(entry.message)
+            // LOGICAL whole-message commitment. Later framing/encryption belongs ONLY to the old target.
+            entry.state.value = P2pDisclosureTicketState.Committed
+            message
+        }
+    }
+
+    internal suspend fun finishSend(entry: DisclosureEntry) {
+        withContext(NonCancellable) {
+            locked { releases ->
+                expireLocked(sampleClockLocked(releases), releases)
+                when (entry.state.value) {
+                    P2pDisclosureTicketState.Committed ->
+                        releaseLocked(entry, P2pDisclosureTicketState.Finished, releases)
+                    P2pDisclosureTicketState.Preparing ->
+                        releaseLocked(entry, P2pDisclosureTicketState.Discarded, releases)
+                    else -> Unit
+                }
+            }
+        }
+    }
+
+    internal suspend fun commitPublication(entry: DisclosureEntry): Boolean {
+        val caller = currentCoroutineContext()
+        return locked { releases ->
+            caller.ensureActive()
+            val now = sampleClockLocked(releases, entry.deadline)
+            expireLocked(now, releases)
+            if (!entry.publication || sealedState.value ||
+                entry.state.value != P2pDisclosureTicketState.Prepared || expired(entry.deadline, now)
+            ) return@locked false
+            releaseLocked(entry, P2pDisclosureTicketState.Committed, releases)
+            true
+        }
+    }
+
+    internal suspend fun cancel(entry: DisclosureEntry): Boolean = withContext(NonCancellable) {
+        locked { releases ->
+            expireLocked(sampleClockLocked(releases), releases)
+            if (entry.state.value != P2pDisclosureTicketState.Prepared &&
+                entry.state.value != P2pDisclosureTicketState.Preparing
+            ) return@locked false
+            releaseLocked(entry, P2pDisclosureTicketState.Cancelled, releases)
+            true
+        }
+    }
+
+    private fun sampleClockLocked(
+        releases: MutableList<PayloadLease>,
+        deadline: P2pDisclosureDeadline? = null,
+    ): Long {
+        val now = monotonicClock()
+        // A broken/regressing clock fails closed instead of extending an existing deadline.
+        if (now - lastClockSample < 0 || (deadline != null && now - deadline.beganAt < 0)) sealLocked(releases)
+        lastClockSample = now
+        return now
+    }
+
+    private fun expired(deadline: P2pDisclosureDeadline, now: Long): Boolean {
+        val elapsed = now - deadline.beganAt
+        return elapsed < 0 || elapsed >= deadline.validForMillis
+    }
+
+    private fun expireLocked(now: Long, releases: MutableList<PayloadLease>) {
+        val expired = entries.filter {
+            it.state.value != P2pDisclosureTicketState.Committed && expired(it.deadline, now)
+        }
+        expired.forEach { releaseLocked(it, P2pDisclosureTicketState.Expired, releases) }
+    }
+
+    private fun sealLocked(releases: MutableList<PayloadLease>) {
+        sealedState.value = true
+        entries.filter { it.state.value != P2pDisclosureTicketState.Committed }
+            .forEach { releaseLocked(it, P2pDisclosureTicketState.Sealed, releases) }
+    }
+
+    private fun releaseLocked(
+        entry: DisclosureEntry,
+        state: P2pDisclosureTicketState,
+        releases: MutableList<PayloadLease>,
+    ) {
+        entry.state.value = state
+        if (entries.remove(entry)) {
+            retainedBytes -= entry.cost
+            entry.message = null
+            entry.lease?.let(releases::add)
+        }
+    }
+
+    private suspend fun <T> locked(action: (MutableList<PayloadLease>) -> T): T {
+        val releases = mutableListOf<PayloadLease>()
+        try {
+            return gate.withLock { action(releases) }
+        } finally {
+            // Public budget observers may resume here, AFTER the revocation/commit gate is released.
+            releases.forEach { it.release() }
+        }
+    }
+
+    private fun denied(): Nothing =
+        throw P2pError.AuthorizationRejected("Disclosure lifetime or deadline is unavailable")
+
+    override fun toString(): String = "P2pInitialDisclosureLifetime(opaque)"
+
+    private companion object {
+        const val MAX_DEADLINE_MILLIS = 30_000L
+        const val MAX_ENTRIES = 32
+        const val MAX_RETAINED_BYTES = 8L * 1_048_576
+        const val ENTRY_ALLOWANCE_BYTES = 512L
+    }
+}
+
+/** State is mutated only while owning lifetime's gate; its private flow has no application collectors. */
+internal class DisclosureEntry(
+    val lifetime: P2pInitialDisclosureLifetime,
