+/**
+ * Real SDK/protocol/queue/lifetime and PUBLIC scoped-RPC facades over an in-memory byte pair.
+ * Established secure/trusted HELLO state and fingerprints are synthetic: no security handshake,
+ * LAN/native backpressure, device-suspend timing, or platform-runtime qualification is implied.
+ * Core budget totals and public RPC slot ownership are observed, not private RPC budget counters.
+ */
+@OptIn(ExperimentalCoroutinesApi::class)
+class ScopedRpcSdkIntegrationTest {
+    @Test
+    fun hostFactoryRejectsGenuineForwardedLifetimeBeforeReadingSubstitutedViews() = runTest {
+        assertRefusesForwardedLifetime { session, scope ->
+            ScopedRpcHostSession.create(session, BINDING, scope) {}
+        }
+    }
