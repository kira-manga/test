+    /** Forwards real authority but offers unrelated virtual application views; not an SDK owner. */
+    private class SubstitutingSession(private val actual: P2pSession) : P2pSession by actual {
+        val propertyReads = mutableListOf<String>()
+        var forwarded: P2pInitialDisclosureLifetime? = null
+            private set
+        var equalityCalls = 0
+            private set
+        var hashCalls = 0
+            private set
+        var legacySends = 0
+            private set
+        var scopedSends = 0
+            private set
+        var closes = 0
+            private set
+        private val fakePeer = Peer(PeerId("substitute"), "fake", Platform.UNKNOWN, setOf(TransportKind.LAN))
+        private val fakeIdentity = PeerIdentity(fakePeer.id, PeerFingerprint.fromDigest(ByteArray(32) { 19 }))
+        private val fakeIncoming = MutableSharedFlow<P2pMessage>()
+        private val fakeState = MutableStateFlow(ConnectionState.Connected)
+        private val fakeConnectionInfo = MutableStateFlow(SessionConnectionInfo(1))
+        private val fakeOffers = MutableStateFlow<List<P2pFileOffer>>(emptyList())
+        private val fakeFiles = MutableSharedFlow<P2pFileOffer>()
+
+        private fun <T> view(name: String, value: T): T {
+            propertyReads += name
+            return value
+        }
+
+        override val id: String get() = view("id", "substituted-id")
+        override val peer: Peer get() = view("peer", fakePeer)
+        override val peerIdentity: PeerIdentity get() = view("peerIdentity", fakeIdentity)
+        override val admission: PeerAdmission get() = view("admission", PeerAdmission.Trusted)
+        override val incoming: SharedFlow<P2pMessage> get() = view("incoming", fakeIncoming)
+        override val state: StateFlow<ConnectionState> get() = view("state", fakeState)
+        override val connectionInfo: StateFlow<SessionConnectionInfo>
+            get() = view("connectionInfo", fakeConnectionInfo)
+        override val pendingFileOffers: StateFlow<List<P2pFileOffer>> get() = view("pendingFileOffers", fakeOffers)
+
+        @Deprecated("Observe pendingFileOffers")
+        override val incomingFiles: SharedFlow<P2pFileOffer> get() = view("incomingFiles", fakeFiles)
+
+        override suspend fun claimInitialDisclosureLifetime(): P2pInitialDisclosureLifetime =
+            actual.claimInitialDisclosureLifetime().also { forwarded = it }
+
+        override suspend fun send(message: P2pMessage) {
+            legacySends++
+            actual.send(message)
+        }
+
+        override suspend fun sendAtGeneration(message: P2pMessage, generation: Long) {
+            legacySends++
+            actual.sendAtGeneration(message, generation)
+        }
+
+        override suspend fun sendScoped(ticket: P2pDisclosureTicket) {
+            scopedSends++
+            actual.sendScoped(ticket)
+        }
+
+        override suspend fun close() {
+            closes++
+            actual.close()
+        }
+
+        override fun equals(other: Any?): Boolean {
+            equalityCalls++
+            error("The opaque SDK owner verifier must not call virtual equality")
+        }
+
+        override fun hashCode(): Int {
+            hashCalls++
+            error("The opaque SDK owner verifier must not call virtual hashing")
+        }
+    }
