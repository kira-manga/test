+    private class Endpoint(
+        testScope: TestScope,
+        scope: CoroutineScope,
+        connection: FakeRawConnection,
+        localId: String,
+        remoteId: String,
+        fingerprintByte: Byte,
+        beforeCommit: (suspend () -> Unit)? = null,
+    ) {
+        val budget = PayloadBudget(16L * 1_048_576)
+        private val profile = P2pSessionProfile({ PeerAdmission.Trusted }, budget, 1,
+            maxApplicationBytes = MAX_APPLICATION_BYTES)
+        private val protocol = DefaultP2pProtocol(
+            clock = { testScope.testScheduler.currentTime }, version = ProtocolConstants.SECURE_VERSION,
+            sessionProfile = profile,
+        )
+        private val features = setOf(ProtocolFeatures.APP_MESSAGE_ENVELOPE_V1)
+        private val protocolState = ProtocolSessionState(
+            localId, secure = true, localFeatures = features, restrictedApplicationBytes = MAX_APPLICATION_BYTES,
+        ).also { it.completeHello(remoteId, features) }
+        val events = Channel<ProtocolEvent>(Channel.UNLIMITED, onUndeliveredElement = ProtocolEvent::release)
+        var readerFailure: Throwable? = null
+            private set
+        val reader = scope.launch {
+            try {
+                protocol.events(connection, protocolState).collect(events::send)
+                events.close()
+            } catch (failure: Throwable) {
+                events.close(failure)
+                if (failure !is CancellationException) readerFailure = failure
+            }
+        }
+        val session = P2pSessionImpl(
+            id = "fixture-$localId",
+            peer = Peer(PeerId(remoteId), "fixture", Platform.UNKNOWN, setOf(TransportKind.LAN)),
+            peerIdentity = PeerIdentity(
+                PeerId(remoteId), PeerFingerprint.fromDigest(ByteArray(32) { fingerprintByte }),
+            ),
+            initialConnection = connection, initialEvents = events, initialReaderJob = reader,
+            initialProtocolState = protocolState, protocol = protocol, parentScope = scope,
+            keepAlive = KeepAliveConfig(60_000, 120_000), clock = { testScope.testScheduler.currentTime },
+            monotonicClock = { testScope.testScheduler.currentTime }, logger = P2pLogger.NoOp,
+            sessionProfile = profile, beforeScopedDisclosureCommitForTest = beforeCommit,
+        ).also { it.start() }
+    }
