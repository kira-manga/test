+    @Test
+    fun clientFactoryRejectsGenuineForwardedLifetimeBeforeReadingSubstitutedViews() = runTest {
+        assertRefusesForwardedLifetime { session, scope ->
+            ScopedRpcClientSession.create(session, BINDING, scope) {}
+        }
+    }
