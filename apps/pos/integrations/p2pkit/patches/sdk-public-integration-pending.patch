+    private class CommitPause {
+        var enabled = false
+        val entered = CompletableDeferred<Unit>()
+        val release = CompletableDeferred<Unit>()
+
+        suspend fun waitIfEnabled() {
+            if (!enabled) return
+            entered.complete(Unit)
+            withContext(NonCancellable) { release.await() }
+        }
+    }
+
