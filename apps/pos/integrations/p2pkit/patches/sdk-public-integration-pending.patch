+    @Test
+    fun publicFacadesNegotiateInvokeAndTransferOneShotDeliveryWithBoundedSlotOwnership() = runTest {
+        val f = Fixture(this)
+        try {
+            openRpc(f, calls = 1, sendQueue = 2)
+            val client = assertNotNull(f.clientRpc)
+            val host = assertNotNull(f.hostRpc)
+            assertSame(f.client.session.peerIdentity, client.peer)
+            assertSame(f.host.session.peerIdentity, host.peer)
+            assertFalse(client.isSealed)
+            assertFalse(host.isSealed)
+            // Only the actual public client's matching HELLO/READY exchange can finish create().
+            assertEquals(1, f.wire.a.dataFrames())
+            assertEquals(1, f.wire.b.dataFrames())
+
+            val first = awaitAtCurrentTime(f.call("first")).getOrThrow()
+            assertEquals(BINDING, first.binding)
+            assertEquals(listOf("first"), f.handled)
+            val received = f.requests.single()
+            assertEquals("first", received.second)
+            assertSame(f.host.session.peerIdentity, received.first.peer)
+            assertEquals(BINDING, received.first.binding)
+            assertEquals(first.requestId, received.first.requestId)
+            assertEquals(PROCEDURE.name, received.first.procedureName)
+            assertEquals(PROCEDURE.version, received.first.procedureVersion)
+            assertEquals(REQUEST_RESPONSE, f.clientPhases)
+            assertEquals(REQUEST_RESPONSE, f.hostPhases)
+
+            // A returned but untaken handle still owns the ONLY public client call slot.
+            val full = failureOf(awaitAtCurrentTime(f.call("must-not-be-sent")))
+            assertEquals(RpcFailureKind.Overloaded, full.kind)
+            assertEquals(RpcFailurePhase.Admission, full.phase)
+            assertEquals(RpcExecutionEvidence.NotSent, full.executionEvidence)
+            assertEquals(listOf("first"), f.handled)
+            assertEquals(2, f.wire.a.dataFrames())
+
+            val taken = assertIs<RpcReply.Success<String>>(first.take(BINDING))
+            assertEquals("reply:first", taken.value)
+            assertEquals(REQUEST_RESPONSE + ScopedRpcDisclosurePhase.Publication, f.clientPhases)
+            assertUnauthorizedTake(first)
+
+            // Successful admission after take, then after discard, observes slot release without
+            // exposing or injecting the facade's private RPC PayloadBudget/engine/link.
+            val second = awaitAtCurrentTime(f.call("second")).getOrThrow()
+            second.discard()
+            second.discard()
+            assertUnauthorizedTake(second)
+            val third = awaitAtCurrentTime(f.call("third")).getOrThrow()
+            assertEquals(listOf("first", "second", "third"), f.handled)
+            assertEquals(3, f.requests.map { it.first.requestId }.toSet().size)
+            assertEquals(4, f.wire.a.dataFrames())
+            assertEquals(4, f.wire.b.dataFrames())
+
+            val publicationChecks = f.clientPhases.count { it == ScopedRpcDisclosurePhase.Publication }
+            client.seal()
+            assertTrue(client.isSealed)
+            assertUnauthorizedTake(third)
+            assertEquals(publicationChecks, f.clientPhases.count { it == ScopedRpcDisclosurePhase.Publication })
+            assertEquals("reply:first", taken.value, "Seal cannot recall an already transferred OLD-context value")
+        } finally {
+            dispose(f)
+        }
+    }
