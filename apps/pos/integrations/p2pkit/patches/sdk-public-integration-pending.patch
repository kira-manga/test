+    private suspend fun TestScope.openRpc(f: Fixture, calls: Int, sendQueue: Int) {
+        val limits = ScopedRpcLimits(calls, records = 8, sendQueue = sendQueue,
+            payloadBytes = 1_048_576, resultCacheBytes = 65_536)
+        // Synthetic application authorization, never a credential-verification or POS-route claim.
+        f.hostRpc = ScopedRpcHostSession.create(f.host.session, BINDING, f.scope) {
+            this.limits = limits
+            disclose = ScopedRpcDisclosureAuthorizer {
+                f.hostPhases += it.phase
+                it.grant == GRANT && it.request.binding == BINDING
+            }
+            register(PROCEDURE, windowMillis = { CALL_WINDOW }, authorize = { context, request ->
+                f.requests += context to request
+                GRANT
+            }) { _, request ->
+                f.handled += request
+                RpcReply.Success("reply:$request")
+            }
+        }
+        f.clientRpc = awaitAtCurrentTime(f.scope.async {
+            ScopedRpcClientSession.create(f.client.session, BINDING, f.scope) {
+                this.limits = limits
+                windowMillis = { CALL_WINDOW }
+                authorize = ScopedRpcDisclosureAuthorizer {
+                    f.clientPhases += it.phase
+                    it.grant == GRANT && it.request.binding == BINDING
+                }
+            }
+        })
+        runCurrent()
+    }
