+    private suspend fun TestScope.dispose(f: Fixture) {
+        f.beforeClientCommit.release.complete(Unit)
+        try {
+            val closing = listOf(
+                f.scope.async { runCatching { f.clientRpc?.close() ?: f.client.session.close() } },
+                f.scope.async { runCatching { f.hostRpc?.close() ?: f.host.session.close() } },
+            )
+            runAtCurrentTimeUntil { closing.all { it.isCompleted } }
+            closing.forEach { it.await().getOrThrow() }
+            awaitAtCurrentTime(f.scope.async {
+                f.client.session.awaitRuntimeTermination()
+                f.host.session.awaitRuntimeTermination()
+            })
+            runAtCurrentTimeUntil { f.calls.all { it.isCompleted } }
+            for (endpoint in listOf(f.client, f.host)) {
+                assertTrue(endpoint.reader.isCompleted)
+                assertNull(endpoint.readerFailure)
+                assertFalse(endpoint.session.runtimeJobIsActiveForTest)
+                assertEquals(0 to 0L, endpoint.session.applicationBacklogForTest())
+                assertEquals(0L, endpoint.budget.retainedBytes.value)
+            }
+            assertEquals(ConnectionState.Closed, f.wire.a.state.value)
+            assertEquals(ConnectionState.Closed, f.wire.b.state.value)
+        } finally {
+            // Failure-path ownership is also bounded; never strand the deliberately parked writer.
+            f.beforeClientCommit.release.complete(Unit)
+            f.wire.a.breakWith()
+            f.wire.b.breakWith()
+            f.client.events.cancel()
+            f.host.events.cancel()
+            f.supervisor.cancel()
+            runAtCurrentTimeUntil { f.supervisor.isCompleted }
+        }
+    }
+
+    private suspend fun <T> TestScope.awaitAtCurrentTime(deferred: Deferred<T>): T {
+        runAtCurrentTimeUntil { deferred.isCompleted }
+        return deferred.await()
+    }
+
+    private fun TestScope.runAtCurrentTimeUntil(ready: () -> Boolean) {
+        // Public RPC uses its real monotonic clock. Do not auto-advance test timers while native-free
+        // SDK cleanup dispatchers settle. This real timeout is ONLY a deadlock guard, not an oracle.
+        runBlocking(Dispatchers.Default) {
+            withTimeout(5_000L) {
+                while (!ready()) {
+                    testScheduler.runCurrent()
+                    yield()
+                }
+            }
+        }
+    }
+
+    private fun FakeRawConnection.dataFrames(): Int = writtenChunks.count {
+        FrameCodec.decode(it, ProtocolConstants.SECURE_VERSION).type == PacketType.DATA
+    }
+
+    private fun failureOf(result: Result<ScopedRpcDelivery<String, String>>): RpcFailure =
+        assertIs<RpcFailure>(result.exceptionOrNull())
+
+    private fun assertNotSent(failure: RpcFailure) {
+        assertEquals(RpcFailurePhase.Sending, failure.phase)
+        assertEquals(RpcExecutionEvidence.NotSent, failure.executionEvidence)
+        assertEquals(RpcRetryAdvice.SafeBeforeExecution, failure.retryAdvice)
+    }
+
+    private suspend fun assertUnauthorizedTake(delivery: ScopedRpcDelivery<String, String>) {
+        val failure = assertFailsWith<RpcFailure> { delivery.take(BINDING) }
+        assertEquals(RpcFailureKind.Unauthorized, failure.kind)
+        assertEquals(RpcFailurePhase.Decoding, failure.phase)
+    }
+
+    private companion object {
+        const val MAX_APPLICATION_BYTES = 1_048_576
+        const val CALL_WINDOW = 10_000L
+        val BINDING = ScopedRpcBinding("fixture-scope", "fixture-actor", "fixture-session", "echo", "fixture-view")
+        val GRANT = ScopedRpcRequestGrant(BINDING, "fixture-resource")
+        val PROCEDURE = ScopedRpcProcedure("fixture.echo", 1,
+            String.serializer(), String.serializer(), String.serializer(),
+            requestLimitBytes = 1_024, responseLimitBytes = 1_024, errorLimitBytes = 1_024)
+        val REQUEST_RESPONSE = listOf(ScopedRpcDisclosurePhase.Request, ScopedRpcDisclosurePhase.Response)
+    }
+}
