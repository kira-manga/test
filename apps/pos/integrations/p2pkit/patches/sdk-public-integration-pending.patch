+    private suspend fun TestScope.assertRefusesForwardedLifetime(
+        create: suspend (P2pSession, CoroutineScope) -> Unit,
+    ) {
+        val f = Fixture(this)
+        try {
+            val wrapper = SubstitutingSession(f.client.session)
+            val failure = assertFailsWith<RpcFailure> { create(wrapper, f.scope) }
+            assertEquals(RpcFailureKind.NotConnected, failure.kind)
+            assertEquals(RpcFailurePhase.Negotiation, failure.phase)
+            val lifetime = assertNotNull(wrapper.forwarded)
+            assertTrue(lifetime.belongsTo(f.client.session))
+            assertFalse(lifetime.belongsTo(wrapper))
+            assertTrue(lifetime.isSealed)
+            assertTrue(wrapper.propertyReads.isEmpty())
+            assertEquals(0, wrapper.equalityCalls)
+            assertEquals(0, wrapper.hashCalls)
+            assertEquals(0, wrapper.legacySends)
+            assertEquals(0, wrapper.scopedSends)
+            assertEquals(0, wrapper.closes)
+            assertEquals(0, f.wire.a.writeAttempts)
+            assertEquals(0, f.wire.b.writeAttempts)
+            assertEquals(ConnectionState.Connected, f.client.session.state.value)
+            assertFailsWith<P2pError.ConnectionFailed> { f.client.session.claimInitialDisclosureLifetime() }
+        } finally {
+            dispose(f)
+        }
+    }
