+    @Test
+    fun sealRevokesActualQueuedAndPreparingInvokesBeforeCommitWithoutHandlerOrWireDisclosure() = runTest {
+        val f = Fixture(this)
+        try {
+            openRpc(f, calls = 3, sendQueue = 2)
+            val client = assertNotNull(f.clientRpc)
+            runCurrent()
+            val clientBaseline = f.client.budget.retainedBytes.value
+            val hostBaseline = f.host.budget.retainedBytes.value
+            val clientWrites = f.wire.a.writeAttempts
+            val hostWrites = f.wire.b.writeAttempts
+            assertEquals(1, f.wire.a.dataFrames())
+            assertEquals(1, f.wire.b.dataFrames())
+
+            // This existing SDK seam is OUTSIDE its authority gate, after sendMutex/target checks.
+            // Enable only after HELLO so the first real Invoke owns the writer but has not committed.
+            f.beforeClientCommit.enabled = true
+            val preparing = f.call("preparing")
+            runAtCurrentTimeUntil { f.beforeClientCommit.entered.isCompleted }
+            val preparingBytes = f.client.budget.retainedBytes.value
+            assertTrue(preparingBytes > clientBaseline)
+            assertFalse(preparing.isCompleted)
+            val queued = f.call("queued")
+            runCurrent()
+            assertFalse(queued.isCompleted)
+            assertTrue(f.client.budget.retainedBytes.value > preparingBytes)
+
+            // Three call slots but only TWO writer entries: the third reaches Sending admission.
+            // Together with the held writer and second SDK reservation this observes the real queue.
+            val full = failureOf(awaitAtCurrentTime(f.call("queue-full")))
+            assertEquals(RpcFailureKind.Overloaded, full.kind)
+            assertNotSent(full)
+            assertEquals(clientWrites, f.wire.a.writeAttempts)
+            assertTrue(f.handled.isEmpty())
+
+            awaitAtCurrentTime(f.scope.async { client.seal() })
+            assertTrue(client.isSealed)
+            assertFalse(f.beforeClientCommit.release.isCompleted)
+            assertFalse(preparing.isCompleted, "Seal must not need the noncancellable parked writer to exit")
+            assertNotSent(failureOf(awaitAtCurrentTime(queued)))
+            // Sealing releases uncommitted SDK ticket leases even while the first writer is parked.
+            // The remaining baseline belongs to live protocol readers, not RPC-private accounting.
+            assertEquals(clientBaseline, f.client.budget.retainedBytes.value)
+            assertEquals(hostBaseline, f.host.budget.retainedBytes.value)
+            assertEquals(ConnectionState.Connected, f.wire.a.state.value)
+            assertEquals(ConnectionState.Connected, f.client.session.state.value)
+
+            f.beforeClientCommit.release.complete(Unit)
+            assertNotSent(failureOf(awaitAtCurrentTime(preparing)))
+            runCurrent()
+            assertTrue(f.requests.isEmpty())
+            assertTrue(f.handled.isEmpty())
+            assertTrue(f.hostPhases.isEmpty())
+            assertTrue(f.clientPhases.all { it == ScopedRpcDisclosurePhase.Request })
+            assertEquals(clientWrites, f.wire.a.writeAttempts)
+            assertEquals(hostWrites, f.wire.b.writeAttempts)
+            assertEquals(1, f.wire.a.dataFrames())
+            assertEquals(1, f.wire.b.dataFrames())
+            assertFailsWith<P2pError.ConnectionFailed> { f.client.session.claimInitialDisclosureLifetime() }
+        } finally {
+            dispose(f)
+        }
+    }
